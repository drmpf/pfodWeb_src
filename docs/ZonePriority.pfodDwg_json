{
  "format": "pfodDwgDesigner",
  "schema": 1,
  "name": "ZonePriority",
  "description": "Test dwg for indexed-touchZone priority: a big un-indexed background zone with a small INDEXED zone on top of it. Touching inside the small zone must report cmd_small, not cmd_bg.",
  "x": 50,
  "y": 30,
  "color": 0,
  "dwgRefresh_ms": 0,
  "items": [
    {
      "type": "rectangle",
      "xOffset": 0,
      "yOffset": 0,
      "xSize": 50,
      "ySize": 30,
      "filled": true,
      "centered": false,
      "rounded": false,
      "color": 4
    },
    {
      "type": "rectangle",
      "xOffset": 18,
      "yOffset": 10,
      "xSize": 14,
      "ySize": 10,
      "filled": true,
      "centered": false,
      "rounded": true,
      "color": 9
    },
    {
      "type": "label",
      "xOffset": 25,
      "yOffset": 4,
      "text": "tap inside the red box",
      "fontSize": -2,
      "align": "center",
      "bold": false,
      "italic": false,
      "underline": false,
      "color": 15
    },
    {
      "type": "label",
      "idxName": "idx_readout",
      "xOffset": 25,
      "yOffset": 26,
      "text": "no touch yet",
      "fontSize": 0,
      "align": "center",
      "bold": false,
      "italic": false,
      "underline": false,
      "color": 15
    },
    {
      "type": "touchZone",
      "cmdName": "cmd_bg",
      "xOffset": 0,
      "yOffset": 0,
      "xSize": 50,
      "ySize": 30,
      "filter": 1,
      "centered": false
    },
    {
      "type": "touchAction",
      "cmdName": "cmd_bg",
      "action": [
        {
          "type": "label",
          "idxName": "idx_readout",
          "xOffset": 25,
          "yOffset": 26,
          "text": "cmd_bg  (WRONG if inside the red box)",
          "fontSize": 0,
          "align": "center",
          "bold": false,
          "italic": false,
          "underline": false,
          "color": 11
        }
      ]
    },
    {
      "type": "touchZone",
      "cmdName": "cmd_small",
      "idxName": "idx_priority",
      "xOffset": 18,
      "yOffset": 10,
      "xSize": 14,
      "ySize": 10,
      "filter": 1,
      "centered": false
    },
    {
      "type": "touchAction",
      "cmdName": "cmd_small",
      "action": [
        {
          "type": "label",
          "idxName": "idx_readout",
          "xOffset": 25,
          "yOffset": 26,
          "text": "cmd_small  (indexed zone won)",
          "fontSize": 0,
          "align": "center",
          "bold": false,
          "italic": false,
          "underline": false,
          "color": 10
        }
      ]
    }
  ]
}
