{
  "name": "ESPino (ESP-12 Module)",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "tcp": {
      "inoTemplateId": "esp8266/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp8266/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 1023,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 10,
    "max": 1023,
    "defaultRefVolts": "3.2"
  },
  "pins": [
    {
      "name": "BUTTON_BUILTIN",
      "label": "GPIO0 (Button)",
      "codeName": "BUTTON_BUILTIN",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "button"
      ],
      "notes": "This board's USER/PROG button (pulled up, active-low)"
    },
    {
      "name": "GPIO1",
      "label": "GPIO1",
      "codeName": "1",
      "capabilities": [
        "serial_tx"
      ],
      "notes": "Hardware UART0 TX0 — used by the Serial pfod connection"
    },
    {
      "name": "LED_BUILTIN_R",
      "label": "GPIO2 (Led Red active low)",
      "codeName": "LED_BUILTIN_R",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "led_r_low"
      ],
      "notes": "Must be HIGH at boot. RGB LED Red channel, active-low"
    },
    {
      "name": "GPIO3",
      "label": "GPIO3",
      "codeName": "3",
      "capabilities": [
        "serial_rx"
      ],
      "notes": "Hardware UART0 RX0 — used by the Serial pfod connection"
    },
    {
      "name": "LED_BUILTIN_G",
      "label": "GPIO4 (Led Green active low)",
      "codeName": "LED_BUILTIN_G",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "led_g_low"
      ],
      "notes": "This board's RGB LED Green channel — active-low"
    },
    {
      "name": "LED_BUILTIN_B",
      "label": "GPIO5 (Led Blue active low)",
      "codeName": "LED_BUILTIN_B",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "led_b_low"
      ],
      "notes": "This board's RGB LED Blue channel — active-low"
    },
    {
      "name": "MISO",
      "label": "MISO (GPIO12)",
      "codeName": "MISO",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_miso"
      ]
    },
    {
      "name": "MOSI",
      "label": "MOSI (GPIO13)",
      "codeName": "MOSI",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_mosi"
      ]
    },
    {
      "name": "SCK",
      "label": "SCK (GPIO14)",
      "codeName": "SCK",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_sck"
      ]
    },
    {
      "name": "SS",
      "label": "SS (GPIO15)",
      "codeName": "SS",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_ss"
      ],
      "notes": "Must be LOW at boot (tied to GND via resistor on most boards)"
    },
    {
      "name": "GPIO16",
      "label": "GPIO16",
      "codeName": "16",
      "capabilities": [
        "digital_input",
        "digital_output"
      ],
      "notes": "RTC-domain pin: no pull-up/down, no PWM, no interrupt support"
    },
    {
      "name": "A0",
      "label": "A0 (GPIO17)",
      "codeName": "A0",
      "capabilities": [
        "analog_input"
      ],
      "notes": "On-board divider gives A0 a 0-3.2V range"
    }
  ],
  "family": "esp8266",
  "chip": "esp8266",
  "familyDisplayName": "ESP8266",
  "familySortOrder": 100,
  "familyConnectionTypes": "Serial, TCP/IP, HTTP"
}
