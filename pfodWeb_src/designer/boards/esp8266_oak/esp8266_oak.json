{
  "name": "Digistump Oak",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "tcp": {
      "inoTemplateId": "esp8266/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp8266/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 1023,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 10,
    "max": 1023,
    "defaultRefVolts": "3.2"
  },
  "pins": [
    {
      "name": "SCL",
      "label": "SCL (GPIO0)",
      "codeName": "SCL",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_scl"
      ],
      "notes": "No onboard user button on this board"
    },
    {
      "name": "P4",
      "label": "P4 (GPIO1)",
      "codeName": "P4",
      "capabilities": [
        "serial_tx"
      ],
      "notes": "Hardware UART0 TX0 — used by the Serial pfod connection"
    },
    {
      "name": "SDA",
      "label": "SDA (GPIO2)",
      "codeName": "SDA",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_sda"
      ],
      "notes": "Must be HIGH at boot. Commonly wired to onboard LED"
    },
    {
      "name": "P3",
      "label": "P3 (GPIO3)",
      "codeName": "P3",
      "capabilities": [
        "serial_rx"
      ],
      "notes": "Hardware UART0 RX0 — used by the Serial pfod connection"
    },
    {
      "name": "P5",
      "label": "P5 (GPIO4)",
      "codeName": "P5",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    {
      "name": "P1",
      "label": "GPIO5 (Led active high)",
      "codeName": "P1",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "led_high"
      ],
      "notes": "Onboard user LED (active-high, LED_BUILTIN)\nOnboard user LED (active-high)"
    },
    {
      "name": "MISO",
      "label": "MISO (GPIO12)",
      "codeName": "MISO",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_miso"
      ]
    },
    {
      "name": "MOSI",
      "label": "MOSI (GPIO13)",
      "codeName": "MOSI",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_mosi"
      ]
    },
    {
      "name": "SCK",
      "label": "SCK (GPIO14)",
      "codeName": "SCK",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_sck"
      ]
    },
    {
      "name": "SS",
      "label": "SS (GPIO15)",
      "codeName": "SS",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_ss"
      ],
      "notes": "Must be LOW at boot (tied to GND via resistor on most boards)"
    },
    {
      "name": "P10",
      "label": "P10 (GPIO16)",
      "codeName": "P10",
      "capabilities": [
        "digital_input",
        "digital_output"
      ],
      "notes": "RTC-domain pin: no pull-up/down, no PWM, no interrupt support"
    },
    {
      "name": "A0",
      "label": "A0 (GPIO17)",
      "codeName": "A0",
      "capabilities": [
        "analog_input"
      ],
      "notes": "On-board divider gives A0 a 0-3.2V range (Oak)"
    }
  ],
  "family": "esp8266",
  "chip": "esp8266",
  "familyDisplayName": "ESP8266",
  "familySortOrder": 100,
  "familyConnectionTypes": "Serial, TCP/IP, HTTP"
}
