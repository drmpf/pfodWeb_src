{
  "name": "ESP-01 (AI-Thinker)",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "tcp": {
      "inoTemplateId": "esp8266/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp8266/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 1023,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 10,
    "max": 1023,
    "defaultRefVolts": "1.0"
  },
  "pins": [
    {
      "name": "GPIO0",
      "label": "GPIO0",
      "codeName": "0",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "Must be HIGH or floating at boot; LOW enters flash/boot mode\nOften wired to a FLASH/BOOT button on ESP-01 adapters"
    },
    {
      "name": "GPIO1",
      "label": "GPIO1",
      "codeName": "1",
      "capabilities": [
        "serial_tx"
      ],
      "notes": "Hardware UART0 TX0 — used by the Serial pfod connection"
    },
    {
      "name": "GPIO2",
      "label": "GPIO2",
      "codeName": "2",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "Must be HIGH at boot. Commonly wired to the on-board LED"
    },
    {
      "name": "GPIO3",
      "label": "GPIO3",
      "codeName": "3",
      "capabilities": [
        "serial_rx"
      ],
      "notes": "Hardware UART0 RX0 — used by the Serial pfod connection"
    }
  ],
  "family": "esp8266",
  "chip": "esp8266",
  "familyDisplayName": "ESP8266",
  "familySortOrder": 100,
  "familyConnectionTypes": "Serial, TCP/IP, HTTP"
