{
  "name": "Olimex MOD-WIFI-ESP8266(-DEV)",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "tcp": {
      "inoTemplateId": "esp8266/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp8266/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 1023,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 10,
    "max": 1023,
    "defaultRefVolts": "1.0"
  },
  "pins": [
    {
      "name": "GPIO0",
      "label": "GPIO0 (Button)",
      "codeName": "0",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "button"
      ],
      "notes": "This board's SW1 UART-mode button (rev B), pulled up"
    },
    {
      "name": "GPIO1",
      "label": "GPIO1",
      "codeName": "1",
      "capabilities": [
        "serial_tx"
      ],
      "notes": "Hardware UART0 TX0 — used by the Serial pfod connection"
    },
    {
      "name": "SDA",
      "label": "SDA (GPIO2)",
      "codeName": "SDA",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_sda"
      ],
      "notes": "Must be HIGH at boot. Commonly wired to onboard LED"
    },
    {
      "name": "GPIO3",
      "label": "GPIO3",
      "codeName": "3",
      "capabilities": [
        "serial_rx"
      ],
      "notes": "Hardware UART0 RX0 — used by the Serial pfod connection"
    },
    {
      "name": "GPIO4",
      "label": "GPIO4",
      "codeName": "4",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    {
      "name": "GPIO5",
      "label": "GPIO5",
      "codeName": "5",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    {
      "name": "MISO",
      "label": "MISO (GPIO12)",
      "codeName": "MISO",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_miso"
      ]
    },
    {
      "name": "MOSI",
      "label": "MOSI (GPIO13)",
      "codeName": "MOSI",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_mosi"
      ]
    },
    {
      "name": "SCL",
      "label": "SCL (GPIO14)",
      "codeName": "SCL",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_scl",
        "spi_sck"
      ]
    },
    {
      "name": "SS",
      "label": "SS (GPIO15)",
      "codeName": "SS",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_ss"
      ],
      "notes": "Must be LOW at boot (tied to GND via resistor on most boards)"
    },
    {
      "name": "GPIO16",
      "label": "GPIO16",
      "codeName": "16",
      "capabilities": [
        "digital_input",
        "digital_output"
      ],
      "notes": "RTC-domain pin: no pull-up/down, no PWM, no interrupt support"
    },
    {
      "name": "A0",
      "label": "A0 (GPIO17)",
      "codeName": "A0",
      "capabilities": [
        "analog_input"
      ],
      "notes": "A0, no divider fitted, native 0-1.0V range"
    }
