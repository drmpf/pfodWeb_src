      "notes": "Onboard OLED uses I2C SCL, shared bus, still usable"
    },
    {
      "name": "D6",
      "label": "D6 (GPIO12)",
      "codeName": "D6",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_miso"
      ]
    },
    {
      "name": "D7",
      "label": "D7 (GPIO13)",
      "codeName": "D7",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_mosi"
      ]
    },
    {
      "name": "SCK",
      "label": "SCK (GPIO14)",
      "codeName": "SCK",
      "capabilities": [
