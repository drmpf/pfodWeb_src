  "pins": [
    {
      "name": "D3",
      "label": "GPIO0 (Button)",
      "codeName": "D3",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "button"
      ],
      "notes": "Must be HIGH or floating at boot; LOW enters flash/boot mode\nOnboard \"PRG\" FLASH/BOOT pushbutton (active-low)"
    },
    {
      "name": "TX",
      "label": "TX (GPIO1)",
      "codeName": "TX",
      "capabilities": [
        "serial_tx"
      ],
      "notes": "Hardware UART0 TX0 — used by the Serial pfod connection"
    },
    {
      "name": "GPIO2",
      "label": "GPIO2",
      "codeName": "2",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "Must be HIGH at boot."
    },
    {
      "name": "RX",
      "label": "RX (GPIO3)",
      "codeName": "RX",
      "capabilities": [
        "serial_rx"
      ],
      "notes": "Hardware UART0 RX0 — used by the Serial pfod connection"
    },
    {
      "name": "D2",
