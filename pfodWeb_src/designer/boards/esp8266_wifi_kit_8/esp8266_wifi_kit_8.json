    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "tcp": {
      "inoTemplateId": "esp8266/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp8266/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 1023,
    "method": "analogWrite"
  },
