    },
    {
      "name": "D2",
      "label": "D2 (GPIO2)",
      "codeName": "D2",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "Must be HIGH at boot. Commonly wired to onboard LED"
    },
    {
      "name": "D3",
      "label": "D3 (GPIO3)",
      "codeName": "D3",
      "capabilities": [
        "serial_rx"
