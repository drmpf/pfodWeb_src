      "name": "D0",
      "label": "GPIO0 (Button)",
      "codeName": "D0",
      "capabilities": [
        "digital_input",
        "button"
      ],
      "notes": "Must be HIGH or floating at boot; LOW enters flash/boot mode\nKEY_FLASH — onboard user pushbutton"
    },
    {
      "name": "D1",
      "label": "D1 (GPIO1)",
      "codeName": "D1",
      "capabilities": [
