        "pwm_output",
        "spi_miso"
      ]
    },
    {
      "name": "D13",
      "label": "D13 (GPIO13)",
      "codeName": "D13",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_mosi"
      ]
    },
