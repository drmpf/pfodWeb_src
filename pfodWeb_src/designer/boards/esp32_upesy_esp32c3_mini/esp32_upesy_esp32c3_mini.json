{
  "name": "uPesy ESP32C3 Mini",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "ble": {
      "inoTemplateId": "esp32/ble.ino"
    },
    "tcp": {
      "inoTemplateId": "esp32/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp32/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "pins": [
    {
      "name": "A0",
      "label": "A0 (GPIO0)",
      "codeName": "A0",
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "VBAT_SENSE / BAT_VOLT_PIN - onboard battery-voltage sense (ratio-2 divider per uPesy's official Mini-specific docs; vendor's own formula for this board uses V_BAT=2*(bits/4095)*2.5V, equivalent to an effective 6.6V corrected reference using this project's 3.3V-baseline convention). Only valid when battery-powered, not on USB power. See pfodWeb NOTE above."
    },
    {
      "name": "A1",
      "label": "A1 (GPIO1)",
