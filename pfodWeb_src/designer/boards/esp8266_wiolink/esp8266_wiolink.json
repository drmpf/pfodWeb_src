{
  "name": "Seeed Wio Link",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "tcp": {
      "inoTemplateId": "esp8266/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp8266/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 1023,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 10,
    "max": 1023,
    "defaultRefVolts": "2.22"
  },
  "pins": [
    {
      "name": "GPIO0",
      "label": "GPIO0 (Button)",
      "codeName": "0",
      "capabilities": [
        "digital_input",
        "button"
      ],
      "notes": "Must be HIGH or floating at boot; LOW enters flash/boot mode\nOnboard CONFIG/FUNCTION pushbutton (K1) — active-low"
    },
    {
      "name": "GPIO1",
      "label": "GPIO1",
      "codeName": "1",
      "capabilities": [
        "serial_tx"
      ],
      "notes": "Hardware UART0 TX0 — used by the Serial pfod connection"
    },
    {
      "name": "GPIO2",
      "label": "GPIO2 (Led active low)",
      "codeName": "2",
      "capabilities": [
        "digital_output",
        "pwm_output",
        "led_low"
      ],
      "notes": "Must be HIGH at boot. This board's onboard (blue) LED\nLED_BUILTIN — onboard blue LED, active-low"
    },
    {
      "name": "GPIO3",
      "label": "GPIO3",
      "codeName": "3",
      "capabilities": [
        "serial_rx"
      ],
      "notes": "Hardware UART0 RX0 — used by the Serial pfod connection"
    },
    {
      "name": "SDA",
      "label": "SDA (GPIO4)",
      "codeName": "SDA",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_sda"
      ]
    },
    {
      "name": "SCL",
      "label": "SCL (GPIO5)",
      "codeName": "SCL",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_scl"
      ]
    },
    {
      "name": "MISO",
      "label": "MISO (GPIO12)",
      "codeName": "MISO",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_miso"
      ]
    },
    {
      "name": "MOSI",
      "label": "MOSI (GPIO13)",
      "codeName": "MOSI",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_mosi"
      ]
    },
    {
      "name": "SCK",
      "label": "SCK (GPIO14)",
      "codeName": "SCK",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_sck"
      ]
    },
    {
      "name": "GPIO16",
      "label": "GPIO16",
      "codeName": "16",
      "capabilities": [
        "digital_input",
        "digital_output"
      ],
      "notes": "RTC-domain pin: no pull-up/down, no PWM, no interrupt support"
    },
    {
      "name": "A0",
      "label": "A0 (GPIO17)",
      "codeName": "A0",
      "capabilities": [
        "analog_input"
      ],
      "notes": "A0, Grove analog port has a 220k/180k divider ahead"
    }
  ],
  "family": "esp8266",
  "chip": "esp8266",
  "familyDisplayName": "ESP8266",
  "familySortOrder": 100,
  "familyConnectionTypes": "Serial, TCP/IP, HTTP"
