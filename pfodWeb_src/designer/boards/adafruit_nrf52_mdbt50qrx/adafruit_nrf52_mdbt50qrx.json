{
  "name": "Raytac nRF52840 Dongle",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "ble": {
      "inoTemplateId": "adafruit_nrf52/ble.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 14,
    "max": 16383,
    "defaultRefVolts": "3.6"
  },
  "pins": [
    {
      "name": "GPIO0",
