      "codeName": "0",
      "capabilities": [
        "digital_output",
        "led_low"
      ],
      "notes": "PIN_LED1/LED_BUILTIN/LED_CONN — active-low"
    },
    {
      "name": "GPIO2",
      "label": "GPIO2 (Button)",
      "codeName": "2",
      "capabilities": [
        "digital_input",
        "button"
      ],
      "notes": "PIN_BUTTON1/PIN_DFU — the DFU/boot-mode button."
    }
  ],
  "family": "adafruit_nrf52",
