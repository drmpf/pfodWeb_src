{
  "name": "Heltec Wireless Mini Shell",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "ble": {
      "inoTemplateId": "esp32/ble.ino"
    },
    "tcp": {
      "inoTemplateId": "esp32/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp32/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
