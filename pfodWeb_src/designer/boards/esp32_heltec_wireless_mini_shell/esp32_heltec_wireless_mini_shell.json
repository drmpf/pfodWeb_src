        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    {
      "name": "A1",
      "label": "A1 (GPIO1)",
      "codeName": "A1",
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    {
      "name": "A2",
      "label": "A2 (GPIO2)",
