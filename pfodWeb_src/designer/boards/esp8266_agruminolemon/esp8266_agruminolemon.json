{
  "name": "Lifely Agrumino Lemon v4",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "tcp": {
      "inoTemplateId": "esp8266/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp8266/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 1023,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 10,
    "max": 1023,
    "defaultRefVolts": "5.25"
  },
  "pins": [
    {
      "name": "GPIO0",
      "label": "GPIO0",
      "codeName": "0",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "Must be HIGH or floating for normal boot; LOW at boot enters flash/programming mode. No interrupt support. Wired to PIN_LEVEL (HIGH=Running, LOW=Program) on this board"
    },
    {
      "name": "TX",
      "label": "TX (GPIO1)",
      "codeName": "TX",
      "capabilities": [
        "serial_tx"
      ],
      "notes": "Hardware UART0 TX0 — used by the Serial pfod connection, not available as a general GPIO"
    },
    {
      "name": "SDA",
      "label": "SDA (GPIO2)",
      "codeName": "SDA",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_sda"
      ],
      "notes": "Must be HIGH at boot. Wired to this board's I2C SDA and the onboard LED"
    },
    {
      "name": "RX",
      "label": "RX (GPIO3)",
      "codeName": "RX",
      "capabilities": [
        "serial_rx"
      ],
      "notes": "Hardware UART0 RX0 — used by the Serial pfod connection, not available as a general GPIO"
    },
    {
      "name": "GPIO4",
      "label": "GPIO4 (Button)",
      "codeName": "4",
      "capabilities": [
        "digital_input",
        "button"
      ],
      "notes": "PIN_BTN_S1 — onboard button"
    },
    {
      "name": "GPIO5",
      "label": "GPIO5",
      "codeName": "5",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "PIN_USB_DETECT — USB power presence sensor"
    },
    {
      "name": "GPIO13",
      "label": "GPIO13",
      "codeName": "13",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "PIN_BATT_STAT — battery charge status sensor"
    },
    {
      "name": "SCL",
      "label": "SCL (GPIO14)",
      "codeName": "SCL",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_scl"
      ]
    },
    {
      "name": "D0",
      "label": "D0 (GPIO16)",
      "codeName": "D0",
      "capabilities": [
        "digital_input",
        "digital_output"
      ],
      "notes": "RTC-domain pin: no internal pull-up/down, no PWM, no interrupt support. Commonly wired to RST for deep-sleep wake"
    },
    {
      "name": "A0",
      "label": "A0 (GPIO17)",
      "codeName": "A0",
      "capabilities": [
        "analog_input"
      ],
      "notes": "Analog input only (A0) — cannot be used for digital I/O or PWM."
    }
  ],
  "family": "esp8266",
  "chip": "esp8266",
  "familyDisplayName": "ESP8266",
  "familySortOrder": 100,
  "familyConnectionTypes": "Serial, TCP/IP, HTTP"
}
