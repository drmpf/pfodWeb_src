{
  "name": "WiFiduino",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "tcp": {
      "inoTemplateId": "esp8266/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp8266/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 1023,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 10,
    "max": 1023,
    "defaultRefVolts": "3.3"
  },
  "pins": [
    {
      "name": "D3",
      "label": "GPIO0 (Button)",
      "codeName": "D3",
      "capabilities": [
        "digital_input",
        "button"
      ],
      "notes": "Must be HIGH or floating at boot; LOW enters flash/boot mode\nKEY_FLASH — onboard user pushbutton"
    },
    {
      "name": "D1",
      "label": "D1 (GPIO1)",
      "codeName": "D1",
      "capabilities": [
        "serial_tx"
      ],
      "notes": "Hardware UART0 TX0 — used by the Serial pfod connection"
    },
    {
      "name": "D2",
      "label": "D2 (GPIO2)",
      "codeName": "D2",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "Must be HIGH at boot\nOnboard \"L\" LED/LED_BUILTIN, polarity undocumented"
    },
    {
      "name": "D0",
      "label": "D0 (GPIO3)",
      "codeName": "D0",
      "capabilities": [
        "serial_rx"
      ],
      "notes": "Hardware UART0 RX0 — used by the Serial pfod connection"
    },
    {
      "name": "D4",
      "label": "D4 (GPIO4)",
      "codeName": "D4",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_sda"
      ]
    },
    {
      "name": "D5",
      "label": "D5 (GPIO5)",
      "codeName": "D5",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_scl"
      ]
    },
    {
      "name": "D8/D12",
      "label": "D8/D12 (GPIO12)",
      "codeName": "D8",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_miso"
      ]
    },
    {
      "name": "D9/D11",
      "label": "D9/D11 (GPIO13)",
      "codeName": "D9",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_mosi"
      ]
    },
    {
      "name": "D7/D13",
      "label": "D7/D13 (GPIO14)",
      "codeName": "D7",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_sck"
      ]
    },
    {
      "name": "D10",
      "label": "D10 (GPIO15)",
      "codeName": "D10",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_ss"
      ],
      "notes": "Must be LOW at boot (tied to GND via resistor on most boards)"
    },
    {
      "name": "D6",
      "label": "D6 (GPIO16)",
      "codeName": "D6",
      "capabilities": [
        "digital_input",
        "digital_output"
      ],
      "notes": "RTC-domain pin: no pull-up/down, no PWM, no interrupt support"
    },
    {
      "name": "A0",
      "label": "A0 (GPIO17)",
      "codeName": "A0",
      "capabilities": [
        "analog_input"
      ],
      "notes": "On-board divider extends A0 range to 0-3.3V"
    }
