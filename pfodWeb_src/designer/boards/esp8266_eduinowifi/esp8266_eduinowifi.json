      "notes": "Must be LOW at boot (tied to GND via resistor on most boards)"
    },
    {
      "name": "D2",
      "label": "D2 (GPIO16)",
      "codeName": "D2",
      "capabilities": [
        "digital_input",
        "digital_output"
