{
  "name": "Schirmilabs Eduino WiFi",
  "connections": {
    "serial": {
      "availablePorts": [
        "Serial"
      ],
      "defaultPort": "Serial",
      "inoTemplateId": "serial.ino"
    },
    "tcp": {
      "inoTemplateId": "esp8266/tcp.ino"
    },
    "http": {
      "inoTemplateId": "esp8266/http.ino"
    }
  },
  "pwm": {
    "min": 0,
    "max": 1023,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 10,
    "max": 1023,
    "defaultRefVolts": "3.2"
  },
  "pins": [
    {
      "name": "D8",
      "label": "D8 (GPIO0)",
      "codeName": "D8",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "No onboard user button; only a RESET button (SW1)"
    },
    {
      "name": "D1",
      "label": "D1 (GPIO1)",
      "codeName": "D1",
      "capabilities": [
        "serial_tx"
      ],
      "notes": "Hardware UART0 TX0 — used by the Serial pfod connection"
    },
    {
      "name": "D9",
      "label": "D9 (GPIO2)",
      "codeName": "D9",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "Must be HIGH at boot. No onboard LED confirmed on this GPIO"
    },
    {
      "name": "D0",
      "label": "D0 (GPIO3)",
      "codeName": "D0",
      "capabilities": [
        "serial_rx"
      ],
      "notes": "Hardware UART0 RX0 — used by the Serial pfod connection"
    },
    {
      "name": "D4/D14",
      "label": "D4/D14 (GPIO4)",
      "codeName": "D4",
      "capabilities": [
        "digital_input",
