        "i2c_sda"
      ]
    },
    {
      "name": "D3/D15",
      "label": "D3/D15 (GPIO5)",
      "codeName": "D3",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_scl"
      ]
    },
    {
      "name": "D6/D12",
      "label": "D6/D12 (GPIO12)",
      "codeName": "D6",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_miso"
      ]
    },
    {
      "name": "D7/D11",
      "label": "D7/D11 (GPIO13)",
      "codeName": "D7",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_mosi"
      ]
    },
    {
      "name": "D5/D13",
      "label": "D5/D13 (GPIO14)",
      "codeName": "D5",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_sck"
      ]
    },
    {
      "name": "D10",
      "label": "D10 (GPIO15)",
      "codeName": "D10",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_ss"
