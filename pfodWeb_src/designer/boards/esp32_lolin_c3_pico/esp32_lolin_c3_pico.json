        "pwm_output",
        "spi_sck"
      ]
    },
    {
      "name": "A2",
      "label": "A2 (GPIO2)",
      "codeName": "A2",
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "Must be HIGH for normal boot"
    },
    {
      "name": "A3",
      "label": "A3 (GPIO3)",
      "codeName": "A3",
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ],
      "notes": "VBAT / BAT_VOLT_PIN - onboard battery-voltage sense via a 100K/100K (1:1) resistive divider (R7+R10) off the LiPo charger's BAT rail, routed through jumper JP1 (confirmed via official WEMOS C3 Pico schematic, sch_c3_pico_v1.0.0.pdf). Effective corrected reference: 3.3V * (100000+100000)/100000 = 6.6V. Only meaningful when JP1 is bridged and a LiPo battery is connected."
    },
    {
      "name": "A4",
      "label": "A4 (GPIO4)",
      "codeName": "A4",
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_mosi"
      ]
    },
    {
      "name": "A5",
      "label": "A5 (GPIO5)",
      "codeName": "A5",
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output",
        "spi_ss"
      ]
    },
    {
      "name": "GPIO6",
      "label": "GPIO6",
      "codeName": "6",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    {
      "name": "GPIO7",
      "label": "GPIO7 (Led Neopixel)",
      "codeName": "7",
      "capabilities": [
        "digital_output",
        "pwm_output",
        "led_neopixel"
      ],
      "notes": "PIN_RGB_LED - onboard WS2812/NeoPixel-style RGB LED data pin (schematic U3 WS2812B-0807, DI tied to net IO7). See pfodWeb NOTE above."
    },
    {
      "name": "SDA",
      "label": "SDA (GPIO8)",
      "codeName": "SDA",
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output",
        "i2c_sda"
      ],
      "notes": "Must be HIGH or floating on reboot"
    },
    {
      "name": "GPIO9",
      "label": "GPIO9 (Button)",
      "codeName": "9",
      "capabilities": [
        "digital_input",
        "button"
      ],
      "notes": "Must be HIGH for normal boot\nOnboard BOOT/download pushbutton (schematic SW2+R4; independently confirmed as \"Button 9\" by a board-owner write-up). Standard ESP32-C3 strapping pin - see pfodWeb NOTE above."
    },
    {
      "name": "SCL",
      "label": "SCL (GPIO10)",
      "codeName": "SCL",
      "capabilities": [
