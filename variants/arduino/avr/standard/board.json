{
  // Output filename and BoardLoader data-variable name:
  //   boardName "Uno" -> designer/boards/Uno/Uno.json -> const UnoData = {...}
  "boardName": "Uno",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "Arduino Uno",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // Supported values: "avr", "esp32".
  "family": "avr",

  // Default PWM output range for analogWrite().  AVR is 8-bit (0–255).
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // DAC output: AVR has no hardware DAC.
  "dac": {},

  // ADC: ATmega328P has a 10-bit ADC (0–1023).  Default reference is
  // AVCC = 5 V on 5 V boards.  Internal 1.1 V reference also available
  // via analogReference(INTERNAL).
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "5.0" },

  // GPIO numbers that are input-only (no internal pull-up driver, no
  // output driver).  Used by the ESP32 parser to drop digital_output and
  // pwm_output capabilities from those pins.  Leave [] on boards where
  // every pin is bidirectional (e.g. all AVR variants).
  "inputOnlyGpios": [],

  // Transports this board can talk pfod over.  Values are the lowercase
  // machine identifiers from pfodCommon.html's protocol radios.  AVR
  // boards typically only ship Serial — no on-board radio.
  "connections": ["serial"],

  // No boot-time pin restrictions on AVR boards.
  "pinNotes": {},

  // D13 — onboard status LED, active-high (official Arduino documentation:
  // "The built-in LED on pin 13 operates as active high"). Also this
  // board's PIN_SPI_SCK — the classic Arduino pin-13 LED+SCK sharing
  // convention, not a bug. A chipGpios capability override COMPLETELY
  // REPLACES the auto-derived capability list for this pin (including
  // the spi_sck tag it would otherwise get) — deliberately, to avoid the
  // "confirmed identity tag contaminated with a spurious bus-role tag"
  // bug class documented in the pin-audit playbook (section 12).
  //
  // This board.json is also reached via the ancestor-fallback mechanism
  // by every sibling directory with no board.json of its own that
  // #includes this file — atmegang, diecimila, unomini (boards.txt
  // build.variant=standard) and, one level further via eightanaloginputs
  // (nano/mini/bt/pro), all inherit this same D13 tag. Confirmed correct
  // for all of them: every one is an ordinary 5V classic-Arduino-pinout
  // board with the same well-documented D13 status LED convention (no
  // vendor deviates from it). lilypad/lilypadusb/fio were split into
  // their own directories specifically because their 3.3V operation
  // needs a different adc.defaultRefVolts — see those board.json files.
  "chipGpios": {
    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"], "note": "Onboard status LED, active-high. Also PIN_SPI_SCK (classic Arduino pin-13 LED+SCK sharing, not a conflict for typical use)." }
  }
}
