{
  // Fallback boardName / displayName — overridden by boards.txt for every
  // board that declares `build.variant=leonardo` (leonardo, leonardoeth,
  // esplora, LilyPadUSB).  Also inherited via the #include chain by the
  // `yun` and `micro` variant directories.
  "boardName": "leonardo",
  "displayName": "Arduino Leonardo",

  // Parser dialect — 32U4 pins_arduino.h uses the same AVR #define layout.
  "family": "avr",

  // 8-bit PWM via analogWrite() — same as all AVR boards.
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // ATmega32U4 has no hardware DAC.
  "dac": {},

  // ADC: ATmega32U4 has a 10-bit ADC (0–1023).  Default reference is
  // AVCC = 5 V.  Internal 2.56 V reference available via analogReference(INTERNAL).
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "5.0" },

  // All AVR pins are bidirectional.
  "inputOnlyGpios": [],

  // pfod connections for 32U4 boards: hardware serial only (D0=RX1, D1=TX1).
  // Serial is USB-CDC and is not suitable as a pfod transport.
  "connections": ["serial"],

  // No boot-time pin restrictions on AVR boards.
  "pinNotes": {},

  // D13 — onboard status LED, active-high (official Arduino documentation:
  // "On the Leonardo, the built-in LED is connected to pin 13... Setting
  // the pin to HIGH value turns the LED on"). Not on the SPI bus for this
  // 32U4 pin map (SPI moved to D14-D17), so no dual-role caveat needed.
  //
  // This board.json is also reached via the ancestor-fallback mechanism
  // by `micro` (no board.json of its own, #includes this file) and by
  // `yun`/`yunmini`/`chiwawa`/`one` one level further (all #include
  // leonardo's file too) — confirmed correct for all of them, same
  // 32U4 D13 LED convention. esplora/leonardoeth/LilyPadUSB were split
  // into their own directories because they genuinely differ (Esplora's
  // hardware is unrelated to a status LED at all; Leonardo ETH adds a
  // dedicated Ethernet-CS pin; LilyPad USB runs at 3.3 V) — see those
  // board.json files.
  "chipGpios": {
    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"], "note": "Onboard status LED, active-high." }
  }
}
