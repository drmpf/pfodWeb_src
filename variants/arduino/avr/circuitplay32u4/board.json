{
  // boardName / displayName are overridden by boards.txt entry:
  //   circuitplay32u4cat.name=Adafruit Circuit Playground
  "boardName": "circuitplay32u4",
  "displayName": "Adafruit Circuit Playground Classic",

  // ATmega32U4 at 8 MHz / 3.3 V — same header layout as the Leonardo.
  // Serial1 is the hardware USART on the alligator-clip pads (D0=RX, D1=TX).
  // Serial is USB-CDC and is not a suitable pfod transport.
  "family": "avr",

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  // ADC: ATmega32U4 has a 10-bit ADC (0–1023).  Default reference is
  // AVCC = 5 V.  Internal 2.56 V reference available via analogReference(INTERNAL).
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "5.0" },
  "inputOnlyGpios": [],

  // Hardware serial via the D0/D1 alligator-clip pads (Serial1 in sketch).
  "connections": ["serial"],

  // pfodWeb AVR pin audit (2026-07-14). This board's pins_arduino.h is the
  // plain mechanical Leonardo map (bare `static const uint8_t A0 = 18;`
  // style, no PIN_A0/PIN_SPI_*/PIN_WIRE_* macros, no
  // analogInputToDigitalPin() macro) — it carries NO board-specific
  // hardware info at all. Every finding below is sourced from Adafruit's
  // own official "Introducing Circuit Playground" learn guide
  // (https://learn.adafruit.com/introducing-circuit-playground/pinouts)
  // and, as primary/authoritative evidence, the official
  // Adafruit_CircuitPlayground Arduino library source
  // (github.com/adafruit/Adafruit_CircuitPlayground,
  // Adafruit_Circuit_Playground.h `#ifdef __AVR__` block +
  // Adafruit_CircuitPlayground.cpp `begin()`), which hard-codes the exact
  // D<n> pin number of every onboard component for this specific
  // (ATmega32u4/"classic") board variant. Full research trail and
  // per-pin reasoning: boardsDetails/arduino/avr/circuitplay32u4/notes.txt.
  //
  // IMPORTANT PARSER GOTCHA (documented for the coordinating session, NOT
  // fixed here — out of scope for a single-board board.json edit):
  // because this pins_arduino.h has no analogInputToDigitalPin()/PIN_A0
  // macro, build_boards.js's parseAnalogOffset() returns null for this
  // board, so buildAvrBoard()'s `isAnalog` test never fires — pin indices
  // 18-29 are emitted as plain "D18".."D29" (no "A0".."A11" naming, no
  // analog_input capability) instead of "A0".."A11". This does NOT affect
  // the chipGpios keys below (they're keyed by raw digital pin number
  // either way), but it does mean six physical pins are silently
  // double-counted in the generated pin list under two different index
  // numbers each, because the digital/analog numbering scheme for this
  // chip reuses the SAME physical GPIO under both a low D-number and a
  // separate high 18-29 "A-number" (per pins_arduino.h's own comments:
  // "A6 = 24 // D4", "A8 = 26 // D8", etc.). Two of our confirmed
  // hardware pins fall in that duplicate set (D4/"A6"=24 is the left
  // button; D8/"A8"=26 is the accelerometer chip-select) — both index
  // numbers are tagged identically below so the duplicate doesn't appear
  // as a plain, pickable general-purpose pin.
  "pinNotes": {},
  "chipGpios": {
    "4": { "capabilities": ["digital_input", "button"], "note": "Left button (Button A)" },
    "24": { "capabilities": ["digital_input", "button"], "note": "Same physical pin as D4 (left Button A)" },
    "19": { "capabilities": ["digital_input", "button"], "note": "Right button (Button B)" },
    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"], "note": "Onboard small red status LED, active-high" },
    "17": { "capabilities": ["digital_output", "led_neopixel"], "note": "Data pin for the ring of 10 onboard mini NeoPixels" },
    "5": { "capabilities": [], "note": "Dedicated to the onboard piezo speaker/buzzer" },
    "18": { "capabilities": [], "note": "Dedicated to the onboard NTC thermistor (temperature sensor)" },
    "22": { "capabilities": [], "note": "Dedicated to the onboard microphone (analog sound sensor)" },
    "23": { "capabilities": [], "note": "Dedicated to the onboard phototransistor (light sensor)" },
    "7": { "capabilities": [], "note": "Dedicated interrupt line from the onboard LIS3DH accelerometer" },
    "8": { "capabilities": [], "note": "Chip-select line for the onboard LIS3DH accelerometer" },
    "26": { "capabilities": [], "note": "Same physical pin as D8 (accelerometer chip-select)" },
    "14": { "capabilities": [], "note": "Hardware SPI MISO, entirely dedicated to the onboard LIS3DH" },
    "15": { "capabilities": [], "note": "Hardware SPI SCK, entirely dedicated to the onboard LIS3DH" },
    "16": { "capabilities": [], "note": "Hardware SPI MOSI, entirely dedicated to the onboard LIS3DH" },
    "30": { "capabilities": [], "note": "Internal send reference pin for onboard capacitive touch" }
  }
}
