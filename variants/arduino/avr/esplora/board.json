{
  // boardName / displayName — overridden by boards.txt's
  //   esplora.name=Arduino Esplora
  "boardName": "esplora",
  "displayName": "Arduino Esplora",

  // Same ATmega32U4 mechanical pin map as Leonardo (pins_arduino.h is a
  // one-line #include of ../leonardo/pins_arduino.h). Split into its own
  // variant directory (2026-07-14 AVR pin audit) because the Esplora is
  // a fixed-form-factor game controller: a 2-axis joystick with
  // pushbutton, 4 face buttons, a slide potentiometer, a light sensor,
  // a temperature sensor, a microphone, an analog (non-I2C)
  // accelerometer, an RGB LED, a piezo buzzer, two TinkerKit I/O
  // connectors, and a socket for an optional TFT LCD + microSD card —
  // none of which are meaningful on the bare 32U4 dev-board pin map
  // shared with vanilla Leonardo. See notes.txt in the mirrored
  // boardsDetails directory for full sourcing.
  "family": "avr",

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  // ADC: ATmega32U4 10-bit ADC (0-1023). Esplora runs at 5V/16MHz like
  // standard Leonardo, so AVCC (the default reference) is 5.0V.
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "5.0" },
  "inputOnlyGpios": [],

  "connections": ["serial"],

  // Note-only entries (no capability change) for pins confirmed
  // dedicated to Esplora-specific onboard functions that are still
  // safe/reasonable to expose for general pfodWeb use, or that are only
  // conditionally in use (the TFT/SD socket is an optional plug-in
  // module, not an always-populated onboard chip like the joystick/
  // buttons/accelerometer/RGB LED/buzzer below).
  "pinNotes": {
    "0": "TFT RS/DC pin (also Serial1 RX); conflicts w/ TFT fitted",
    "1": "TFT RST pin (also Serial1 TX); conflicts w/ TFT fitted",
    "3": "TinkerKit OUTPUT pin; also SCL but no I2C header exposed",
    "7": "TFT/SD socket: onboard TFT LCD screen's chip-select (CS) pin",
    "8": "TFT/SD socket: onboard microSD card slot's chip-select (SD_CS)",
    "11": "TinkerKit OUTPUT connector pin",
    "14": "SPI MISO — multi-drop, shared with TFT/SD socket",
    "15": "SPI SCK — multi-drop, shared with TFT/SD socket",
    "16": "SPI MOSI — multi-drop, shared with TFT/SD socket",
    "17": "SPI SS — not used by the onboard TFT/SD socket",
    "26": "A8 — same physical pin as D8 (microSD card chip-select)"
  },

  // Confirmed hardware-identity capability tags + dedicated-hardware
  // exclusions, researched via the official Arduino Esplora getting-
  // started guide (docs.arduino.cc), the arduino-libraries/Esplora
  // source (Esplora.h/Esplora.cpp — the authoritative pin-to-function
  // mapping), and the arduino-libraries/TFT source for the TFT/SD
  // socket. Full reasoning and every source consulted is in this
  // board's boardsDetails/.../notes.txt.
  //
  // Keyed by digital pin number (same numbering as D<n>/A<n> — AVR has
  // no GPIO concept). Where the 32U4's A6-A11 "shared with digital
  // pins" convention (see pins_arduino.h) means one physical net has
  // TWO digital-pin-number identities (e.g. D4 and A6/digital-id-24 are
  // the same PD4 pin), BOTH identities are given matching entries below
  // so the Designer can't offer either one as if it were a free,
  // independent pin.
  "chipGpios": {
    "4":  { "capabilities": [], "note": "Accelerometer Z-axis analog input" },
    "24": { "capabilities": [], "note": "A6 — same physical pin as D4 (Accelerometer Z-axis)" },

    "5":  { "capabilities": ["digital_output", "pwm_output", "led_r_high"], "note": "RGB LED red channel, active-high" },

    "6":  { "capabilities": [], "note": "Piezo buzzer/speaker driver pin" },
    "25": { "capabilities": [], "note": "A7 — same physical pin as D6 (Piezo buzzer/speaker)" },

    "9":  { "capabilities": ["digital_output", "pwm_output", "led_b_high"], "note": "RGB LED blue channel, active-high" },
    "27": { "capabilities": ["digital_output", "pwm_output", "led_b_high"], "note": "A9 — same physical pin as D9, blue channel, active-high" },

    "10": { "capabilities": ["digital_output", "pwm_output", "led_g_high"], "note": "RGB LED green channel, active-high" },
    "28": { "capabilities": ["digital_output", "pwm_output", "led_g_high"], "note": "A10 — same physical pin as D10, green channel, active-high" },

    "12": { "capabilities": [], "note": "Accelerometer Y-axis analog input" },
    "29": { "capabilities": [], "note": "A11 — same physical pin as D12 (Accelerometer Y-axis)" },

    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"], "note": "Onboard status ('L') LED, active-high" },

    "18": { "capabilities": [], "note": "Analog multiplexer address-select line, bit 0" },
    "19": { "capabilities": [], "note": "Analog multiplexer address-select line, bit 1" },
    "20": { "capabilities": [], "note": "Analog multiplexer address-select line, bit 2" },
    "21": { "capabilities": [], "note": "Analog multiplexer address-select line, bit 3" },
    "22": { "capabilities": [], "note": "Multiplexer common analog input" },
    "23": { "capabilities": [], "note": "Accelerometer X-axis analog input" }
  }
}
