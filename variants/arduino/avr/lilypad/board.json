{
  // boardName / displayName are overridden by boards.txt entry:
  //   lilypad.name=LilyPad Arduino
  "boardName": "lilypad",
  "displayName": "LilyPad Arduino",

  // Same ATmega328P/168 pin map as the standard Uno-family boards — see
  // pins_arduino.h, which just includes ../standard/pins_arduino.h.
  // Split into its own variant directory (2026-07-14 AVR pin audit)
  // because LilyPad runs at 3.3 V / 8 MHz, unlike the 5 V / 16 MHz
  // uno/atmegang/diecimila/unomini siblings that share "standard" — a
  // single shared board.json can't correctly state one ADC reference
  // voltage for both groups.
  "family": "avr",

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  // ADC: ATmega328P/168 10-bit ADC (0-1023).  LilyPad runs at 3.3 V, so
  // AVCC (the default reference) is 3.3 V here, not the 5.0 V used by
  // the 5 V standard-family siblings.
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],

  "connections": ["serial"],

  "pinNotes": {},

  // D13 — onboard status LED, active-high, soldered directly to the
  // board (confirmed via official Arduino/SparkFun LilyPad documentation:
  // "one LED is soldered to board on pin 13"). Same SPI-SCK dual role as
  // the standard-family boards (classic Arduino pin-13 LED+SCK sharing,
  // not a conflict for typical use).
  "chipGpios": {
    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"], "note": "Onboard status LED, active-high, soldered to the board. Also PIN_SPI_SCK (classic Arduino pin-13 LED+SCK sharing, not a conflict for typical use)." }
  }
}
