{
  // boardName / displayName are overridden by boards.txt entry:
  //   LilyPadUSB.name=LilyPad Arduino USB
  "boardName": "lilypadusb",
  "displayName": "LilyPad Arduino USB",

  // Same ATmega32U4 pin map as the standard Leonardo — see pins_arduino.h,
  // which just includes ../leonardo/pins_arduino.h.  Split into its own
  // variant directory (2026-07-14 AVR pin audit) because LilyPad USB
  // runs at 3.3 V / 8 MHz, unlike the 5 V / 16 MHz leonardo/esplora/
  // leonardoeth siblings that share "leonardo" — a single shared
  // board.json can't correctly state one ADC reference voltage for both
  // groups.
  "family": "avr",

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  // ADC: ATmega32U4 10-bit ADC (0-1023).  LilyPad USB runs at 3.3 V, so
  // AVCC (the default reference) is 3.3 V here, not the 5.0 V used by
  // the 5 V leonardo-family siblings.
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],

  // Serial is USB-CDC and is not suitable as a pfod transport (matches
  // the leonardo precedent).
  "connections": ["serial"],

  "pinNotes": {},

  // D13 — onboard status LED, active-high (also fades/"breathes" during
  // the bootloader, confirmed via official Arduino LilyPad Arduino USB
  // documentation). Not on the SPI bus for this 32U4 pin map (SPI moved
  // to D14-D17), so no dual-role caveat needed here.
  "chipGpios": {
    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"], "note": "Onboard status LED, active-high, soldered to the board (also breathes during the bootloader)." }
  }
}
