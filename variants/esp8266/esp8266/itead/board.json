// pfodWeb NOTE: created from the esp8266 chip-level default with GPIO0
// tagged "button", GPIO13 tagged "led_low", and GPIO12 deliberately left
// untagged (relay output — kept available, not a button/LED).
// This variant directory ("itead") is shared by all boards.txt "sonoff"
// submodels (menu.BoardModel: sonoffBasic/sonoffS20/sonoffSV/sonoffTH) —
// see this repo's pins_arduino.h, which defines BUTTON_BUILTIN=0,
// LED_BUILTIN=13, RELAY_BUILTIN=12 unconditionally (outside any
// ARDUINO_ESP8266_SONOFF_* #if block), so these three assignments are
// common to every Sonoff model built from this variant.
// Confirmed via community/vendor documentation (ITEAD's own product pages
// no longer host the original GPIO writeup; Tasmota/blakadder — the
// standard reference for Sonoff hardware pinouts — were used instead):
//   - https://templates.blakadder.com/sonoff_basic.html
//     Tasmota template GPIO table: GPIO00 = "Button1", GPIO12 = "Relay1",
//     GPIO13 = "Led1i" — the trailing "i" is Tasmota's own notation for an
//     inverted (active-low) output.
//   - https://tasmota.github.io/docs/devices/Sonoff-Basic/
//     Confirms the same GPIO00/12/13 button/relay/LED assignment across
//     the Basic R1/R2/R3 hardware revisions.
//   - Web search cross-check on "Sonoff Basic GPIO13 LED inverted": the
//     green/blue status LED on GPIO13 is driven via a transistor/MOSFET
//     (not a direct GPIO-sink-through-resistor like most dev-board LEDs),
//     confirming GPIO13 is pulled LOW by the ESP8266 to turn the LED ON —
//     active-low, matching Tasmota's "Led1i" (inverted) designation.
//   - GPIO0 (button) and GPIO12 (relay) are plain digital pins with no
//     inversion reported by any source — button uses the ESP8266's normal
//     boot-strapping pull-up (pressed = LOW = also usable as a flash-mode
//     button), relay is a straightforward active-high MOSFET/relay-driver
//     trigger (Tasmota's "Relay1", not "Relay1i").
// GPIO12 (relay) capabilities are left as the untouched chip default
// (digital_input/digital_output/pwm_output) per this repo's policy: a
// relay is a simple on/off actuator and controlling it from pfodWeb is
// the entire point of this board, so it must stay available — it is not
// tagged "button" or any "led_*" capability since it is neither.
// GPIO0/GPIO12/GPIO13 are not this board's TX/RX pins (those are the
// chip-forced GPIO1/GPIO3 serial_tx/serial_rx below), so none of these
// tags collide with the hard-reserved serial pins.
// ADC: this board does not break out the ESP8266's analog (TOUT/A0) pin
// at all — Sonoff Basic/S20/SV/TH are mains-power relay switches with no
// analog-sensing header. Confirmed via multiple independent teardown/
// schematic sources (e.g. Let's Control It forum thread "sonoff wifi /
// analog input": "The Sonoff does not bring out the ADC pin ... you need
// to solder a wire directly to the chip pin to access it"). Since the
// pin is unexposed hardware, not merely undocumented, defaultRefVolts is
// left at the inherited chip-level 1.0V (native ESP8266 ADC range) rather
// than guessing a divider that does not exist on this board.
//
// DEDICATED-HARDWARE SWEEP (later pass, multi-product SCL ambiguity):
// this "itead" variant directory is shared by three genuinely different
// physical products (Sonoff SV, Sonoff TH, Sonoff Basic), selected at
// compile time via ARDUINO_ESP8266_SONOFF_SV/TH/BASIC. The vendor's
// pins_arduino.h declared a product-specific I2C SCL pin with two
// different GPIO values gated by those product macros, and a
// product-specific SDA pin declared for only two of the three products.
// Since build_boards.js's parser is comment-blind and ifdef-blind, it
// cannot distinguish which product a given "itead" board entry actually
// represents, so it would have resolved SCL/SDA to whichever value
// happened to be declared last in the file and silently applied it to
// every product, mislabeling the pin for whichever product(s) that
// value doesn't apply to. Confirmed via Tasmota/blakadder device docs
// (same sources as above) that Sonoff SV, TH and Basic are genuinely
// different hardware, not a version-history artifact with one correct
// answer. This board's local pins_arduino.h copy now sets both SDA and
// SCL to -1 (no default Wire pin) so build_boards.js does not
// auto-append an i2c_sda/i2c_scl capability to a GPIO that is only
// correct for some of the three products. This does not affect the
// already-confirmed GPIO0/12/13 button/relay/LED tags below, which are
// declared unconditionally in pins_arduino.h (outside any
// ARDUINO_ESP8266_SONOFF_* block) and are unaffected by this SCL/SDA
// issue — no collision was found between GPIO14 (the value the parser
// would otherwise have picked for SCL) and GPIO0/12/13. See
// boardsDetails/esp8266/esp8266/itead/notes.txt for the full writeup.
{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP8266" -> designer/boards/ESP8266/ESP8266.json -> const ESP8266Data = {...}
  "boardName": "ESP8266",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name) — here, boards.txt's
  // "sonoff.name=ITEAD Sonoff" plus its BoardModel submenu names.
  "displayName": "Generic ESP8266 Module",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // "esp8266" is its own family value (so the Designer's board picker
  // keeps ESP8266 as a separate top-level family from ESP32), but it
  // routes through the same buildEsp32Board() parser as "esp32" —
  // ESP8266's pins_arduino.h declares pins via the identical
  // `static const uint8_t NAME = value;` convention — matching how
  // "ccode"/"unlistedBoard" already share one parser function.
  "family": "esp8266",

  // No GPIO concept applies to inputOnlyGpios here — GPIO16's lack of
  // PWM/interrupt support is expressed via chipGpios below instead,
  // since GPIO16 still supports digital_output (unlike a true input-only pin).
  "inputOnlyGpios": [],

  // Transports this board can talk pfod over.  ESP8266 has WiFi but no
  // on-chip Bluetooth — BLE is omitted.
  "connections": ["serial", "tcp", "http"],

  // Boot-time / power-up warnings for specific GPIO numbers, plus the
  // ADC caveat on the synthetic A0 slot (see chipGpios comment below for
  // why A0 is numbered 17 here).
  // Reference: Espressif ESP8266 datasheet + Arduino-ESP8266 core `common.h`,
  // cross-checked against https://randomnerdtutorials.com/esp8266-pinout-reference-gpios/
  "pinNotes": {
    "0":  "Must be HIGH or floating for normal boot; LOW at boot enters flash/programming mode. No interrupt support. This board's onboard user/pairing pushbutton (BUTTON_BUILTIN) — see pfodWeb NOTE above pinNotes for sources",
    "2":  "Must be HIGH at boot. Commonly wired to the on-board LED on dev boards",
    "12": "This board's relay output (RELAY_BUILTIN) driving the mains switch — active-high, kept as a plain digital output, not a button/LED capability — see pfodWeb NOTE above pinNotes for sources",
    "13": "This board's onboard status LED (LED_BUILTIN) — active-low — see pfodWeb NOTE above pinNotes for sources",
    "15": "Must be LOW at boot (tied to GND via resistor on most boards)",
    "16": "RTC-domain pin: no internal pull-up/down, no PWM, no interrupt support. Commonly wired to RST for deep-sleep wake",
    "17": "Analog input only (A0) — not broken out on this board (no analog-sensing header on a mains relay switch); native range would be 0-1.0V on the bare chip if wired externally — see adc note below"
  },

  // Full usable-GPIO map for the chip, so every commonly-broken-out pin
  // shows up in the picker even on boards whose own pins_arduino.h
  // doesn't alias it (matches the ESP32 chipGpios convention).
  // GPIO1/GPIO3 are the hardware UART0 TX/RX lines used by the Serial
  // pfod connection on every ESP8266 board — forced here rather than
  // relying on a literal TX/RX alias in pins_arduino.h because most
  // vendor variant files (including NodeMCU and D1 Mini) alias these
  // pins under board-specific names (D9/D10, D1/D3, ...) instead.
  // GPIO16 has no PWM/interrupt support (RTC-domain pin, see pinNotes).
  // A0 (GPIO17, PIN_A0's synthetic slot number) is analog-input-only —
  // it is a dedicated ADC pin on the real chip, not a GPIO, so it has no
  // digital or PWM capability at all, unlike ESP32's ADC-capable GPIOs.
  // GPIOs 6-11 are internal flash SPI and are never broken out on a
  // standard (non-8285) module — intentionally omitted here.
  // Source for per-pin PWM/digital availability:
  // https://randomnerdtutorials.com/esp8266-pinout-reference-gpios/
  // ("ESP8266 allows software PWM in all I/O pins: GPIO0 to GPIO15").
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"], "note": "BUTTON_BUILTIN — onboard user/pairing pushbutton (schematic/vendor-doc confirmed, see pfodWeb NOTE above)" },
    "1":  { "capabilities": ["serial_tx"], "note": "Hardware UART0 TX0 — used by the Serial pfod connection, not available as a general GPIO" },
    "2":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["serial_rx"], "note": "Hardware UART0 RX0 — used by the Serial pfod connection, not available as a general GPIO" },
    "4":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["digital_input", "digital_output", "pwm_output"], "note": "RELAY_BUILTIN — onboard mains relay output, kept available (not tagged button/LED) — see pfodWeb NOTE above" },
    "13": { "capabilities": ["digital_output", "pwm_output", "led_low"], "note": "LED_BUILTIN — onboard status LED, active-low (schematic/vendor-doc confirmed, see pfodWeb NOTE above)" },
    "14": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "16": { "capabilities": ["digital_input", "digital_output"] },
    "17": { "capabilities": ["analog_input"] }
  },

  // ESP8266's analogWrite() PWM defaults to a 10-bit range (0-1023),
  // unlike AVR/ESP32's 8-bit (0-255) default.
  "pwm": { "min": 0, "max": 1023, "method": "analogWrite" },

  // No hardware DAC on ESP8266.
  "dac": {},

  // ESP8266 has one 10-bit ADC (0-1023) exposed as A0 on the bare chip.
  // This board does not break the ADC pin out at all (see pfodWeb NOTE
  // above) — defaultRefVolts is left at the inherited chip-level native
  // 1.0V rather than assuming an on-board divider that does not exist.
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "1.0" }
}
