// pfodWeb NOTE: created from the esp8266 chip-level default with GPIO12 and
// GPIO14 tagged. adc.defaultRefVolts left unchanged (no divider evidence
// found — see below).
// This is the "WifInfo" ESP8266 board by Charles-Henri Hallard (France) — a
// French-market Teleinfo/Linky electricity-meter Wifi web server, built on
// a bare ESP-07/ESP-12 module (see boards.txt wifinfo.menu.ESPModule).
// This variant's own pins_arduino.h already documents its origin in its
// header comment: "Definition for WifInfo boards ... see
// https://github.com/hallard/LibTeleinfo/tree/master/examples/ESP8266_WifInfo
// ... see https://hallard.me/wifinfo/". LED_BUILTIN in that file is 12.
// Confirmed via:
//   - https://hallard.me/wifinfo/ (author's own project blog, French) —
//     describes the board hardware as including "une led RGB pour un
//     visuel" (an RGB LED for visual feedback) and "une 2eme LED classique
//     rouge" (a second, plain red LED). No onboard user pushbutton is
//     mentioned anywhere in the article.
//   - https://github.com/hallard/LibTeleinfo/blob/master/examples/Wifinfo/Wifinfo.h
//     (current firmware source, same author) — exact pin assignments:
//       #define RGB_LED_PIN    14
//       #define RED_LED_PIN    12
//       #define LedRedON()  {digitalWrite(RED_LED_PIN, 1);}   // active-high
//       #define LedRedOFF() {digitalWrite(RED_LED_PIN, 0);}
//     and a third, conditionally-compiled BLU_LED_PIN on GPIO1 ("GPIO 1 TX
//     on board blue led"), active-low (`LedBluON(){digitalWrite(BLU_LED_PIN,0);}`)
//     — GPIO1 is this board's hardware UART0 TX0 pin (hard-reserved for the
//     Serial pfod connection, see chip-level board.json), so it is NOT
//     tagged here even though the vendor firmware also drives an LED on it.
//     No BUTTON/GPIO0 #define or digitalRead() of any kind appears in this
//     header.
//   - https://raw.githubusercontent.com/hallard/LibTeleinfo/master/examples/Wifinfo/Wifinfo.ino
//     (main sketch, same repo) — confirms RGB_LED_PIN (GPIO14) is driven via
//     `NeoPixelBus<NeoRgbFeature, NeoEsp8266BitBang800KbpsMethod> rgb_led(1, RGB_LED_PIN);`
//     i.e. a single-pixel WS2812-style addressable RGB LED on one data pin
//     (bit-banged, not a 3-wire discrete RGB LED) — tagged "led_neopixel".
//     The sketch contains no digitalRead()/button-handling code at all,
//     confirming the blog's silence on a user button.
//   - https://github.com/hallard/WifInfo/blob/master/README.md — software
//     feature list only, no hardware/GPIO detail beyond linking to the
//     Eagle schematic/board images (not machine-readable from this
//     research pass; the two independent firmware-source confirmations
//     above (Wifinfo.h + Wifinfo.ino) already agree on pin numbers and
//     polarity, so the schematic images were not separately fetched).
// GPIO1/GPIO3 (hardware UART0 TX0/RX0, this board's Serial pfod connection)
// are untouched per the chip-level reservation, despite GPIO1 also driving
// a vendor-firmware "blue LED" as noted above.
// ADC: no resistor-divider, schematic, or datasheet evidence was found for
// this board's A0 pin in any of the sources checked above; the firmware's
// only ADC reference (`int32_t adc;` in Wifinfo.ino) is declared but never
// read or calibrated. defaultRefVolts therefore left at the chip-level
// default of "1.0". See boardsDetails/esp8266/esp8266/wifinfo/notes.txt for
// full research notes.
//
// pfodWeb NOTE (dedicated-hardware pin-exclusion pass): GPIO13 EXCLUDED.
// Confirmed via https://raw.githubusercontent.com/hallard/LibTeleinfo/master/examples/Wifinfo/Wifinfo.ino
// (verbatim firmware comment): "Teleinfo is connected to RXD2 (GPIO13) to
// avoid conflict when flashing, this is why we swap RXD1/RXD1 to
// RXD2/TXD2" and "Note that TXD2 is not used teleinfo is receive only".
// GPIO13 is this board's opto-isolated utility-meter teleinfo data input,
// permanently wired into the board's swapped-UART0 RX position - not a
// free general-purpose GPIO, so it is removed from chipGpios entirely
// (matches the wifi_slot board's precedent for its GPIO15 mux-control
// line). GPIO15 (the paired TXD2 position) is explicitly confirmed unused
// by teleinfo, so it is left unchanged (still available as SS/D8).
// This finding is separate from, and in addition to, the earlier
// same-session common.h MISO/SCK collision fix on GPIO12/GPIO14 (still
// confirmed correct/in place) - see notes.txt for full detail.
{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP8266" -> designer/boards/ESP8266/ESP8266.json -> const ESP8266Data = {...}
  "boardName": "ESP8266",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "Generic ESP8266 Module",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // "esp8266" is its own family value (so the Designer's board picker
  // keeps ESP8266 as a separate top-level family from ESP32), but it
  // routes through the same buildEsp32Board() parser as "esp32" —
  // ESP8266's pins_arduino.h declares pins via the identical
  // `static const uint8_t NAME = value;` convention — matching how
  // "ccode"/"unlistedBoard" already share one parser function.
  "family": "esp8266",

  // No GPIO concept applies to inputOnlyGpios here — GPIO16's lack of
  // PWM/interrupt support is expressed via chipGpios below instead,
  // since GPIO16 still supports digital_output (unlike a true input-only pin).
  "inputOnlyGpios": [],

  // Transports this board can talk pfod over.  ESP8266 has WiFi but no
  // on-chip Bluetooth — BLE is omitted.
  "connections": ["serial", "tcp", "http"],

  // Boot-time / power-up warnings for specific GPIO numbers, plus the
  // ADC caveat on the synthetic A0 slot (see chipGpios comment below for
  // why A0 is numbered 17 here).
  // Reference: Espressif ESP8266 datasheet + Arduino-ESP8266 core `common.h`,
  // cross-checked against https://randomnerdtutorials.com/esp8266-pinout-reference-gpios/
  "pinNotes": {
    "0":  "Must be HIGH or floating for normal boot; LOW at boot enters flash/programming mode. No interrupt support. Commonly wired to a FLASH/BOOT button on dev boards",
    "2":  "Must be HIGH at boot. Commonly wired to the on-board LED on dev boards",
    "12": "This board's onboard plain red LED (RED_LED_PIN), active-high — see pfodWeb NOTE above",
    "13": "Dedicated teleinfo (utility-meter) opto-isolated serial receive input — vendor firmware swaps hardware UART0 here (RXD2) specifically to read it; not broken out for general use, excluded entirely — see pfodWeb NOTE above",
    "14": "This board's onboard WS2812/NeoPixel-style single-pixel RGB LED data pin (RGB_LED_PIN) — see pfodWeb NOTE above",
    "15": "Must be LOW at boot (tied to GND via resistor on most boards)",
    "16": "RTC-domain pin: no internal pull-up/down, no PWM, no interrupt support. Commonly wired to RST for deep-sleep wake",
    "17": "Analog input only (A0) — cannot be used for digital I/O or PWM. Native range is 0-1.0V on the bare chip; no on-board divider confirmed for this board — see pfodWeb NOTE above"
  },

  // Full usable-GPIO map for the chip, so every commonly-broken-out pin
  // shows up in the picker even on boards whose own pins_arduino.h
  // doesn't alias it (matches the ESP32 chipGpios convention).
  // GPIO1/GPIO3 are the hardware UART0 TX/RX lines used by the Serial
  // pfod connection on every ESP8266 board — forced here rather than
  // relying on a literal TX/RX alias in pins_arduino.h because most
  // vendor variant files (including NodeMCU and D1 Mini) alias these
  // pins under board-specific names (D9/D10, D1/D3, ...) instead.
  // GPIO16 has no PWM/interrupt support (RTC-domain pin, see pinNotes).
  // A0 (GPIO17, PIN_A0's synthetic slot number) is analog-input-only —
  // it is a dedicated ADC pin on the real chip, not a GPIO, so it has no
  // digital or PWM capability at all, unlike ESP32's ADC-capable GPIOs.
  // GPIOs 6-11 are internal flash SPI and are never broken out on a
  // standard (non-8285) module — intentionally omitted here.
  // Source for per-pin PWM/digital availability:
  // https://randomnerdtutorials.com/esp8266-pinout-reference-gpios/
  // ("ESP8266 allows software PWM in all I/O pins: GPIO0 to GPIO15").
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["serial_tx"], "note": "Hardware UART0 TX0 — used by the Serial pfod connection, not available as a general GPIO" },
    "2":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["serial_rx"], "note": "Hardware UART0 RX0 — used by the Serial pfod connection, not available as a general GPIO" },
    "4":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["digital_output", "pwm_output", "led_high"], "note": "RED_LED_PIN — onboard plain red LED, active-high (see pfodWeb NOTE above)" },
    "14": { "capabilities": ["digital_output", "led_neopixel", "pwm_output"], "note": "RGB_LED_PIN — onboard WS2812/NeoPixel-style single-pixel RGB LED data pin (see pfodWeb NOTE above)" },
    "15": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "16": { "capabilities": ["digital_input", "digital_output"] },
    "17": { "capabilities": ["analog_input"] }
  },

  // ESP8266's analogWrite() PWM defaults to a 10-bit range (0-1023),
  // unlike AVR/ESP32's 8-bit (0-255) default.
  "pwm": { "min": 0, "max": 1023, "method": "analogWrite" },

  // No hardware DAC on ESP8266.
  "dac": {},

  // ESP8266 has one 10-bit ADC (0-1023) exposed as A0.  Native reference
  // is 0-1.0V on the bare chip — see the A0 pinNote above for the
  // common on-board-divider caveat. No divider evidence found for this
  // board (see pfodWeb NOTE above), so left at the chip-level default.
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "1.0" }
}
