// pfodWeb NOTE: created from the esp8266 chip-level default with GPIO0
// tagged "button" and adc.defaultRefVolts overridden. GPIO2 (this board's
// LED_BUILTIN) was investigated but left UNTAGGED — see NOTE below.
// This is "WiFiduino" (WiFiduino-8266), an Arduino-Uno-shield-form-factor
// ESP8266 board sold via openjumper.cn / diandeng.tech (Blinker IoT
// ecosystem); boards.txt entry: wifiduino.name=WiFiduino,
// wifiduino.build.variant=wifiduino.
//   - Button: the vendor's own "WiFiduino-8266数据手册" (WiFiduino-8266
//     datasheet, reproduced identically across openjumper.cn's official
//     product/spec page https://openjumper.cn/wifiduino/, the Arduino
//     Chinese community thread https://www.arduino.cn/thread-81936-1-1.html,
//     and a third-party reproduction at
//     https://blog.csdn.net/qq_40247570/article/details/119493640)
//     documents a `#define KEY_FLASH 0` macro for a physical onboard
//     pushbutton on GPIO0, described as usable both for firmware flashing
//     AND, explicitly, as a general user-input button in application code
//     ("既可以用于刷固件...也可以在应用程序中用作用户输入控制设备的各种功能" —
//     "can be used both for flashing firmware ... and in application code
//     as user input to control the device's various functions") — i.e. a
//     genuine user-facing physical button, not merely inferred from a pin
//     alias (this board's own pins_arduino.h has no KEY_FLASH alias at
//     all — the name comes only from the vendor datasheet). Tagged
//     ["digital_input","button"] to match the plain "button" convention
//     used elsewhere for flash/boot buttons with no active-high/low
//     variant defined.
//   - LED: the same datasheet documents "L：该LED连接到D2引脚，可以使用宏
//     LED_BUILTIN编程控制" ("L: this LED connects to pin D2, can be
//     controlled via the LED_BUILTIN macro") confirming GPIO2 carries a
//     real onboard LED — but despite extensive searching (vendor pages,
//     Arduino-CN datasheet thread, multiple CSDN/blog reproductions, the
//     esp8266/Arduino core PR #4590 that added this board's variant files)
//     no source states the LED's active-high/active-low wiring polarity,
//     and no schematic could be located (openjumper.cn/wifiduino.openjumper.cn
//     returned HTTP 500 "site experiencing technical difficulties" on every
//     attempt). Per the "never infer polarity from a pin alias name" rule,
//     GPIO2 is therefore left WITHOUT a led_high/led_low tag here — see
//     boardsDetails/esp8266/esp8266/wifiduino/notes.txt for full research
//     notes.
// ADC: the same vendor datasheet states, for the A0 pin: "A0：只能做模拟
// 输入使用，输入电压范围为0~3.3V" ("A0: can only be used as analog input,
// input voltage range 0~3.3V") — consistently repeated across
// openjumper.cn's official page, the Arduino-CN datasheet thread, and the
// CSDN reproduction cited above. This is solid vendor-documentation
// evidence of an onboard resistor-divider network extending the ESP8266's
// native 0-1.0V ADC input range to accept 0-3.3V at the board's A0 header
// pin (the bare chip cannot read above ~1.0V without one) — matching the
// same shield/dev-board divider pattern already confirmed on
// ESPDuino/ESPino/D1 R1. No schematic with exact resistor values could be
// located (site inaccessible, see above), so the vendor's own stated
// full-scale figure is used directly: defaultRefVolts set to "3.3".
{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP8266" -> designer/boards/ESP8266/ESP8266.json -> const ESP8266Data = {...}
  "boardName": "ESP8266",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name). boards.txt has
  // wifiduino.name=WiFiduino, wifiduino.build.variant=wifiduino.
  "displayName": "Generic ESP8266 Module",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // "esp8266" is its own family value (so the Designer's board picker
  // keeps ESP8266 as a separate top-level family from ESP32), but it
  // routes through the same buildEsp32Board() parser as "esp32" —
  // ESP8266's pins_arduino.h declares pins via the identical
  // `static const uint8_t NAME = value;` convention — matching how
  // "ccode"/"unlistedBoard" already share one parser function.
  "family": "esp8266",

  // No GPIO concept applies to inputOnlyGpios here — GPIO16's lack of
  // PWM/interrupt support is expressed via chipGpios below instead,
  // since GPIO16 still supports digital_output (unlike a true input-only pin).
  "inputOnlyGpios": [],

  // Transports this board can talk pfod over.  ESP8266 has WiFi but no
  // on-chip Bluetooth — BLE is omitted.
  "connections": ["serial", "tcp", "http"],

  // Boot-time / power-up warnings for specific GPIO numbers, plus the
  // ADC caveat on the synthetic A0 slot (see chipGpios comment below for
  // why A0 is numbered 17 here).
  // Reference: Espressif ESP8266 datasheet + Arduino-ESP8266 core `common.h`,
  // cross-checked against https://randomnerdtutorials.com/esp8266-pinout-reference-gpios/
  "pinNotes": {
    "0":  "Must be HIGH or floating for normal boot; LOW at boot enters flash/programming mode. No interrupt support. This board's KEY_FLASH pushbutton (vendor datasheet-confirmed, see NOTE above)",
    "2":  "Must be HIGH at boot. This board's onboard \"L\" LED (LED_BUILTIN, vendor datasheet-confirmed) — polarity undocumented, not tagged (see NOTE above)",
    "15": "Must be LOW at boot (tied to GND via resistor on most boards)",
    "16": "RTC-domain pin: no internal pull-up/down, no PWM, no interrupt support. Commonly wired to RST for deep-sleep wake",
    "17": "Analog input only (A0) — cannot be used for digital I/O or PWM. Board has a vendor-documented onboard resistor divider extending the native 0-1.0V range to 0-3.3V — see adc.defaultRefVolts and NOTE above"
  },

  // Full usable-GPIO map for the chip, so every commonly-broken-out pin
  // shows up in the picker even on boards whose own pins_arduino.h
  // doesn't alias it (matches the ESP32 chipGpios convention).
  // GPIO1/GPIO3 are the hardware UART0 TX/RX lines used by the Serial
  // pfod connection on every ESP8266 board — forced here rather than
  // relying on a literal TX/RX alias in pins_arduino.h because most
  // vendor variant files (including NodeMCU and D1 Mini) alias these
  // pins under board-specific names (D9/D10, D1/D3, ...) instead. This
  // board's own pins_arduino.h aliases them as RX=3/TX=1, matching.
  // GPIO16 has no PWM/interrupt support (RTC-domain pin, see pinNotes).
  // A0 (GPIO17, PIN_A0's synthetic slot number) is analog-input-only —
  // it is a dedicated ADC pin on the real chip, not a GPIO, so it has no
  // digital or PWM capability at all, unlike ESP32's ADC-capable GPIOs.
  // GPIOs 6-11 are internal flash SPI and are never broken out on a
  // standard (non-8285) module — intentionally omitted here.
  // Source for per-pin PWM/digital availability:
  // https://randomnerdtutorials.com/esp8266-pinout-reference-gpios/
  // ("ESP8266 allows software PWM in all I/O pins: GPIO0 to GPIO15").
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"], "note": "KEY_FLASH — onboard user pushbutton (vendor datasheet-confirmed, see NOTE above)" },
    "1":  { "capabilities": ["serial_tx"], "note": "Hardware UART0 TX0 — used by the Serial pfod connection, not available as a general GPIO" },
    "2":  { "capabilities": ["digital_input", "digital_output", "pwm_output"], "note": "Onboard \"L\" LED / LED_BUILTIN (vendor datasheet-confirmed) — polarity undocumented, not tagged led_high/led_low (see NOTE above)" },
    "3":  { "capabilities": ["serial_rx"], "note": "Hardware UART0 RX0 — used by the Serial pfod connection, not available as a general GPIO" },
    "4":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "16": { "capabilities": ["digital_input", "digital_output"] },
    "17": { "capabilities": ["analog_input"] }
  },

  // ESP8266's analogWrite() PWM defaults to a 10-bit range (0-1023),
  // unlike AVR/ESP32's 8-bit (0-255) default.
  "pwm": { "min": 0, "max": 1023, "method": "analogWrite" },

  // No hardware DAC on ESP8266.
  "dac": {},

  // ESP8266 has one 10-bit ADC (0-1023) exposed as A0.  This board has a
  // vendor-datasheet-confirmed onboard resistor divider (see NOTE at top
  // of file) extending the native 0-1.0V range to 0-3.3V.
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "3.3" }
}
