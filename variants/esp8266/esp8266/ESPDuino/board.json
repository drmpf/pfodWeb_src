{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP8266" -> designer/boards/ESP8266/ESP8266.json -> const ESP8266Data = {...}
  "boardName": "ESP8266",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name). boards.txt has
  // espduino.name=ESPDuino (ESP-13 Module), espduino.build.variant=ESPDuino.
  "displayName": "Generic ESP8266 Module",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // "esp8266" is its own family value (so the Designer's board picker
  // keeps ESP8266 as a separate top-level family from ESP32), but it
  // routes through the same buildEsp32Board() parser as "esp32" —
  // ESP8266's pins_arduino.h declares pins via the identical
  // `static const uint8_t NAME = value;` convention — matching how
  // "ccode"/"unlistedBoard" already share one parser function.
  "family": "esp8266",

  // No GPIO concept applies to inputOnlyGpios here — GPIO16's lack of
  // PWM/interrupt support is expressed via chipGpios below instead,
  // since GPIO16 still supports digital_output (unlike a true input-only pin).
  "inputOnlyGpios": [],

  // Transports this board can talk pfod over.  ESP8266 has WiFi but no
  // on-chip Bluetooth — BLE is omitted.
  "connections": ["serial", "tcp", "http"],

  // Reference: Espressif ESP8266 datasheet + Arduino-ESP8266 core `common.h`,
  // cross-checked against https://randomnerdtutorials.com/esp8266-pinout-reference-gpios/
  // pfodWeb NOTE: GPIO0 tagged "button" - confirmed via the official DOIT
  // (Shenzhen Doctors of Intelligence & Technology / doit.am / smartarduino.com)
  // schematic for this exact board:
  // https://github.com/SmartArduino/ESPboard/blob/master/espduino_shematic.pdf
  // ("ESPDuino" is doit.am's own product name for the ESP-13 Arduino-Uno-shield
  // board; pins_arduino.h in this directory carries the "Modified by Doit.am
  // team www.doit.am" header, same vendor). The schematic's top-right corner
  // shows GPIO0 wired through a 91-ohm resistor (R18) to a momentary pushbutton
  // to GND, silkscreen-labelled "KEY_FLASH" (board silkscreen: S2/KEY). The
  // vendor user manual (ESP8266-Based Serial WiFi Shield for Arduino, User
  // Manual, July 2015, http://www.smartarduino.com/esp8266-wifi-web-sever-shield-for-arduino_p94660.html)
  // lists "KEY button: modes configuration" and documents "press KEY button
  // for more than 1 second" to enter WiFi configuration mode - a genuine
  // user-facing physical button, not merely inferred from a pin alias name.
  // A second button on the same schematic (R17, also 91 ohm) pulls nRST low
  // (board silkscreen S1/RST) - that is the chip reset button, not a GPIO, so
  // it has no chipGpios entry and was not tagged.
  // pfodWeb NOTE: GPIO16 tagged "led_low" - same schematic's POWER section
  // shows VCC33 -> R20 (2K) -> LED (silkscreened/labelled "BLUE") -> GPIO16,
  // i.e. the LED's cathode is wired to GPIO16 so it lights when GPIO16 is
  // driven LOW (active-low). This matches this board's own pins_arduino.h
  // `#define LED_BUILTIN 16` and independently matches a hands-on forum
  // report for this same "ESP13 Shield by Doit" board: "the blue onboard LED
  // connects to GPIO16 and operates in active-low mode" -
  // https://forum.arduino.cc/t/esp13-shield-by-doit-is-there-a-schematic-for-this-anywhere/479363
  // The manual also documents a second, red LED "donated to power supply"
  // (power-on indicator wired straight across the VCC33 rail via R19, not to
  // any GPIO) - not taggable, and not GPIO16.
  "pinNotes": {
    "0":  "Must be HIGH or floating for normal boot; LOW at boot enters flash/programming mode. No interrupt support. Commonly wired to a FLASH/BOOT button on dev boards. On this board it is the schematic-confirmed KEY_FLASH pushbutton (see NOTE above)",
    "2":  "Must be HIGH at boot. Commonly wired to the on-board LED on dev boards",
    "15": "Must be LOW at boot (tied to GND via resistor on most boards)",
    "16": "RTC-domain pin: no internal pull-up/down, no PWM, no interrupt support. Commonly wired to RST for deep-sleep wake. On this board it drives the schematic-confirmed active-low BLUE status LED (see NOTE above)",
    "17": "Analog input only (A0) — cannot be used for digital I/O or PWM. Native range is 0-1.0V on the bare chip; this board adds an on-board 400K/100K divider extending the externally-exposed A0/ADC_EX pin's range to 0-5.0V (see adc NOTE below) — check your board's documentation before wiring higher voltages"
  },

  // Full usable-GPIO map for the chip, so every commonly-broken-out pin
  // shows up in the picker even on boards whose own pins_arduino.h
  // doesn't alias it (matches the ESP32 chipGpios convention).
  // GPIO1/GPIO3 are the hardware UART0 TX/RX lines used by the Serial
  // pfod connection on every ESP8266 board — forced here rather than
  // relying on a literal TX/RX alias in pins_arduino.h because most
  // vendor variant files (including NodeMCU and D1 Mini) alias these
  // pins under board-specific names (D9/D10, D1/D3, ...) instead. This
  // board's own pins_arduino.h aliases them as RX0=3/TX0=1, matching.
  // GPIO16 has no PWM/interrupt support (RTC-domain pin, see pinNotes).
  // A0 (GPIO17, PIN_A0's synthetic slot number) is analog-input-only —
  // it is a dedicated ADC pin on the real chip, not a GPIO, so it has no
  // digital or PWM capability at all, unlike ESP32's ADC-capable GPIOs.
  // GPIOs 6-11 are internal flash SPI and are never broken out on a
  // standard (non-8285) module — intentionally omitted here.
  // Source for per-pin PWM/digital availability:
  // https://randomnerdtutorials.com/esp8266-pinout-reference-gpios/
  // ("ESP8266 allows software PWM in all I/O pins: GPIO0 to GPIO15").
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"], "note": "KEY_FLASH — onboard user pushbutton (schematic-confirmed, see NOTE above)" },
    "1":  { "capabilities": ["serial_tx"], "note": "Hardware UART0 TX0 — used by the Serial pfod connection, not available as a general GPIO" },
    "2":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["serial_rx"], "note": "Hardware UART0 RX0 — used by the Serial pfod connection, not available as a general GPIO" },
    "4":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "16": { "capabilities": ["digital_output", "led_low"], "note": "Onboard BLUE status LED, active-low (schematic-confirmed, see NOTE above). LED_BUILTIN in this board's pins_arduino.h" },
    "17": { "capabilities": ["analog_input"] }
  },

  // ESP8266's analogWrite() PWM defaults to a 10-bit range (0-1023),
  // unlike AVR/ESP32's 8-bit (0-255) default.
  "pwm": { "min": 0, "max": 1023, "method": "analogWrite" },

  // No hardware DAC on ESP8266.
  "dac": {},

  // ESP8266 has one 10-bit ADC (0-1023) exposed as A0.  Native reference
  // is 0-1.0V on the bare chip.
  // pfodWeb NOTE: defaultRefVolts changed from chip-level "1.0" to "5.0".
  // Confirmed via the official DOIT schematic for this board
  // (https://github.com/SmartArduino/ESPboard/blob/master/espduino_shematic.pdf,
  // "ADC Part" block): the externally-exposed analog header pin is labelled
  // "ADC_EX" (broken out on connector J4 pin 1), which feeds the ESP8266
  // module's native ADC/TOUT pin through a two-resistor divider: R21=400K
  // (1%) from ADC_EX down to the "ADC" node, R22=100K (1%) from that node to
  // GND. Divider ratio = (R21+R22)/R22 = 500K/100K = 5.0 exactly, so an
  // external signal up to 5.0V at ADC_EX maps to the chip's native 1.0V
  // full-scale ADC reading. The bare, undivided chip ADC/TOUT net is not
  // separately broken out on any of this board's headers (J1/J2/J3 do not
  // list a plain "ADC" pin, only J4 exposes "ADC_EX"), so ADC_EX is the pin
  // an external sensor actually connects to.
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "5.0" }
}
