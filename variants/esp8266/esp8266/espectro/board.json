// pfodWeb NOTE: created from the esp8266 chip-level default with GPIO0,
// GPIO2 and GPIO15 tagged. adc.defaultRefVolts left unchanged (no divider
// evidence found — see below).
// This is the "ESPectro Core" ESP8266 board by DycodeX (Indonesia,
// shop.makestro.com) — an ESP-12F breakout board, part of the same
// DycodeX "ESPectro" product family as the ESP32 "espectro32" board
// already tagged in this repo (variants/esp32/esp32/espectro32/board.json),
// but verified independently here since ESPectro Core (ESP8266) and
// ESPectro32 (ESP32) are different boards with different companion
// libraries (EspX vs dycodex/ESPectro32).
// Confirmed via:
//   - github.com/esp8266/Arduino Pull Request #2546 ("Add ESPectro to the
//     supported boards", authored by andriyadi of DycodeX) — the PR's own
//     description of the board's hardware: "ESPectro is designed by
//     DycodeX ... It uses the famous ESP8266 ESP-12 module" and lists the
//     board's features as "WS2812/Neopixel RGB LED", "Single-color LED",
//     "Programmable user button", "I2C grove connector", "I2C OLED display
//     compatible connector", "Integrated FT231XS USB-to-TTL converter with
//     auto-flash circuitry", "Manual flash and reset buttons". That PR's
//     variants/espectro/pins_arduino.h is identical to this repo's copy
//     (LED_BUILTIN=15; BUTTON_BUILTIN/BUILTIN_BUTTON=0 when
//     ESPECTRO_CORE_VERSION==3 [the #ifndef default], =2 otherwise;
//     SDA=4, SCL=5) — re-fetched from
//     raw.githubusercontent.com/esp8266/Arduino/master/variants/espectro/pins_arduino.h
//     and byte-for-byte matches this variant's pins_arduino.h.
//   - github.com/andriyadi/EspX (DycodeX's own "ESP8266 Extended Library,
//     especially for ESPectro IoT development board", same author as the
//     PR above) — src/ESPectro_Constants.h gives the exact pin numbers
//     behind LED_BUILTIN/BUTTON_BUILTIN and additionally reveals the
//     NeoPixel pin, which has no alias in pins_arduino.h:
//       #define ESPECTRO_LED_PIN            15
//       #define ESPECTRO_NEOPIXEL_PIN       15   (pre-v3 boards)
//       #define ESPECTRO_NEOPIXEL_PIN_V3     2   (v3 boards)
//       #define ESPECTRO_BUTTON_PIN          2   (pre-v3 boards)
//       #define ESPECTRO_BUTTON_PIN_V3       0   (v3 boards)
//     Since this variant's pins_arduino.h defaults ESPECTRO_CORE_VERSION
//     to 3 (matching BUTTON_BUILTIN=0), the v3 pin set is what's tagged:
//     GPIO0=button, GPIO2=NeoPixel data, GPIO15=single-color LED (LED pin
//     is the same across both hardware versions).
//   - src/ESPectro_LED.h/.cpp (same repo) — the single-color LED (GPIO15)
//     polarity is software-configurable
//     (`ESPectro_LED(byte pin = ESPECTRO_LED_PIN, boolean activeHigh =
//     true)`), and the board's own class `ESPectro.cpp` instantiates it
//     with no explicit argument (`new ESPectro_LED()`), i.e. using the
//     library's own default wiring assumption — active-high
//     (`turnOn() { digitalWrite(pin_, activeHigh_ ? HIGH : LOW); }`).
//     Tagged "led_high" on that basis.
//   - GPIO1/GPIO3 (hardware UART0 TX0/RX0, this board's Serial pfod
//     connection per pins_arduino.h's own RX0/TX0 aliases) are untouched.
//     GPIO2 also carries this board's alternate-UART TX1 alias, but TX1
//     is not the pfod Serial connection (only GPIO1/GPIO3 are hard-reserved
//     for that — see chip-level board.json), so GPIO2 remains taggable.
// ADC: no vendor schematic, datasheet, or resistor-divider documentation
// was found for ESPectro Core's A0 pin (unlike the documented 220k/100k
// dividers on NodeMCU/D1 Mini/ESPino elsewhere in this repo). The
// Makestro shop product page (shop.makestro.com/product/espectrocore/)
// was unreachable (connection refused) and no cached/archived copy could
// be fetched; DycodeX's own EspX library headers (DCX_Constants.h) contain
// no ADC/battery-voltage-divider constants. defaultRefVolts therefore
// left at the chip-level default of "1.0". See
// boardsDetails/esp8266/esp8266/espectro/notes.txt for full research notes.
//
// PARSER-AMBIGUITY FIX (dated audit pass, see notes.txt for full detail):
// pins_arduino.h used to declare the button pin's name twice with two
// different numeric values, guarded by an #if/#else block selecting
// between two hardware revisions. This repo's board.json parser does not
// evaluate preprocessor conditionals — it scans every direct numeric
// assignment in file order and lets the last one win, so it was actually
// resolving the button symbol to the non-applicable revision's pin number
// even though the file's real default (and this board.json's own button/
// LED/NeoPixel capability tagging below) always matched the other
// revision. That mismatch only affected the auto-generated display name
// and generated-code alias for the NeoPixel pin (GPIO2), not the
// capability tags here, which were already correct. pins_arduino.h has
// since been edited to remove the non-applicable revision's declarations
// entirely, so only one unambiguous value remains and the parser now
// resolves the same way a real compile does. No capability changes were
// needed in this file as a result.
{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP8266" -> designer/boards/ESP8266/ESP8266.json -> const ESP8266Data = {...}
  "boardName": "ESP8266",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "Generic ESP8266 Module",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // "esp8266" is its own family value (so the Designer's board picker
  // keeps ESP8266 as a separate top-level family from ESP32), but it
  // routes through the same buildEsp32Board() parser as "esp32" —
  // ESP8266's pins_arduino.h declares pins via the identical
  // `static const uint8_t NAME = value;` convention — matching how
  // "ccode"/"unlistedBoard" already share one parser function.
  "family": "esp8266",

  // No GPIO concept applies to inputOnlyGpios here — GPIO16's lack of
  // PWM/interrupt support is expressed via chipGpios below instead,
  // since GPIO16 still supports digital_output (unlike a true input-only pin).
  "inputOnlyGpios": [],

  // Transports this board can talk pfod over.  ESP8266 has WiFi but no
  // on-chip Bluetooth — BLE is omitted.
  "connections": ["serial", "tcp", "http"],

  // Boot-time / power-up warnings for specific GPIO numbers, plus the
  // ADC caveat on the synthetic A0 slot (see chipGpios comment below for
  // why A0 is numbered 17 here).
  // Reference: Espressif ESP8266 datasheet + Arduino-ESP8266 core `common.h`,
  // cross-checked against https://randomnerdtutorials.com/esp8266-pinout-reference-gpios/
  "pinNotes": {
    "0":  "Must be HIGH or floating for normal boot; LOW at boot enters flash/programming mode. No interrupt support. This board's onboard user button (BUTTON_BUILTIN / ESPECTRO_BUTTON_PIN_V3) — see pfodWeb NOTE above",
    "2":  "Must be HIGH at boot. This board's onboard WS2812/NeoPixel RGB LED data pin (ESPECTRO_NEOPIXEL_PIN_V3) — see pfodWeb NOTE above",
    "15": "Must be LOW at boot (tied to GND via resistor on most boards). This board's onboard single-color LED (LED_BUILTIN / ESPECTRO_LED_PIN), active-high — see pfodWeb NOTE above",
    "16": "RTC-domain pin: no internal pull-up/down, no PWM, no interrupt support. Commonly wired to RST for deep-sleep wake",
    "17": "Analog input only (A0) — cannot be used for digital I/O or PWM. Native range is 0-1.0V on the bare chip; no on-board divider confirmed for this board — see pfodWeb NOTE above"
  },

  // Full usable-GPIO map for the chip, so every commonly-broken-out pin
  // shows up in the picker even on boards whose own pins_arduino.h
  // doesn't alias it (matches the ESP32 chipGpios convention).
  // GPIO1/GPIO3 are the hardware UART0 TX/RX lines used by the Serial
  // pfod connection on every ESP8266 board — forced here rather than
  // relying on a literal TX/RX alias in pins_arduino.h because most
  // vendor variant files (including NodeMCU and D1 Mini) alias these
  // pins under board-specific names (D9/D10, D1/D3, ...) instead.
  // GPIO16 has no PWM/interrupt support (RTC-domain pin, see pinNotes).
  // A0 (GPIO17, PIN_A0's synthetic slot number) is analog-input-only —
  // it is a dedicated ADC pin on the real chip, not a GPIO, so it has no
  // digital or PWM capability at all, unlike ESP32's ADC-capable GPIOs.
  // GPIOs 6-11 are internal flash SPI and are never broken out on a
  // standard (non-8285) module — intentionally omitted here.
  // Source for per-pin PWM/digital availability:
  // https://randomnerdtutorials.com/esp8266-pinout-reference-gpios/
  // ("ESP8266 allows software PWM in all I/O pins: GPIO0 to GPIO15").
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"], "note": "BUTTON_BUILTIN / ESPECTRO_BUTTON_PIN_V3 — onboard programmable user button (see pfodWeb NOTE above)" },
    "1":  { "capabilities": ["serial_tx"], "note": "Hardware UART0 TX0 — used by the Serial pfod connection, not available as a general GPIO" },
    "2":  { "capabilities": ["digital_output", "led_neopixel", "pwm_output"], "note": "ESPECTRO_NEOPIXEL_PIN_V3 — onboard WS2812/NeoPixel RGB LED data pin (see pfodWeb NOTE above)" },
    "3":  { "capabilities": ["serial_rx"], "note": "Hardware UART0 RX0 — used by the Serial pfod connection, not available as a general GPIO" },
    "4":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["digital_output", "led_high", "pwm_output"], "note": "LED_BUILTIN / ESPECTRO_LED_PIN — onboard single-color LED, active-high by vendor library default (see pfodWeb NOTE above)" },
    "16": { "capabilities": ["digital_input", "digital_output"] },
    "17": { "capabilities": ["analog_input"] }
  },

  // ESP8266's analogWrite() PWM defaults to a 10-bit range (0-1023),
  // unlike AVR/ESP32's 8-bit (0-255) default.
  "pwm": { "min": 0, "max": 1023, "method": "analogWrite" },

  // No hardware DAC on ESP8266.
  "dac": {},

  // ESP8266 has one 10-bit ADC (0-1023) exposed as A0. No documented
  // on-board divider was found for ESPectro Core (see pfodWeb NOTE at
  // top of file) — left at the native 0-1.0V chip default.
  "adc": { "bits": 10, "max": 1023, "defaultRefVolts": "1.0" }
}
