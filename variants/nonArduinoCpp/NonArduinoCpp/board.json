{
  // Output filename and BoardLoader data-variable name:
  //   boardName "NonArduinoCpp" -> designer/boards/nonArduinoCpp_NonArduinoCpp/nonArduinoCpp_NonArduinoCpp.json
  "boardName": "NonArduinoCpp",

  // Fallback human-readable name shown in the designer UI.  No boards.txt
  // exists for this family, so this is also the final displayed name.
  "displayName": "Non-Arduino CPP code",

  // Parser dialect.  "nonArduinoCpp" is a no-pin target that uses the
  // normal Arduino C++ code generator (not generateCcode.js) — same
  // weak-getter pfodMainMenu + dwg support as "Unlisted Board" — but
  // generateCode.js's _triggerDownload() swaps the generated .ino for a
  // main.cpp (with explicit holes for the user's own serial/UART Stream
  // setup) and adds a small pfodParser.h adapter so the unchanged
  // generated code compiles against the non-Arduino pfodParserCPP
  // library instead of Arduino's pfodParser.  buildCcodeBoard() in
  // build_boards.js handles this family (same no-pin structure as
  // ccode/unlistedBoard) but board.family stays "nonArduinoCpp" so
  // generateCode.js routes to the Arduino-shaped generator, not the
  // plain-C generator used by "Minimal C Code".
  "family": "nonArduinoCpp",

  // No GPIO concept applies — no pins defined for this target.
  "inputOnlyGpios": [],

  // This target only talks pfod over Serial.
  "connections": ["serial"],

  // No pins, so no pin notes.
  "pinNotes": {},

  // No GPIO concept applies.
  "chipGpios": {},

  // No PWM, DAC or ADC support — no pins to carry them.
  "pwm": {},
  "dac": {},
  "adc": {}
}
