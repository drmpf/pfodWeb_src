{
  // Output filename and BoardLoader data-variable name:
  //   boardName "RP2040W" -> designer/boards/RP2040W/RP2040W.json -> const RP2040WData = {...}
  "boardName": "RP2040W",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "Raspberry Pi Pico W / 2W",

  // Same pin-declaration style as plain RP2040/RP2350 — shares the
  // "rp2040" family value (see variants/rp2040/rp2040/board.json for the
  // full rationale).
  "family": "rp2040",

  // This chip-level bucket holds only boards with the NATIVE RP2040/
  // RP2350 + CYW43439 wireless combo (confirmed via a content-search for
  // cyw43_wrappers.h) — the same WiFi.h stack Pico W/2W use, which is
  // what variants/rp2040/tcp.ino / http.ino (copied from ESP32) and
  // ble.ino actually target: rpipicow, rpipico2w, pimoroni_pico_plus_2w,
  // pimoroni_plasma2350w, waveshare_rp2350b_plus_w (own Raspberry Pi
  // Radio Module 2, also CYW43439-based), soldered_nula_rp2350,
  // sparkfun_iotredboard_rp2350, sparkfun_thingplusrp2350,
  // sparkfun_xrp_controller, sparkfun_xrp_controller_beta.
  //
  // Boards with an ADD-ON WiFi/BLE co-processor instead (ESP8285/
  // ESP32-C3/C6 over UART or "ESP-hosted" SPI, u-blox NINA-W102, etc.)
  // are deliberately NOT in this bucket, even though they have WiFi/BLE
  // hardware — they need their own protocol-specific library and .ino
  // templates that don't exist yet, so they stay Serial-only in the
  // plain "rp2040"/"rp2350" chip buckets for now (see the "pfodWeb NOTE"
  // comment in each such board's own pins_arduino.h): ilabs_rpico32,
  // challenger_2040_wifi, challenger_2040_wifi_ble,
  // challenger_2040_wifi6_ble, challenger_2350_wifi6_ble5,
  // challenger_nb_2040_wifi, arduino_nano_connect, adafruit_fruitjam.
  "inputOnlyGpios": [],

  // Every board in this chip bucket has an onboard WiFi/BLE radio (CYW43-
  // series for most, a Raspberry Pi Radio Module 2 for
  // waveshare_rp2350b_plus_w) — adds tcp/http/ble to the default
  // Serial-only connections (see variants/rp2040/ble.ino for the current
  // BLE placeholder status).
  "connections": ["serial", "tcp", "http", "ble"],

  "pinNotes": {},

  // Deliberately empty — see variants/rp2040/rp2040/board.json for why a
  // uniform chip-level GPIO map isn't appropriate for this family.
  // rpipicow/rpipico2w have bespoke, self-contained pins_arduino.h that
  // exclude the WiFi-chip-reserved GPIOs (23/24/25/29) directly;
  // soldered_nula_rp2350/sparkfun_iotredboard_rp2350/
  // waveshare_rp2350b_plus_w are self-contained vendor files with their
  // own real pin layouts; sparkfun_thingplusrp2350/sparkfun_xrp_controller/
  // sparkfun_xrp_controller_beta use this bucket's own generic/common.h
  // (same fix as variants/rp2040/rp2040/generic/common.h).
  "chipGpios": {},

  // Same 8-bit analogWrite() default as every other RP2040/RP2350 board —
  // see variants/rp2040/rp2040/board.json.
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  // Same 12-bit ADC as every other RP2040/RP2350 board — see
  // variants/rp2040/rp2040/board.json.
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" }
}
