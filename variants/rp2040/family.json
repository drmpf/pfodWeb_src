{
  // Human-readable name shown for this family in the Designer's target
  // picker.  Read generically by build_boards.js (nearest-ancestor
  // search, same pattern as board.json/boards.txt) — no family names
  // are hardcoded in the build scripts.
  "familyDisplayName": "RP2040 / RP2350 (Pico)",

  // Connection types supported by this family, shown after familyDisplayName
  // with " - " in the target picker and target label.
  // Stored as familyConnectionTypes on each board JSON by build_boards.js.
  // Required — build_boards.js reports a config error if absent.
  // Most boards are Serial-only; the 5 WiFi-chip-equipped boards
  // (Pico W, Pico 2 W, etc.) additionally list tcp/http/ble in their own
  // per-board board.json connections array.
  "connectionTypes": "Serial, TCP/IP, HTTP, BLE"
}
