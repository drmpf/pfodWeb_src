{
  // Output filename and BoardLoader data-variable name:
  //   boardName "RP2040" -> designer/boards/RP2040/RP2040.json -> const RP2040Data = {...}
  "boardName": "RP2040",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name) — for this board that's
  // "Adafruit Feather RP2040 CAN Bus" (variants/rp2040/boards.txt).
  "displayName": "Raspberry Pi Pico (RP2040)",

  // Same parser dialect as every other RP2040 board — see
  // ../board.json for the full rationale.
  "family": "rp2040",

  // GPIO7 (BOOT button, see chipGpios below) is a genuine bidirectional
  // GPIO merely wired to a switch to GND with the RP2040's internal
  // pull-up enabled by software — not a dedicated/capacitive-only pin —
  // so it is handled entirely via the chipGpios "button" tag (full
  // capability set retained), matching the adafruit_feather_scorpio
  // precedent. The six CAN-transceiver control lines and the NeoPixel
  // power-enable line are likewise genuine bidirectional GPIOs merely
  // wired to onboard chip-select/reset/interrupt/power-gate roles, so
  // they too are handled via chipGpios (emptied capabilities), not
  // inputOnlyGpios.
  "inputOnlyGpios": [],

  // Default transports — Serial only. This is the plain (non-WiFi)
  // "rp2040" chip bucket; the onboard MCP25625 is a CAN transceiver
  // reached via SPI (e.g. Arduino ACAN2515/mcp2515-family libraries),
  // not a pfodWeb "connections" transport in its own right.
  "connections": ["serial"],

  "pinNotes": {},

  // pfodWeb NOTE (RP2040/RP2350 family button/LED/NeoPixel + dedicated-
  // hardware pin-exclusion audit, 2026-07-13):
  //
  // Board: Adafruit "Feather RP2040 CAN Bus" (product 5724) — an
  // Adafruit Feather with an onboard MCP25625 CAN transceiver/controller
  // (an MCP2515 core with an integrated transceiver) reached over SPI0,
  // plus a plain status LED (D13), an onboard single status NeoPixel
  // (GPIO21, with a separate power-enable gate on GPIO20), and a BOOT
  // button (GPIO7) — the same identity-pin pattern as the already-
  // audited adafruit_feather_scorpio sibling board.
  //
  // Sources consulted:
  // 1. learn.adafruit.com/adafruit-rp2040-can-bus-feather/pinouts
  //    (official Adafruit guide) — quotes verbatim:
  //      "The MCP25625 uses the exposed SPI port (SCK/GPIO14,
  //      MOSI/GPIO15 and MISO/GPIO8)..."
  //      "GPIO16 - CAN Standby pin. Can be accessed in CircuitPython
  //      with CAN_STANDBY" (matches PIN_CAN_STANDBY in pins_arduino.h)
  //      "GPIO17 - CAN Transmit pin... CAN_TX0_RTS"
  //      "GPIO18 - CAN Reset pin... CAN_RESET"
  //      "GPIO19 - CAN Chip Select pin... CAN_CS"
  //      "GPIO22 - CAN Interrupt pin... CAN_INTERRUPT"
  //      "GPIO23 - CAN Receive pin... CAN_RX0_BF"
  //      "GPIO21 (NeoPixel) - Status NeoPixel LED. It is connected to
  //      GPIO21"
  //      "GPIO20 (NeoPixel Power) - NeoPixel power pin on GPIO20. It
  //      needs to be set High for the NeoPixel to be powered"
  //      "Boot button is the button on the right, located on GPIO7"
  //      "Little red LED is controllable in CircuitPython code using
  //      board.LED" (digital pin 13 in Arduino, per the shared Feather
  //      RP2040 pin-numbering convention also confirmed on this board's
  //      scorpio/other-Feather siblings).
  //    Also separately confirms GPIO14/15/8 (SCK/MOSI/MISO) are "the
  //    main exposed SPI" header pins, shared with (not dedicated to) the
  //    onboard CAN transceiver, and remain available for other SPI
  //    devices — so they are NOT tagged/excluded here, only the six
  //    single-purpose CAN control lines are.
  // 2. raw.githubusercontent.com/zephyrproject-rtos/zephyr (main)
  //    boards/adafruit/feather_canbus_rp2040/
  //    adafruit_feather_canbus_rp2040.dts — official upstream Zephyr
  //    board port, cross-referencing the same hardware. Quotes:
  //      leds { red_led: red_led { gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>; ... }; }
  //      gpio_keys { user_button: button { gpios = <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; ... }; }
  //      ws2812 { gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>; ... }
  //    This independently CONFIRMS: D13 LED is active-high; BOOT/GPIO7
  //    button is active-low with the RP2040's internal pull-up enabled;
  //    onboard status NeoPixel is GPIO21 (active-high data line) —
  //    matching Adafruit's own guide exactly.
  //
  // Full findings/sources trail:
  // boardsDetails/rp2040/rp2040/adafruit_feather_can/notes.txt
  "chipGpios": {
    "7":  { "capabilities": ["digital_input", "digital_output", "pwm_output", "button"], "note": "PIN_BUTTON / BOOT — onboard bootloader-select pushbutton, also usable as a general input when application code is running. Active-low with the RP2040's internal pull-up enabled (no external pull-up on this line). Confirmed via Zephyr's adafruit_feather_canbus_rp2040.dts gpio_keys node (gpios = <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>) and Adafruit's own pinouts guide (\"Boot button is the button on the right, located on GPIO7\"). Full digital_input/digital_output/pwm_output capability retained (ordinary GPIO wired to a switch to GND, not a dedicated/capacitive-only pin), matching this repo's adafruit_feather_scorpio PIN_BUTTON precedent." },
    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"], "note": "PIN_LED — onboard status LED, active-high. Confirmed via Zephyr's adafruit_feather_canbus_rp2040.dts leds node (gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>), consistent with Adafruit's own pinouts guide describing it as controllable via board.LED/digital pin 13. digital_input dropped to match this repo's established led_high precedent for dedicated onboard LED pins (rpipico, adafruit_feather_scorpio); pwm_output kept since arduino-pico's analogWrite() works on any RP2040 GPIO, enabling brightness dimming. This GPIO was also the vendor's default (unused) PIN_SPI0_SS alias, which would have contaminated this confirmed LED tag with a spurious spi_ss capability — fixed 2026-07-13 by removing that alias from pins_arduino.h (the onboard CAN transceiver uses its own dedicated PIN_CAN_CS on GPIO19, not this default SS assignment), matching the adafruit_feather_scorpio audit's bus-alias-contamination fix pattern." },
    "16": { "capabilities": [], "note": "PIN_CAN_STANDBY — onboard MCP25625 CAN transceiver's dedicated standby-control output, driven by the CAN library during init. Not general-purpose. Confirmed via Adafruit's pinouts guide (\"GPIO16 - CAN Standby pin\") and pins_arduino.h's PIN_CAN_STANDBY alias." },
    "17": { "capabilities": [], "note": "PIN_CAN_TX0_RTS — onboard MCP25625 CAN transceiver's dedicated transmit-request line. Not general-purpose. Confirmed via Adafruit's pinouts guide (\"GPIO17 - CAN Transmit pin... CAN_TX0_RTS\") and pins_arduino.h's PIN_CAN_TX0_RTS alias." },
    "18": { "capabilities": [], "note": "PIN_CAN_RESET — onboard MCP25625 CAN transceiver's dedicated active reset line, driven by the CAN library during init. Not general-purpose. Confirmed via Adafruit's pinouts guide (\"GPIO18 - CAN Reset pin\") and pins_arduino.h's PIN_CAN_RESET alias." },
    "19": { "capabilities": [], "note": "PIN_CAN_CS — onboard MCP25625 CAN transceiver's dedicated SPI chip-select line (the CAN library's own manual CS pin, distinct from the shared SPI0 bus's default SS). Not general-purpose. Confirmed via Adafruit's pinouts guide (\"GPIO19 - CAN Chip Select pin\") and pins_arduino.h's PIN_CAN_CS alias." },
    "20": { "capabilities": [], "note": "NEOPIXEL_POWER — onboard NeoPixel power-enable gate, must be driven HIGH for the status NeoPixel (GPIO21) to be powered. Not general-purpose. Confirmed via Adafruit's pinouts guide (\"NeoPixel power pin on GPIO20. It needs to be set High for the NeoPixel to be powered\"), matching this repo's ESP32 Feather/QT Py NEOPIXEL_POWER exclusion precedent (adafruit_feather_esp32s3, adafruit_qtpy_esp32s3_nopsram, etc.)." },
    "21": { "capabilities": ["digital_output", "led_neopixel"], "note": "PIN_NEOPIXEL — onboard single status NeoPixel (WS2812), output-only data line, active-high. Confirmed via Adafruit's own pinouts guide (\"Status NeoPixel LED. It is connected to GPIO21\") and Zephyr's adafruit_feather_canbus_rp2040.dts ws2812 node (gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>). Requires NEOPIXEL_POWER (GPIO20) driven HIGH to actually light — see that pin's note." },
    "22": { "capabilities": [], "note": "PIN_CAN_INTERRUPT — onboard MCP25625 CAN transceiver's dedicated interrupt output, read internally by the CAN library. Not general-purpose. Confirmed via Adafruit's pinouts guide (\"GPIO22 - CAN Interrupt pin\") and pins_arduino.h's PIN_CAN_INTERRUPT alias." },
    "23": { "capabilities": [], "note": "PIN_CAN_RX0_BF — onboard MCP25625 CAN transceiver's dedicated receive-buffer-full/interrupt line. Not general-purpose. Confirmed via Adafruit's pinouts guide (\"GPIO23 - CAN Receive pin... CAN_RX0_BF\") and pins_arduino.h's PIN_CAN_RX0_BF alias." }
  },

  // Same 8-bit analogWrite() default as every other RP2040/RP2350 board.
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // No hardware DAC on RP2040/RP2350.
  "dac": {},

  // RP2040's one 12-bit ADC (0-4095), ~3.3V reference — same as every
  // other RP2040 board. This board's pins_arduino.h declares no analog
  // aliases of its own (its bespoke D0-D29/A0-A3 static-const block
  // mirrors the chip's standard A0-A3 = GPIO26-29 mapping), and this
  // audit found no reason to override that.
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" }
}
