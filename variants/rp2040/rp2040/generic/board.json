{
  // Output filename and BoardLoader data-variable name:
  //   boardName "RP2040" -> designer/boards/RP2040/RP2040.json -> const RP2040Data = {...}
  "boardName": "RP2040",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "Generic RP2040",

  // Same parser dialect as every other RP2040 board — see
  // ../board.json for the full rationale.
  "family": "rp2040",

  // This entry has no vendor-specific pins_arduino.h of its own — it IS
  // the shared variants/rp2040/rp2040/generic/{pins_arduino.h,common.h}
  // template file that other boards include via "../generic/common.h".
  // Its pins_arduino.h declares no capacitive/mechanical button aliases,
  // so there is nothing to add here.
  "inputOnlyGpios": [],

  // Default transports — Serial only.
  "connections": ["serial"],

  "pinNotes": {},

  // pfodWeb NOTE — GENERIC/TEMPLATE ENTRY, NOT A RESEARCHED PRODUCT:
  // "Generic RP2040" exists in the Designer's board picker so users with
  // a DIY/custom/unlisted RP2040 board can pick something reasonable
  // rather than nothing. It is not a real vendor product, so there is no
  // datasheet to research for it. Its own pins_arduino.h is literally the
  // template file at variants/rp2040/rp2040/generic/{pins_arduino.h,
  // common.h} that other boards' pins_arduino.h include via
  // "../generic/common.h" — and that template declares PIN_LED (25u) /
  // LED_BUILTIN = GPIO25, SPI0/SPI1, and Wire0/Wire1 pins with the exact
  // same numeric values as variants/rp2040/rp2040/rpipico/pins_arduino.h
  // (the official Raspberry Pi Pico). This is not a coincidence: this
  // generic entry's practical use case is "select this if your board is
  // a bare Pico-compatible layout you don't see listed" — i.e. the same
  // physical GPIO25-onboard-LED convention already confirmed for rpipico
  // in this repo (see variants/rp2040/rp2040/rpipico/board.json and
  // boardsDetails/rp2040/rp2040/rpipico/notes.txt: GP25 LED confirmed
  // active-high via official Raspberry Pi Pico datasheet/documentation
  // and consistent secondary sources — HIGH = LED on, LOW = LED off).
  // Tagged here the same way, for consistency and so the Designer's
  // onboard-LED widget behaves sensibly out of the box. Users who select
  // "Generic RP2040" for a real but unlisted board should verify GPIO25
  // against their own board's actual schematic/silkscreen before relying
  // on this — it may not have an LED on GPIO25 at all, or may wire it
  // differently.
  "chipGpios": {
    "25": { "capabilities": ["digital_output", "pwm_output", "led_high"], "note": "PIN_LED / LED_BUILTIN in this shared generic template — assumed onboard LED, active-high, by analogy with rpipico (same template values). NOT vendor-confirmed for this generic/DIY entry: verify against your actual board before relying on this." }
  },

  // Same 8-bit analogWrite() default as every other RP2040/RP2350 board.
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // No hardware DAC on RP2040/RP2350.
  "dac": {},

  // 3 analog channels (A0-A2 = GPIO26-28), 12-bit ADC — matches the
  // chip-level default and this board's own generic/common.h
  // (NUM_ANALOG_INPUTS = 3, ADC_RESOLUTION = 12).
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" }
}
