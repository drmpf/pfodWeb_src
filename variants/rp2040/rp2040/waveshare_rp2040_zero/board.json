{
  // Output filename and BoardLoader data-variable name:
  //   boardName "RP2040" -> designer/boards/RP2040/RP2040.json -> const RP2040Data = {...}
  "boardName": "RP2040",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "Raspberry Pi Pico (RP2040)",

  // Same parser dialect as every other RP2040 board — see
  // ../board.json for the full rationale.
  "family": "rp2040",

  // This board's own pins_arduino.h declares no capacitive/mechanical
  // button aliases. The board has BOOT and RESET buttons (confirmed via
  // Waveshare wiki / teachmemicro.com pinout guide), but BOOT enters
  // ROM bootloader mode (not a normal GPIO digitalRead(), same
  // out-of-scope rationale as ../rpipico/board.json) and RESET is a
  // hardware reset line, not a user-readable GPIO — neither has a
  // pins_arduino.h alias to attach a "button" capability to.
  "inputOnlyGpios": [],

  // Default transports — Serial only.
  "connections": ["serial"],

  "pinNotes": {},

  // GPIO16 (PIN_NEOPIXEL) is the board's only onboard visual indicator —
  // this "Zero" form-factor board has NO separate plain LED, only the
  // WS2812 NeoPixel (confirmed via multiple sources below). Output-only
  // capabilities here bypass the default input/output derivation, which
  // would otherwise also offer digital_input for it. pwm_output omitted
  // per this repo's NeoPixel-tagging convention (WS2812 is a
  // bit-serial-protocol data line, not a PWM-dimmable pin) — matches
  // ../vccgnd_yd_rp2040/board.json GPIO23 precedent.
  "chipGpios": {
    "16": { "capabilities": ["digital_output", "led_neopixel"], "note": "PIN_NEOPIXEL — WS2812 LED, board's only indicator" }
  },

  // Same 8-bit analogWrite() default as every other RP2040/RP2350 board.
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // No hardware DAC on RP2040/RP2350.
  "dac": {},

  // Same 12-bit ADC as every other RP2040/RP2350 board (this board's
  // pins_arduino.h declares no board-specific analog aliases beyond the
  // shared generic_full/common.h defaults).
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" }
}
