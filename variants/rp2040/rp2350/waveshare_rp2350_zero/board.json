{
  // Output filename and BoardLoader data-variable name:
  //   boardName "RP2350" -> designer/boards/RP2350/RP2350.json -> const RP2350Data = {...}
  "boardName": "RP2350",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "Raspberry Pi Pico 2 (RP2350)",

  // Same pin-declaration style as RP2040 — shares the "rp2040" family
  // value (see variants/rp2040/rp2040/board.json for the full rationale)
  // so this stays grouped under the same Designer family, split out as
  // its own "chip" bucket.
  "family": "rp2040",

  // This board's own pins_arduino.h declares no capacitive/mechanical
  // button aliases. The board has BOOT and RESET buttons (confirmed via
  // Waveshare wiki / TinyGo / Zephyr docs, same as its RP2040-Zero
  // sibling), but BOOT enters ROM bootloader mode (not a normal GPIO
  // digitalRead(), same out-of-scope rationale as
  // ../../rp2040/rpipico/board.json) and RESET is a hardware reset line,
  // not a user-readable GPIO — neither has a pins_arduino.h alias to
  // attach a "button" capability to.
  "inputOnlyGpios": [],

  // Default transports — Serial only.
  "connections": ["serial"],

  // RP2040/RP2350 boot from an internal ROM/BOOTSEL, not GPIO-driven
  // flash-mode strapping pins like ESP32/ESP8266 — no boot-time
  // restrictions to flag at the chip level.
  "pinNotes": {},

  // GPIO16 (PIN_NEOPIXEL) is the board's only onboard visual indicator —
  // this "Zero" form-factor board has NO separate plain LED, only the
  // WS2812 NeoPixel (confirmed via multiple sources — see notes.txt).
  // Output-only capabilities here bypass the default input/output
  // derivation, which would otherwise also offer digital_input for it.
  // pwm_output omitted per this repo's NeoPixel-tagging convention
  // (WS2812 is a bit-serial-protocol data line, not a PWM-dimmable pin)
  // — matches ../../rp2040/waveshare_rp2040_zero/board.json GPIO16
  // precedent (same PIN_NEOPIXEL alias, same GPIO number, sibling
  // board in the RP2040 family sharing the identical "Zero" form
  // factor).
  "chipGpios": {
    "16": { "capabilities": ["digital_output", "led_neopixel"], "note": "PIN_NEOPIXEL — onboard WS2812 addressable RGB LED, output-only, board's sole visual indicator (no separate plain LED exists on this board). Confirmed via Waveshare's own RP2350-Zero wiki page (www.waveshare.com/wiki/RP2350-Zero, product page www.waveshare.com/rp2350-zero.htm — 'WS2812 cool RGB LED'), Zephyr Project board docs (docs.zephyrproject.org/latest/boards/waveshare/rp2350_zero — pio node configured for ws2812, no separate plain LED documented), and WebSearch corroboration of GPIO16 as the WS2812 data pin (matching this board's own pins_arduino.h #define PIN_NEOPIXEL (16u)). Only BOOT and RESET buttons exist on this board (both out of scope — see pfodWeb NOTE above), same pattern as the RP2040-Zero sibling." }
  },

  // Same 8-bit analogWrite() default as RP2040.
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  // Same 12-bit ADC as RP2040.
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" }
}
