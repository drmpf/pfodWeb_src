{
  // Output filename and BoardLoader data-variable name:
  //   boardName "RP2350" -> designer/boards/RP2350/RP2350.json -> const RP2350Data = {...}
  "boardName": "RP2350",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name) — for this board that's
  // "Pimoroni Explorer" (variants/rp2040/boards.txt: pimoroni_explorer.name=).
  "displayName": "Raspberry Pi Pico 2 (RP2350)",

  // Same parser dialect as every other RP2040/RP2350 board — see
  // ../board.json for the full rationale.
  "family": "rp2040",

  "inputOnlyGpios": [],

  // Default transports — Serial only (plain non-WiFi "rp2350" chip
  // bucket; the Pimoroni Explorer has no onboard WiFi radio).
  "connections": ["serial"],

  "pinNotes": {},

  // pfodWeb NOTE (dedicated-hardware pin-exclusion audit, 2026-07-13):
  //
  // Board: Pimoroni "Explorer" — an RP2350B-based ($/PIM720) learning/
  // physical-computing board with an onboard 2.8" IPS LCD (320x240,
  // ST7789V driver, parallel 8080-style bus — CS/RS(DC)/WR/RD/DB0-7,
  // per this board's own pins_arduino.h header comment citing the
  // vendor schematic PDF), six tactile buttons surrounding the screen
  // (A/B/C/X/Y/Z), a separate User/Boot button, an onboard piezo
  // speaker (PWM tone line + amplifier-enable line), four servo
  // headers, a Qwiic/STEMMA-QT I2C connector, six analog/digital
  // sensor input channels (crocodile-clip friendly), and a small
  // breadboard area fed by GPIO0-5. This board's own pins_arduino.h is
  // unusually well-commented and already cites its own authoritative
  // sources (github.com/pimoroni/explorer explorer/ + examples/lib/
  // explorer.py, plus the vendor schematic PDF) — every pin below was
  // cross-checked against that file, against a live fetch of
  // examples/lib/explorer.py (which defines SWITCH_A_PIN=16,
  // SWITCH_B_PIN=15, SWITCH_C_PIN=14, SWITCH_X_PIN=17, SWITCH_Y_PIN=18,
  // SWITCH_Z_PIN=19, SERVO_1..4_PIN=9,8,7,6, PWM_AUDIO_PIN=12,
  // AMP_EN_PIN=13, ADC_0..5_PIN=40-45, GPIO_0..5_PIN=0-5 — an exact
  // match), and against docs/reference.md + shop.pimoroni.com/
  // learn.pimoroni.com product copy (confirms "six tactile buttons",
  // "Active Low" button reading, "four Servo instances... pins 6-9",
  // piezo speaker via PWM+amp-enable, Qw/St I2C connector, Reset and
  // Boot buttons).
  //
  // Two real findings from this audit:
  // 1. GPIO25 (`#define PIN_LED 25`, also `#define LED_BUILTIN
  //    PIN_LED`) is NOT a real onboard LED — this board's own
  //    pins_arduino.h says so explicitly: "// The LED will not blink,
  //    but sketches will compile". It is a compile-compatibility
  //    placeholder only (no vendor source describes any GPIO25 LED on
  //    this board; product/pinout docs describe only the LCD, six
  //    buttons, speaker, servos, and analog inputs). No led_high/
  //    led_low tag applied — tagged capabilities:[] instead with a
  //    note explaining why, matching this repo's "document a
  //    non-functional pin rather than silently omit it" convention.
  //    (Also a `#define` only, not a `static const uint8_t` alias, so
  //    it was never routable as a Designer pin regardless.)
  // 2. Many of this board's dedicated pins (servo headers, onboard
  //    speaker, LCD bus, GPIO10/11/29 "NC") are declared as plain
  //    `#define PIN_xxx (n)` macros, NOT `static const uint8_t`
  //    aliases — build_boards.js's parser (parseEsp32Consts) only
  //    harvests the latter, so none of these GPIOs were reaching the
  //    Designer at all before this board.json existed. The chipGpios
  //    entries below add them back in explicitly (with researched
  //    capabilities/notes) so the Designer's pin picker shows *why*
  //    each one is present/absent, matching the established
  //    wiznet_5500_evb_pico / bigtreetech_SKR_Pico precedent, rather
  //    than leaving them silently missing.
  //
  // Policy used for two ambiguous categories (both have direct
  // same-repo precedent — see notes.txt for the full trail):
  //   - Servo-header signal pins (GPIO6-9) and onboard-speaker pins
  //     (GPIO12/13): each is a single, independently-useful PWM/
  //     digital signal (drive one servo, or produce one tone) — NOT a
  //     multi-pin coordinated bus. Matches this repo's
  //     pimoroni_servo2040 precedent (servo-header outputs kept as
  //     legitimate general-purpose PWM pins, not treated as
  //     exclusionary dedicated hardware) and cytron_maker_pi_rp2040's
  //     PIN_BUZZER precedent ("left untagged/general-purpose — no
  //     buzzer capability vocabulary exists in this codebase").
  //     Exposed here as digital_input+digital_output+pwm_output.
  //   - LCD parallel-bus pins (GPIO26-28, 30-39): a multi-pin,
  //     protocol-driven 8080-style bus (CS/RS/WR/RD + 8-bit data bus)
  //     where toggling any single pin generically produces no useful
  //     standalone effect and can desync the display driver — matches
  //     this repo's bridgetek_idm2040_43a (EVE SPI bus) and
  //     bigtreetech_SKR_Pico (stepper STEP/DIR/EN bus) precedent of
  //     capabilities:[] for coordinated-bus dedicated hardware.
  //
  // Full findings/sources trail:
  // boardsDetails/rp2040/rp2350/pimoroni_explorer/notes.txt
  "chipGpios": {
    "6":  { "capabilities": ["digital_input", "digital_output", "pwm_output"], "note": "PIN_SERVO1 — onboard servo header 1 signal line. #define only" },
    "7":  { "capabilities": ["digital_input", "digital_output", "pwm_output"], "note": "PIN_SERVO2 — onboard servo header 2 signal line" },
    "8":  { "capabilities": ["digital_input", "digital_output", "pwm_output"], "note": "PIN_SERVO3 — onboard servo header 3 signal line" },
    "9":  { "capabilities": ["digital_input", "digital_output", "pwm_output"], "note": "PIN_SERVO4 — onboard servo header 4 signal line" },
    "10": { "capabilities": [], "note": "Not connected (NC)" },
    "11": { "capabilities": [], "note": "Not connected (NC)" },
    "12": { "capabilities": ["digital_input", "digital_output", "pwm_output"], "note": "PIN_PWM_AUDIO — onboard piezo speaker PWM drive, #define only" },
    "13": { "capabilities": ["digital_input", "digital_output", "pwm_output"], "note": "PIN_SPEAKER_AMP_ENABLE — onboard speaker amplifier enable/mute" },
    "14": { "capabilities": ["digital_input", "button"], "note": "SWITCH_C — one of six onboard tactile buttons, active-low" },
    "15": { "capabilities": ["digital_input", "button"], "note": "SWITCH_B — onboard tactile button, active-low" },
    "16": { "capabilities": ["digital_input", "button"], "note": "SWITCH_A — onboard tactile button, active-low" },
    "17": { "capabilities": ["digital_input", "button"], "note": "SWITCH_X — onboard tactile button, active-low" },
    "18": { "capabilities": ["digital_input", "button"], "note": "SWITCH_Y — onboard tactile button, active-low" },
    "19": { "capabilities": ["digital_input", "button"], "note": "SWITCH_Z — onboard tactile button, active-low" },
    "22": { "capabilities": ["digital_input", "button"], "note": "SWITCH_BOOT — onboard User/Boot button, active-low" },
    "25": { "capabilities": [], "note": "PIN_LED / LED_BUILTIN — NOT a real onboard LED" },
    "26": { "capabilities": [], "note": "PIN_LCD_BL — onboard 2.8in LCD backlight enable line" },
    "27": { "capabilities": [], "note": "PIN_LCD_CS — onboard LCD's dedicated parallel-bus chip-select" },
    "28": { "capabilities": [], "note": "PIN_LCD_RS — onboard LCD's parallel-bus register-select line" },
    "29": { "capabilities": [], "note": "Not connected (NC)" },
    "30": { "capabilities": [], "note": "PIN_LCD_WR — onboard LCD's dedicated parallel-bus write-strobe" },
    "31": { "capabilities": [], "note": "PIN_LCD_RD — onboard LCD's dedicated parallel-bus read-strobe" },
    "32": { "capabilities": [], "note": "PIN_LCD_DB0 — onboard LCD's dedicated 8-bit parallel data-bus" },
    "33": { "capabilities": [], "note": "PIN_LCD_DB1 — onboard LCD's dedicated 8-bit parallel data-bus" },
    "34": { "capabilities": [], "note": "PIN_LCD_DB2 — onboard LCD's dedicated 8-bit parallel data-bus" },
    "35": { "capabilities": [], "note": "PIN_LCD_DB3 — onboard LCD's dedicated 8-bit parallel data-bus" },
    "36": { "capabilities": [], "note": "PIN_LCD_DB4 — onboard LCD's dedicated 8-bit parallel data-bus" },
    "37": { "capabilities": [], "note": "PIN_LCD_DB5 — onboard LCD's dedicated 8-bit parallel data-bus" },
    "38": { "capabilities": [], "note": "PIN_LCD_DB6 — onboard LCD's dedicated 8-bit parallel data-bus" },
    "39": { "capabilities": [], "note": "PIN_LCD_DB7 — onboard LCD's dedicated 8-bit parallel data-bus" }
  },

  // Same 8-bit analogWrite() default as every other RP2040/RP2350 board.
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // No hardware DAC on RP2040/RP2350.
  "dac": {},

  // 6-channel 12-bit ADC (GPIO40-45 / ADC0-5) — matches this board's
  // own pins_arduino.h (NUM_ANALOG_INPUTS=6, ADC_RESOLUTION=12). Left
  // fully general-purpose (no chipGpios override): these are the
  // board's advertised "analog-friendly crocodile clip terminals" /
  // analog sensor inputs, a genuine user-facing expansion feature, not
  // a fixed onboard sensor — matches this repo's established onboard-
  // analog-sensor KEEP policy (e.g. bigtreetech_SKR_Pico GPIO26/27
  // thermistors, esp32/esp32/oroca_edubot).
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" }
}
