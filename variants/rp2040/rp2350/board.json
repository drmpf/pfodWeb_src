{
  // Output filename and BoardLoader data-variable name:
  //   boardName "RP2350" -> designer/boards/RP2350/RP2350.json -> const RP2350Data = {...}
  "boardName": "RP2350",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "Raspberry Pi Pico 2 (RP2350)",

  // Same pin-declaration style as RP2040 — shares the "rp2040" family
  // value (see variants/rp2040/rp2040/board.json for the full rationale)
  // so this stays grouped under the same Designer family, split out as
  // its own "chip" bucket. Every named RP2350 board in this bucket uses
  // the 30-pin RP2350A-compatible pinout (pin-identical to RP2040). The
  // one genuine 48-pin RP2350B board in this variant set
  // (waveshare_rp2350b_plus_w) is WiFi-equipped and lives in the
  // "rp2040w" chip bucket instead — fully self-contained there, so it
  // doesn't rely on any chip-level assumption from this file either way.
  "family": "rp2040",

  "inputOnlyGpios": [],

  // Default transports — Serial only.  Every WiFi-chip-equipped board
  // (Pico 2 W, Pimoroni Pico Plus 2 W, Pimoroni Plasma 2350 W, Waveshare
  // RP2350B Plus W) lives in its own "rp2040w" chip bucket instead
  // (variants/rp2040/rp2040w/board.json), so this plain "rp2350" bucket
  // never needs a tcp/http/ble override.
  "connections": ["serial"],

  // RP2040/RP2350 boot from an internal ROM/BOOTSEL, not GPIO-driven
  // flash-mode strapping pins like ESP32/ESP8266 — no boot-time
  // restrictions to flag at the chip level.
  "pinNotes": {},

  // Deliberately empty — see variants/rp2040/rp2040/board.json for why a
  // uniform chip-level GPIO map isn't appropriate for this family.
  "chipGpios": {},

  // Same 8-bit analogWrite() default as RP2040 — see
  // variants/rp2040/rp2040/board.json.
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  // Same 12-bit ADC as RP2040 — see variants/rp2040/rp2040/board.json.
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" }
}
