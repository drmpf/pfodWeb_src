{
  "boardName": "feather_nrf52832",
  "displayName": "Adafruit Feather nRF52832",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  "connections": ["serial", "ble"],

  "pinNotes": {
    "31": "PIN_VBAT (A7) — hard-wired to a LiPo battery divider"
  },

  // nRF52832 (unlike nRF52833/nRF52840) has NO USB peripheral at all —
  // this board's "Serial" is a REAL hardware UART bridged to USB via an
  // onboard CP2104 USB-to-serial chip, confirmed via this repo's own
  // Adafruit_nrf52/variants/feather_nrf52832/variant.h declaring
  // PIN_SERIAL_RX(8)/PIN_SERIAL_TX(6) (note: singular "PIN_SERIAL_",
  // unlike every nRF52840/nRF52833 board in this family which uses
  // "PIN_SERIAL1_" for an OPTIONAL secondary UART alongside native USB).
  // Since these two pins are genuinely this board's only path for the
  // pfodApp wired Serial connection, they are force-tagged serial_tx/
  // serial_rx below (same forcedRole mechanism ESP8266's chip-level
  // board.json already uses for GPIO1/GPIO3) rather than left as
  // general-purpose GPIO — committing them to anything else would break
  // the wired connection entirely. No physical user button exists on
  // this board (no PIN_BUTTON macro anywhere in variant.h — confirmed,
  // not an oversight).
  "chipGpios": {
    "6": { "capabilities": ["serial_tx"], "note": "PIN_SERIAL_TX — real hardware UART bridged to USB" },
    "8": { "capabilities": ["serial_rx"], "note": "PIN_SERIAL_RX — real hardware UART bridged to USB" },
    "17": { "capabilities": ["digital_output", "pwm_output", "led_high"],
             "note": "PIN_LED1/LED_BUILTIN/LED_RED — active-high" },
    "19": { "capabilities": ["digital_output", "pwm_output", "led_high"],
             "note": "PIN_LED2/LED_CONN/LED_BLUE — active-high" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
