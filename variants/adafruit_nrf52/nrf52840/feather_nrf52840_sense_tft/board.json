{
  "boardName": "feather_nrf52840_sense_tft",
  "displayName": "Adafruit Feather nRF52840 Sense TFT",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  "connections": ["serial", "ble"],

  "pinNotes": {},

  // Sources: this repo's own Adafruit_nrf52/variants/
  // feather_nrf52840_sense_tft/variant.h (SPI_INTERFACES_COUNT=1 — only
  // ONE SPI bus on this board, unlike CLUE's two). Confirmed via this
  // repo's own precedent for Adafruit's other "*_tft" Feather variants
  // (variants/esp32/esp32s3/adafruit_feather_esp32s3_tft/board.json:
  // "dedicated onboard TFT display + SPI bus") that Adafruit's TFT
  // Feather product line consistently dedicates the board's ENTIRE
  // default SPI bus to the onboard display rather than sharing it as
  // general-purpose — applied the same way here: the default SPI bus
  // (SS=5, MISO=24, MOSI=25, SCK=26) is excluded as the TFT's bus, with
  // PIN_TFT_CS(35)/DC(36)/RST(37)/LITE(38) as its other, #define-only
  // (already-invisible) control lines. The onboard LSM6DS3TR-C IMU
  // (interrupt line PIN_LSM6DS3_IRQ=4, #define-only) and PDM microphone
  // (PIN_PDM_DIN=33/PDM_CLK=34, gated by PIN_SENSOR_POWER=21, all
  // #define-only) live on the DEFAULT Wire bus (SDA=22/SCL=23), kept
  // general-purpose per this repo's established policy.
  "chipGpios": {
    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"],
             "note": "PIN_LED1/LED_BUILTIN — active-high" },
    "8": { "capabilities": ["digital_output", "pwm_output", "led_neopixel"],
            "note": "PIN_NEOPIXEL — power gated by GPIO7, drive HIGH first" },
    "3": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON1" },
    "5": { "capabilities": [], "note": "SPI SS — dedicated to the onboard TFT display's bus" },
    "24": { "capabilities": [], "note": "SPI MISO — dedicated to the onboard TFT display's bus" },
    "25": { "capabilities": [], "note": "SPI MOSI — dedicated to the onboard TFT display's bus" },
    "26": { "capabilities": [], "note": "SPI SCK — dedicated to the onboard TFT display's bus" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
