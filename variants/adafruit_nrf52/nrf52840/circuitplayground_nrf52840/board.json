{
  "boardName": "circuitplayground_nrf52840",
  "displayName": "Adafruit Circuit Playground Bluefruit",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  "connections": ["serial", "ble"],

  "pinNotes": {},

  // Primary source: this repo's own Adafruit_nrf52/variants/
  // circuitplayground_nrf52840/variant.h. Cross-checked against the
  // official Adafruit_CircuitPlayground Arduino library source
  // (github.com/adafruit/Adafruit_CircuitPlayground, downloaded and
  // inspected directly), which hard-codes the exact pin number of every
  // onboard component per chip family via #ifdef blocks — same
  // authoritative-source pattern already established and documented for
  // this repo's AVR "Circuit Playground Classic" board
  // (variants/arduino/avr/circuitplay32u4/board.json), just the
  // `#elif defined(ARDUINO_NRF52840_CIRCUITPLAY)` block instead of the
  // `#ifdef __AVR__` one:
  //   CPLAY_LEFTBUTTON=4, CPLAY_RIGHTBUTTON=5, CPLAY_SLIDESWITCHPIN=7,
  //   CPLAY_NEOPIXELPIN=8, CPLAY_REDLED=13, CPLAY_BUZZER=A0(=14),
  //   CPLAY_LIGHTSENSOR=A8(=22), CPLAY_THERMISTORPIN=A9(=23),
  //   CPLAY_LIS3DH_CS=-1 (confirms the onboard LIS3DH accelerometer is
  //   wired over I2C on THIS chip family, not SPI like the AVR
  //   'classic' board), CPLAY_LIS3DH_INTERRUPT=27,
  //   CPLAY_CAPSENSE_SHARED=255 ("we use ground instead of capacitive
  //   sense pin" — no shared reference pin needed on this chip, unlike
  //   the AVR board's pin 30).
  "chipGpios": {
    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"],
             "note": "PIN_LED1/LED_BUILTIN/CPLAY_REDLED — active-high" },
    "8": { "capabilities": ["digital_output", "pwm_output", "led_neopixel"],
            "note": "PIN_NEOPIXEL/CPLAY_NEOPIXELPIN — ring of 10 onboard NeoPixels" },
    "4": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON1/CPLAY_LEFTBUTTON — Button A (Left)." },
    "5": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON2/CPLAY_RIGHTBUTTON — Button B (Right)." },
    "14": { "capabilities": [], "note": "A0 — dedicated to the onboard piezo buzzer (PIN_BUZZER)" },
    "22": { "capabilities": [], "note": "A8 — dedicated to the onboard light sensor" },
    "23": { "capabilities": [], "note": "A9 — dedicated to the onboard thermistor" },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"],
             "note": "A7 — not really analog on this chip, kept digital-only" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
