{
  "boardName": "particle_xenon",
  "displayName": "Particle Xenon",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  "connections": ["serial", "ble"],

  "pinNotes": {
    "19": "Also BUTTON_FRESET/A0 (factory-reset button)",
    "20": "Also BUTTON_DFU/BUTTON_MODE (DFU-mode button)"
  },

  // This board (Particle's own hardware design, ported into Adafruit's
  // BSP format) is far more heavily pin-multiplexed than the rest of
  // this family — Serial1/Serial2/SPI1/Wire1 all reuse various D0-D20
  // header pins as alternate functions. Consistent with this repo's
  // established "a pin that CAN alternately serve a bus role isn't
  // thereby dedicated" policy (matching how D6/D7 are treated on every
  // other board in this family), none of D0-D20 are excluded for this
  // reason — they stay available as ordinary general-purpose GPIO, with
  // their alternate Serial1/Serial2/SPI1/Wire1 roles available to a
  // user's own sketch code if chosen, same as the rest of this family.
  //
  // The single-color status LED (D7) is confirmed via a source
  // independent of the family-wide Adafruit LED_STATE_ON spot-check —
  // Particle's own documentation states "Pin D7 is connected to an
  // on-board LED; if you set pin D7 to HIGH, the LED will turn on" —
  // confirming active-high directly for this specific, third-party-
  // designed board rather than assuming the Adafruit-boards spot-check
  // extends to Particle's own hardware.
  //
  // The discrete 3-channel RGB status LED (LED_RGB_RED/GREEN/BLUE,
  // GPIO22-24) was initially left excluded-but-untagged pending polarity
  // confirmation (matching this repo's "Pcbcupid_GLYPH_C3" precedent).
  // RESOLVED via github.com/adafruit/Adafruit_nRF52_Bootloader/src/
  // boards/particle_xenon/board.h (the actual bootloader's own board
  // definition for this exact product): declares LED_STATE_ON=1
  // board-wide (applies to both LED_PRIMARY_PIN and the LED_RGB_*_PIN
  // trio together, same firmware convention as every other board in
  // this family) and LED_RGB_RED_PIN=P0.13/GREEN_PIN=P0.14/BLUE_PIN=
  // P0.15 — cross-referenced against this board's own variant.cpp
  // g_ADigitalPinMap and confirmed those exact physical addresses sit
  // at Arduino indices 22/23/24 respectively (matching LED_RGB_RED/
  // GREEN/BLUE in this board's own variant.h exactly). Now tagged
  // led_r_high/led_g_high/led_b_high accordingly.
  "chipGpios": {
    "7": { "capabilities": ["digital_output", "pwm_output", "led_high"],
            "note": "PIN_LED1/LED_BUILTIN/LED_CONN — active-high" },
    "22": { "capabilities": ["digital_output", "pwm_output", "led_r_high"],
             "note": "LED_RGB_RED, P0.13 — active-high" },
    "23": { "capabilities": ["digital_output", "pwm_output", "led_g_high"],
             "note": "LED_RGB_GREEN, P0.14 — active-high" },
    "24": { "capabilities": ["digital_output", "pwm_output", "led_b_high"],
             "note": "LED_RGB_BLUE, P0.15 — active-high" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
