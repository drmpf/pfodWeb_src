{
  "boardName": "raytac_mdbt50q_rx",
  "displayName": "Raytac nRF52840 Dongle",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  // nRF52840 has native USB — Serial is native USB-CDC (this is a USB
  // dongle form factor, "nRF52840 USB Key w/ TinyUF2 Bootloader"), no
  // GPIO involved. PIN_SERIAL1_RX/TX are both deliberately set to the
  // SAME invalid/unused value (3) by the vendor's own comment ("Bad
  // things happen if the serial pins aren't defined... define them with
  // an invalid pin number") — confirms no real UART is wired on this
  // board at all.
  "connections": ["serial", "ble"],

  "pinNotes": {},

  // This dongle has NO general-purpose header at all — PINS_COUNT=3,
  // just one status LED and one button, confirmed via this repo's own
  // Adafruit_nrf52/variants/raytac_mdbt50q_rx/variant.h. LED2 (pin 1) is
  // explicitly commented "not populated by default" in the vendor
  // source — left untagged/invisible (no chipGpios entry) rather than
  // exposing an LED most physical units don't have.
  "chipGpios": {
    "0": { "capabilities": ["digital_output", "led_low"],
            "note": "PIN_LED1/LED_BUILTIN/LED_CONN — active-low" },
    "2": { "capabilities": ["digital_input", "button"],
            "note": "PIN_BUTTON1/PIN_DFU — the DFU/boot-mode button." }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
