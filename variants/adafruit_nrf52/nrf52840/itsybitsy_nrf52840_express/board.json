{
  "boardName": "itsybitsy_nrf52840_express",
  "displayName": "Adafruit ItsyBitsy nRF52840 Express",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  "connections": ["serial", "ble"],

  "pinNotes": {},

  // Sources: this repo's own Adafruit_nrf52/variants/
  // itsybitsy_nrf52840_express/variant.h. LED polarity per the family-
  // wide spot-check (see feather_nrf52840_express's notes.txt). The
  // onboard status LED is a single color (LED_RED and LED_BLUE both
  // alias the SAME pin, PIN_LED1=3 — not an RGB LED, just one LED with
  // both alias names pointing at it, matching a quirk also seen on the
  // Raytac dongle and Particle Xenon boards in this family). This board
  // has a DotStar (APA102, 2-wire clock+data) LED, not a NeoPixel — per
  // this repo's established precedent (variants/rp2040/rp2040/
  // breadstick_raspberry/board.json), DotStar pins are NOT tagged
  // led_neopixel (protocol mismatch — that tag is documented as
  // WS2812-style single-wire only) and no dedicated DotStar capability
  // tag exists in this repo's vocabulary; PIN_DOTSTAR_DATA/CLOCK are
  // #define-only here anyway (never aliased via static const), so they
  // are already invisible by default and need no explicit entry.
  "chipGpios": {
    "3": { "capabilities": ["digital_output", "pwm_output", "led_high"],
            "note": "PIN_LED1/LED_BUILTIN/LED_RED/LED_BLUE (one LED) — active-high" },
    "4": { "capabilities": ["digital_input", "button"],
            "note": "PIN_BUTTON1" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
