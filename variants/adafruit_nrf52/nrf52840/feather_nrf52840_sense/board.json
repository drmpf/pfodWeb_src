{
  "boardName": "feather_nrf52840_sense",
  "displayName": "Adafruit Feather nRF52840 Sense",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  "connections": ["serial", "ble"],

  "pinNotes": {},

  // Same general pattern as feather_nrf52840_express (see that board's
  // board.json/notes.txt for the full LED-polarity spot-check writeup).
  // This board additionally has an onboard LSM6DS33+LIS3MDL IMU, SHT30
  // humidity/temp sensor, BMP280 pressure sensor, and APDS9960 gesture/
  // color/proximity sensor — confirmed via Adafruit's own product
  // description these all share the DEFAULT Wire bus (SDA=22/SCL=23,
  // same pins as every other board in this family), not a dedicated
  // second bus — this board's variant.h declares no Wire1 at all,
  // confirming there's no separate internal-only I2C bus to exclude.
  // Kept the shared I2C bus general-purpose per this repo's established
  // "general bus, even with onboard devices already on it" policy. The
  // onboard PDM microphone (PIN_PDM_DIN=34/PIN_PDM_CLK=35) is #define-
  // only, never aliased via static const, so it never appears as a
  // pickable pin regardless.
  "chipGpios": {
    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"],
             "note": "PIN_LED1/LED_BUILTIN/LED_RED — active-high" },
    "4": { "capabilities": ["digital_output", "pwm_output", "led_high"],
            "note": "PIN_LED2/LED_CONN/LED_BLUE — active-high" },
    "7": { "capabilities": ["digital_input", "button"],
            "note": "PIN_BUTTON1" },
    "8": { "capabilities": ["digital_output", "pwm_output", "led_neopixel"],
            "note": "PIN_NEOPIXEL — single onboard WS2812/NeoPixel-style RGB LED" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
