{
  "boardName": "clue_nrf52840",
  "displayName": "Adafruit CLUE",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  "connections": ["serial", "ble"],

  "pinNotes": {},

  // Sources: this repo's own Adafruit_nrf52/variants/clue_nrf52840/
  // variant.h. CLUE has an onboard 1.3" TFT display wired over a SECOND,
  // fully-dedicated SPI bus (SPI1: SCK1=29/MOSI1=30/SS1=31/MISO1=35 —
  // SS1 matches PIN_TFT_CS(31) exactly, and PIN_TFT_DC(32)/
  // PIN_TFT_RST(33)/PIN_TFT_LITE(34) are the display's other control
  // lines) — unlike the Seeed XIAO nRF52840 Plus's I2S/SPI1 pins (which
  // have no onboard consumer and stay general-purpose), CLUE's SPI1 IS
  // its onboard TFT's private bus, so its 4 aliased pins (SS1/MOSI1/
  // MISO1/SCK1) are excluded below rather than left as ordinary GPIO —
  // GPIO35 (MISO1) also happens to double as PIN_PDM_DIN (the onboard
  // mic data line, #define-only), consistent with both uses being
  // non-general. The onboard BMP280 pressure, SHT30 humidity/temp,
  // APDS9960 gesture/color, and LSM6DS33+LIS3MDL IMU sensors all share
  // the single DEFAULT Wire bus (WIRE_INTERFACES_COUNT=1, SDA=20/
  // SCL=19) — kept general-purpose per this repo's established
  // "general bus, even with onboard devices on it" policy, same as the
  // Feather nRF52840 Sense's identical situation.
  "chipGpios": {
    "17": { "capabilities": ["digital_output", "pwm_output", "led_high"],
             "note": "PIN_LED1/LED_BUILTIN — active-high" },
    "43": { "capabilities": ["digital_output", "pwm_output", "led_high"],
             "note": "PIN_LED2 — dual white LEDs, active-high" },
    "18": { "capabilities": ["digital_output", "pwm_output", "led_neopixel"],
             "note": "PIN_NEOPIXEL — single onboard WS2812/NeoPixel-style RGB LED" },
    "5": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON1 — Button A." },
    "11": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON2 — Button B." },
    "29": { "capabilities": [], "note": "PIN_SPI1_SCK — dedicated to the onboard TFT display's bus" },
    "30": { "capabilities": [], "note": "PIN_SPI1_MOSI — dedicated to the onboard TFT display's bus" },
    "31": { "capabilities": [], "note": "PIN_SPI1_SS/PIN_TFT_CS — dedicated to the onboard TFT display" },
    "35": { "capabilities": [], "note": "PIN_SPI1_MISO — dedicated to display bus, also PDM mic data" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
