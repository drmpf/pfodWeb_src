{
  "boardName": "pca10056",
  "displayName": "Nordic nRF52840 DK",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  // nRF52840 has native USB — "Serial" is native USB-CDC via the DK's
  // "nRF USB" connector, no GPIO involved. PIN_SERIAL1_RX/TX (Arduino
  // header D0/D1) and PIN_SERIAL2_RX/TX (the DK's separate J-Link-CDC
  // virtual COM port) are both OPTIONAL, never aliased as bare "RX"/
  // "TX", so the parser's forced-dedicated-serial-pin behavior never
  // triggers — all four stay available as ordinary GPIO.
  "connections": ["serial", "ble"],

  "pinNotes": {},

  // Nordic's own reference dev kit: 4 LEDs (active-low, LED_STATE_ON=0
  // — Nordic's DK boards are well known to wire their LEDs active-low)
  // and 4 buttons, confirmed via this repo's own Adafruit_nrf52/
  // variants/pca10056/variant.h.
  "chipGpios": {
    "13": { "capabilities": ["digital_output", "pwm_output", "led_low"],
             "note": "PIN_LED1/LED_BUILTIN/LED_RED — active-low" },
    "14": { "capabilities": ["digital_output", "pwm_output", "led_low"],
             "note": "PIN_LED2/LED_CONN/LED_BLUE — active-low" },
    "15": { "capabilities": ["digital_output", "pwm_output", "led_low"],
             "note": "PIN_LED3 — active-low" },
    "16": { "capabilities": ["digital_output", "pwm_output", "led_low"],
             "note": "PIN_LED4 — active-low" },
    "11": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON1" },
    "12": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON2" },
    "24": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON3" },
    "25": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON4" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
