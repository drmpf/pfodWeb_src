{
  "boardName": "metro_nrf52840_express",
  "displayName": "Adafruit Metro nRF52840 Express",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  "connections": ["serial", "ble"],

  "pinNotes": {},

  // Full-size Arduino Uno-shield-compatible form factor — the wide
  // digital header (indices 0-13 area) has no board-specific dedicated
  // consumer found in this repo's own Adafruit_nrf52/variants/
  // metro_nrf52840_express/variant.h (no D<n> aliases declared at all —
  // this core references pins by plain number on this board, not "D5"
  // style — so unaliased indices simply show as "GPIOn" in the
  // Designer). Only the confirmed LED/button/NeoPixel pins get an
  // explicit entry; everything else keeps its default capabilities.
  "chipGpios": {
    "33": { "capabilities": ["digital_output", "pwm_output", "led_high"],
             "note": "PIN_LED1/LED_BUILTIN/LED_RED — active-high" },
    "34": { "capabilities": ["digital_output", "pwm_output", "led_high"],
             "note": "PIN_LED2/LED_CONN/LED_BLUE — active-high" },
    "37": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON1" },
    "36": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON2" },
    "35": { "capabilities": ["digital_output", "pwm_output", "led_neopixel"],
             "note": "PIN_NEOPIXEL — single onboard WS2812/NeoPixel-style RGB LED" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
