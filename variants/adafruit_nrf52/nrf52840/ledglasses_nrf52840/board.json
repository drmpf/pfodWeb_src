{
  "boardName": "ledglasses_nrf52840",
  "displayName": "Adafruit LED Glasses Driver nRF52840",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  "connections": ["serial", "ble"],

  "pinNotes": {},

  // This is a compact, dedicated LED-glasses driver board, NOT a
  // general dev board — confirmed via WebSearch (Adafruit's own product
  // page: "does not have any breakout pins to keep it compact... If you
  // need access to GPIO pins, Adafruit recommends an ItsyBitsy nRF52840,
  // Feather nRF52840, or Feather Sense instead"). This matches
  // variant.h's own extensive "not connected" comments on A0-A5, A7, and
  // the entire default SPI bus and Serial1 UART — all excluded below
  // (or already invisible for the #define-only ones). VBAT (A6) and the
  // Wire bus (STEMMA QT connector, confirmed via the same product page —
  // used for the onboard LIS3DH accelerometer and/or external STEMMA QT
  // sensors) are the only general-purpose-ish signals genuinely routed
  // on this board, alongside the confirmed LED/button/NeoPixel pins.
  "chipGpios": {
    "2": { "capabilities": ["digital_output", "pwm_output", "led_high"],
            "note": "PIN_LED1/LED_BUILTIN — active-high" },
    "3": { "capabilities": ["digital_output", "pwm_output", "led_neopixel"],
            "note": "PIN_NEOPIXEL — drives front-panel matrix, not onboard LED" },
    "4": { "capabilities": ["digital_input", "button"],
            "note": "PIN_BUTTON1" },
    "14": { "capabilities": [], "note": "A0 — not connected on this board" },
    "15": { "capabilities": [], "note": "A1 — not connected on this board" },
    "16": { "capabilities": [], "note": "A2 — not connected on this board" },
    "17": { "capabilities": [], "note": "A3 — not connected on this board" },
    "18": { "capabilities": [], "note": "A4 — not connected on this board" },
    "19": { "capabilities": [], "note": "A5 — not connected on this board" },
    "21": { "capabilities": [], "note": "A7 — not connected on this board" },
    "10": { "capabilities": [], "note": "SPI MISO — not connected on this board" },
    "11": { "capabilities": [], "note": "SPI MOSI — not connected on this board" },
    "12": { "capabilities": [], "note": "SPI SCK — not connected on this board" },
    "13": { "capabilities": [], "note": "SPI SS — not connected on this board" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
