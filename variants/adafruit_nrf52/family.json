{
  // Human-readable name shown for this family in the Designer's target
  // picker. Deliberately a SEPARATE top-level family from "Seeed XIAO
  // nRF52840 (Nordic BLE)" (variants/nrf52/) even though several boards
  // here share the exact same nRF52840 silicon — the user asked for
  // Adafruit's own nRF52 boards to be grouped separately from the XIAO
  // family, and the two vendors' boards have completely different pin
  // layouts/numbering anyway (no chip-level board.json could safely be
  // shared between them even if they were one family).
  "familyDisplayName": "Adafruit nRF52",

  // Connection types supported by this family, shown after
  // familyDisplayName with " - " in the target picker. nRF52832/833/840
  // all have Bluetooth LE but no WiFi — TCP/HTTP are omitted. Serial is
  // native USB-CDC on every nRF52833/840 board here; the one nRF52832
  // board (feather_nrf52832) has no USB peripheral at all and uses a
  // real dedicated hardware UART instead — see that board's own
  // board.json for how its Serial pins are forced/reserved accordingly.
  "connectionTypes": "Serial, BLE"
}
