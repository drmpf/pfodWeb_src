{
  "boardName": "pca10100",
  "displayName": "Nordic nRF52833 DK",

  "family": "adafruit_nrf52",

  "inputOnlyGpios": [],

  // nRF52833 has native USB (confirmed via WebSearch: nRF52833 includes
  // a full-speed 12 Mbps USB 2.0 device controller, same as nRF52840) —
  // "Serial" is native USB-CDC via the DK's "nRF USB" connector, no GPIO
  // involved, same as the nRF52840 sibling DK (pca10056). Serial1/
  // Serial2 pins are both optional/secondary, never aliased as bare
  // "RX"/"TX".
  "connections": ["serial", "ble"],

  "pinNotes": {},

  // Byte-for-byte identical pin layout to the nRF52840 DK sibling
  // (pca10056) — same board design, different chip. See that board's
  // board.json/notes.txt for the full sourcing.
  "chipGpios": {
    "13": { "capabilities": ["digital_output", "pwm_output", "led_low"],
             "note": "PIN_LED1/LED_BUILTIN/LED_RED — active-low" },
    "14": { "capabilities": ["digital_output", "pwm_output", "led_low"],
             "note": "PIN_LED2/LED_CONN/LED_BLUE — active-low" },
    "15": { "capabilities": ["digital_output", "pwm_output", "led_low"],
             "note": "PIN_LED3 — active-low" },
    "16": { "capabilities": ["digital_output", "pwm_output", "led_low"],
             "note": "PIN_LED4 — active-low" },
    "11": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON1" },
    "12": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON2" },
    "24": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON3" },
    "25": { "capabilities": ["digital_input", "button"], "note": "PIN_BUTTON4" }
  },

  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  "dac": {},

  "adc": { "bits": 14, "max": 16383, "defaultRefVolts": "3.6" }
}
