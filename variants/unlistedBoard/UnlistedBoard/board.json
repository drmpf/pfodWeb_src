{
  // Output filename and BoardLoader data-variable name:
  //   boardName "UnlistedBoard" -> designer/boards/unlistedBoard_UnlistedBoard/unlistedBoard_UnlistedBoard.json
  "boardName": "UnlistedBoard",

  // Human-readable name shown in the designer target label after board selection.
  "displayName": "Unlisted Board",

  // Parser dialect.  "unlistedBoard" is a no-pin target that uses the
  // normal Arduino code generator (not generateCcode.js) — suitable for
  // any Arduino-compatible board not listed in the board families.
  // buildCcodeBoard() in build_boards.js handles this family (same
  // no-pin structure as ccode) but board.family stays "unlistedBoard"
  // so generateCode.js routes to the Arduino generator, not the C generator.
  "family": "unlistedBoard",

  // Default serial baud rate for code generation.
  "defaultBaud": 115200,

  // No baud picker — Serial is always 115200.
  "supportedBauds": [],

  // No GPIO concept applies — no pins defined for this target.
  "inputOnlyGpios": [],

  // This target only talks pfod over Serial.
  "connections": ["serial"],

  // No pins, so no pin notes.
  "pinNotes": {},

  // No GPIO concept applies.
  "chipGpios": {},

  // No PWM, DAC or ADC support — no pins to carry them.
  "pwm": {},
  "dac": {},
  "adc": {}
}
