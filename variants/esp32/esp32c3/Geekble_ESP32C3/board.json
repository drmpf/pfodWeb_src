{
  // pfodWeb NOTE: dedicated-hardware pin-exclusion audit, 2026-07-12.
  // Board: Geekble Mini ESP32-C3 (Geekble / SooDragon, Korean maker-education
  // brand), ESP32-C3FH4 module. pins_arduino.h declares LED_BUILTIN=10,
  // SW_BUILTIN=9, TX=21, RX=20 (plus the usual SPI/I2C/analog boilerplate
  // aliasing the same small GPIO set).
  //
  // Sources consulted:
  //  - https://github.com/SooDragon/GeekbleMini-ESP32C3
  //    Official hardware repo (schematic, footprint, pinmap diagrams).
  //  - https://raw.githubusercontent.com/SooDragon/GeekbleMini-ESP32C3/main/PinMap/GEEKBLE%20Mini_V2_PinMap.png
  //    Official pinmap image (v2.0, 2025-02-26): shows a physical "B"
  //    (Boot) pushbutton on the board silkscreen, wired to pin D9/GPIO9,
  //    explicitly labelled "BOOT", "SW_BUILTIN", "PULL-UP" on both the
  //    left-side MICRO/ARDUINO column and the right-side ARDUINO/MICRO
  //    column. LED_BUILTIN/D10/GPIO10 and TX(GPIO21)/RX(GPIO20) also match
  //    this board's pins_arduino.h exactly, confirming the diagram is for
  //    this exact variant.
  //
  // GPIO9 (SW_BUILTIN): confirmed onboard physical BOOT pushbutton, external
  // pull-up (standard ESP32-C3 strapping/boot-select pin doubling as a
  // user-readable button - the same pattern as most ESP32-C3 dev boards).
  // Not TX/RX (TX=21, RX=20 per this board's own pins_arduino.h). Chip-level
  // "Must be HIGH for normal boot" pinNotes entry retained. Tagged
  // capabilities ["digital_input","button"] only.
  //
  // See boardsDetails/esp32/esp32c3/Geekble_ESP32C3/notes.txt for the full
  // research trail.

  "boardName": "ESP32C3",
  "displayName": "ESP32-C3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "2": "Must be HIGH for normal boot",
    "8": "Must be HIGH or floating on reboot",
    "9": "Must be HIGH for normal boot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "6":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "7":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "8":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "9":  { "capabilities": ["digital_input", "button"] },
    "10": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "20": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
}
