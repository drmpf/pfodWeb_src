{
  // pfodWeb NOTE: dedicated-hardware pin-exclusion audit, 2026-07-12.
  // Board: Bee Motion Mini (Smart Bee Designs LLC / designer Paul Price),
  // ESP32-C3-MINI-1 module + onboard PIR motion sensor, no USB port (only
  // TX/RX header pins for flashing), JST battery connector. pins_arduino.h
  // declares TX=21, RX=20, BOOT_BTN=9, PIR=5 (plus the usual SPI/I2C/analog
  // boilerplate aliasing the same small GPIO set).
  //
  // Sources consulted:
  //  - https://www.cnx-software.com/2022/04/05/bee-motion-mini-esp32-c3-pir-sensor-board/
  //    Confirms onboard "BOOT and RESET buttons" and that the only exposed
  //    I/O besides power is the Tx/Rx header (no USB port on this SKU).
  //  - https://www.tindie.com/products/smartbee/bee-motion-mini-esp32-pir-motion-sensor/
  //    Vendor product listing: PIR motion sensor with dome lens, ~5 m range,
  //    JST battery connector, confirms this board's entire purpose is an
  //    onboard PIR sensor.
  //  - https://github.com/strid3r21/BeeMotionMini
  //    Official documentation repo: describes press-and-hold BOOT then tap
  //    RESET to enter download mode - confirms a real, physical onboard BOOT
  //    button (standard ESP32-C3 strapping-pin button), and an Arduino sketch
  //    polling the PIR sensor.
  //  - https://www.espboards.dev/esp32/bee-motion-mini/
  //    Independent pinout table: "BOOT_BTN" on pin 9, RX=20/TX=21 - matches
  //    this board's own pins_arduino.h exactly.
  //
  // GPIO9 (BOOT_BTN): confirmed onboard physical button (standard ESP32-C3
  // BOOT/strapping pin, also used to enter flash-download mode). Not TX/RX
  // (TX=21, RX=20). Chip-level "Must be HIGH for normal boot" pinNotes entry
  // retained. Tagged capabilities ["digital_input","button"] only.
  //
  // GPIO5 (PIR): confirmed onboard PIR (passive infrared) motion sensor
  // digital output - this is this board's defining feature, not an excluded
  // dedicated-hardware pin. KEEP available per playbook policy (same bucket
  // as a battery/voltage monitor or SD-detect switch); left un-tagged
  // (chip-level capabilities unchanged) but annotated with an informational
  // "note" field so a Designer user understands what they're reading.
  //
  // See boardsDetails/esp32/esp32c3/Bee_Motion_Mini/notes.txt for the full
  // research trail.

  "boardName": "ESP32C3",
  "displayName": "ESP32-C3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "2": "Must be HIGH for normal boot",
    "8": "Must be HIGH or floating on reboot",
    "9": "Must be HIGH for normal boot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"], "note": "Wired onboard to this board's PIR (passive infrared) motion sensor digital output. Confirmed via vendor product page/GitHub docs - see boardsDetails notes.txt." },
    "6":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "7":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "8":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "9":  { "capabilities": ["digital_input", "button"] },
    "10": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "20": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
}
