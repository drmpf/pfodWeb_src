// pfodWeb NOTE: GPIO8 tagged "led_neopixel" - confirmed onboard addressable
// WS2812 RGB LED on GPIO8 on BOTH of Espressif's own official ESP32-C3
// reference boards (ESP32-C3-DevKitM-1 and ESP32-C3-DevKitC-02), per
// Espressif's own ESP-IDF Programming Guide user-guide pages and board
// schematics. This "esp32c3" variant's pins_arduino.h (TX=21/RX=20,
// SPI SS=7/MOSI=6/MISO=5/SCK=4) matches those boards' own default pin
// assignments exactly, and this Arduino IDE entry ("ESP32C3 Dev Module")
// is the ONLY entry in boards.txt for either official board - there is no
// separate dedicated DevKitM-1/DevKitC-02 entry.
//
// CONFIDENCE CAVEAT: this same generic entry is also commonly selected as
// a catch-all fallback for third-party/no-name ESP32-C3 boards that have
// no dedicated variant of their own. Confirmed real-world case where this
// is wrong for such a board: espressif/arduino-esp32 GitHub issue #7914
// ("Proper LED_BUILTIN for CORE-ESP32 (ESP32C3) board") - a board using
// this exact generic profile has its LED on GPIO12/13, not GPIO8, so
// LED_BUILTIN pointed nowhere useful for that user. The led_neopixel tag
// below is correct for genuine Espressif DevKitM-1/DevKitC-02 hardware
// (and clones thereof) but may not apply to every board a user has
// flashed with "ESP32C3 Dev Module" - Designer users on unrelated
// hardware should verify against their own board's silkscreen/schematic.
//
// GPIO8's pins_arduino.h "SDA = 8" default Wire pin alias was changed to
// -1 in this board's local pins_arduino.h copy to prevent build_boards.js
// from auto-appending an "i2c_sda" capability onto this NeoPixel-dedicated
// pin (SDA=8 is boilerplate carried unmodified across a dozen+ unrelated
// ESP32-C3 boards in this repo's variants tree, including ones whose LED
// is on a completely different GPIO - it is Espressif's arbitrary default
// Wire pin choice, not a real onboard I2C device wired to GPIO8).
//
// Sources consulted - see boardsDetails/esp32/esp32c3/esp32c3/notes.txt
// for the full list and reasoning trail.
{
  "boardName": "ESP32C3",
  "displayName": "ESP32-C3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "2": "Must be HIGH for normal boot",
    "8": "Must be HIGH or floating on reboot",
    "9": "Must be HIGH for normal boot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "6":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "7":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "8":  { "capabilities": ["digital_output", "pwm_output", "led_neopixel"] },
    "9":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "10": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "20": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
}
