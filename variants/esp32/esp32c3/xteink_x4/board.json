// pfodWeb NOTE: excludes GPIO4/5/6/7/8/10/21 - dedicated onboard e-paper
// display SPI bus + control lines (EPD_RESET/BUSY/DC), shared with the
// onboard microSD card. GPIO12 (SD_CS) is already absent from the
// ESP32-C3 chip default (flash-reserved range). GPIO3 (BUTTON, power
// button) stays available and is now tagged "button" (digital, active
// low, per independent confirmation - see boardsDetails notes.txt).
// INDEPENDENTLY CONFIRMED (2026-07-14) via
// https://learn.adafruit.com/circuitpython-on-the-xteink-x4-ereader/pinouts
// and https://github.com/bigbag/papyrix-reader (open-x4-sdk-derived):
// EPD_DC=4, EPD_RST=5, EPD_BUSY=6, SD_MISO/EPD_MISO=7, EPD_SCK=8,
// EPD_MOSI/SD_MOSI(shared)=10, SD_CS=12, EPD_CS=21, power button=3
// (digital, active low with pullup). GPIO1/GPIO2 are a resistor-ladder
// ADC read for the other 6 buttons (not simple digital buttons, so left
// untagged/analog_input as before). GPIO0 is a battery-voltage divider
// reading (kept, matches the "battery/voltage monitor" keep policy).
// GPIO20 doubles as USB/charge detection (kept, simple digital sensor).
{
  "boardName": "ESP32C3",
  "displayName": "ESP32-C3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "2": "Must be HIGH for normal boot",
    "9": "Must be HIGH for normal boot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "button"] },
    "9":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "20": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
}
