// pfodWeb NOTE: GPIO6 tagged "led_neopixel" - confirmed onboard
// addressable WS2812-style RGB LED (RGB_BUILTIN in vendor pins_arduino.h,
// driven via the core's neopixelWrite()/rgbLedWrite()/FastLED driver);
// PandaByte.in xC3m product page lists "LED: Programmable Single Color
// and RGB LEDs" and the merged espressif/arduino-esp32 PR #12220
// board-bringup test table for this exact board records "Blink RGB
// (FastLED)" PASS. The vendor's boilerplate default-SPI alias that also
// pointed at this same GPIO (MOSI) was removed from pins_arduino.h as an
// unconfirmed, conflicting duplicate - see that file's NOTE comment.
// pfodWeb NOTE: GPIO7 tagged "button" - confirmed onboard user
// programmable switch (BUTTON_BUILTIN in vendor pins_arduino.h);
// PandaByte.in xC3m product page lists "Switches: RST, FLASH, and User
// Programmable buttons" and PR #12220's board-bringup test table for this
// exact board records "Digital Input (Switch)" PASS. GPIO7 carries no
// other alias (TX/RX/SDA/SCL/SS/MISO/SCK) in pins_arduino.h, so no
// collision applies here.
// pfodWeb NOTE: GPIO5 (LED_BUILTIN) left UNTAGGED - out of scope for this
// audit (only RGB_BUILTIN/BUTTON_BUILTIN were flagged), and no source
// found confirms its drive polarity (active-high vs active-low) in any
// case.
{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP32C3" -> designer/boards/ESP32C3/ESP32C3.json -> const ESP32C3Data = {...}
  "boardName": "ESP32C3",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "ESP32-C3 Dev Module",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // Supported values: "avr", "esp32".
  "family": "esp32",

  // Default PWM output range for analogWrite() (LEDC, 8-bit default).
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // DAC output: ESP32-C3 has no hardware DAC.
  "dac": {},

  // ADC: ESP32-C3 has a 12-bit ADC (0–4095) via analogRead().  Default reference
  // is the internal 3.3 V supply.  Attenuation settable via analogSetAttenuation()
  // for 0–3.3 V range; without attenuation input range is ~0–1.1 V.
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },

  // GPIO numbers that are input-only (no internal pull-up driver, no
  // output driver).  Used by the ESP32 parser to drop digital_output and
  // pwm_output capabilities from those pins.  Leave [] on boards where
  // every pin is bidirectional (e.g. all AVR variants).
  // ESP32-C3: every exposed GPIO is bidirectional — no input-only pins.
  "inputOnlyGpios": [],

  // Transports this board can talk pfod over.  Values are the lowercase
  // machine identifiers from pfodCommon.html's protocol radios.  ESP32
  // family supports Serial via UART, BLE via Bluetooth LE, TCP via the
  // WiFi stack, and HTTP via the WiFi stack + a small server library.
  "connections": ["serial", "ble", "tcp", "http"],

  // Boot-time / power-up warnings for specific GPIO numbers.
  // Reference: ESP32-C3 Technical Reference Manual — Strapping Pins.
  "pinNotes": {
    "2": "Must be HIGH for normal boot",
    "8": "Must be HIGH or floating on reboot",
    "9": "Must be HIGH for normal boot"
  },

  // User-accessible GPIO numbers on the ESP32-C3 chip.  GPIOs 12-17
  // (flash) and GPIOs 18-19 (USB) are excluded.  No DAC.
  // Source: Espressif ESP-IDF documentation (docs.espressif.com).
  "chipGpios": {
    "0":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "6":  { "capabilities": ["digital_output", "led_neopixel", "pwm_output"] },
    "7":  { "capabilities": ["digital_input", "button"] },
    "8":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "9":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "10": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "20": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
}
