{
  // pfodWeb NOTE: dedicated-hardware pin-exclusion audit, 2026-07-12.
  // Board: Adafruit QT Py ESP32-C3 WiFi Dev Board (product #5405), a
  // genuine official Adafruit product. pins_arduino.h declares
  // BUTTON=9 and PIN_NEOPIXEL=2 (plus the usual SPI/I2C/UART/analog
  // boilerplate). No board.json override existed before this audit
  // (used the chip-level esp32c3/board.json default). Flagged by the
  // discovery sweep for having BUTTON=9 / PIN_NEOPIXEL=2 declared but
  // never individually reviewed.
  //
  // Sources consulted:
  //  - https://learn.adafruit.com/adafruit-qt-py-esp32-c3-wifi-dev-board/pinouts
  //    Official Adafruit Learn guide pinout page. Confirms: "This button
  //    can be read as GPIO 9 (set it to be an input-with-pullup)" for the
  //    onboard BOOT/user button, and enables ROM bootloader mode when held
  //    during reset. Confirms the addressable RGB NeoPixel LED is on GPIO2
  //    ("PIN_NEOPIXEL" in Arduino, "board.NEOPIXEL" in CircuitPython).
  //    Same page lists this board's I2C (SCL=6/SDA=5), SPI
  //    (SCK=10/MISO=8/MOSI=7), and UART (RX=20/TX=21) pins - none overlap
  //    GPIO9 or GPIO2.
  //  - https://www.adafruit.com/product/5405
  //    Vendor product listing corroborating the board identity (QT Py
  //    ESP32-C3 WiFi Dev Board with STEMMA QT).
  //  - https://forums.adafruit.com/viewtopic.php?t=189325
  //    Community pinout discussion, consistent with the official Learn
  //    guide (GPIO9 boot button, GPIO2 NeoPixel).
  //
  // GPIO9 (BUTTON): CONFIRMED onboard physical BOOT/user button, directly
  // stated by Adafruit's own Learn guide. Standard ESP32-C3 strapping pin
  // (chip-level pinNotes "Must be HIGH for normal boot" retained as-is,
  // not removed - this is expected/documented for this exact pin). Checked
  // against this board's own pins_arduino.h aliases - TX=21, RX=20,
  // SDA=5, SCL=6, SS=6, MOSI=7, MISO=8, SCK=10 - GPIO9 is not aliased as
  // any of those, so no conflicting boilerplate alias to strip. Tagged
  // capabilities ["digital_input","button"] only.
  //
  // GPIO2 (PIN_NEOPIXEL): CONFIRMED onboard status NeoPixel (WS2812-style
  // addressable RGB LED), directly stated by Adafruit's own Learn guide
  // and independently corroborated. This is the physical GPIO driven by
  // the rgbLedWrite()/RGB_BUILTIN mechanism (LED_BUILTIN is a virtual
  // SOC_GPIO_PIN_COUNT-offset sentinel that maps back to this real pin).
  // Checked against the same alias list above - GPIO2 is not SDA/SCL/SS/
  // MOSI/MISO/SCK/TX/RX, so no conflicting boilerplate alias to strip.
  // Tagged capabilities ["digital_output","led_neopixel","pwm_output"],
  // matching this repo's existing led_neopixel precedent (e.g.
  // waveshare_esp32_s3_zero GPIO21, deneyapkart1Av2 GPIO48).
  //
  // No alias-conflict bug found on this board (unlike the sibling board
  // found earlier this session with GPIO9 aliased as SCL) - this board's
  // pins_arduino.h keeps BUTTON/PIN_NEOPIXEL cleanly separate from all
  // I2C/SPI/UART aliases, so no pins_arduino.h edit was needed.
  //
  // See boardsDetails/esp32/esp32c3/adafruit_qtpy_esp32c3/notes.txt for
  // the full research trail.

  "boardName": "ESP32C3",
  "displayName": "ESP32-C3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "2": "Must be HIGH for normal boot",
    "8": "Must be HIGH or floating on reboot",
    "9": "Must be HIGH for normal boot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["digital_output", "led_neopixel", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "6":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "7":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "8":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "9":  { "capabilities": ["digital_input", "button"] },
    "10": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "20": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
}
