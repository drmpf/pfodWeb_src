// pfodWeb NOTE: per-board override — this is the LILYGO T-Watch-S3,
// a fully-integrated smartwatch. Removed from the chip-level default
// chipGpios map: the internal I2C bus (10,11) shared by 4 built-in
// chips; the shared SD+LoRa SPI bus (1,3,4,5) and LoRa control (7,8,
// 9); the display (12,13,18,38,45); touch controller I2C+INT (16,39,
// 40); RTC/PMU/sensor interrupts (14,17,21); PDM mic (44,47); audio
// amp (15,46,48); and the IR blaster (2). Kept: TX/RX (41,42) and
// GPIO0/6/43 (not referenced anywhere in this board's
// pins_arduino.h). Full copy of variants/esp32/esp32s3/board.json
// otherwise.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "6": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "41": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "42": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    }
  }
}
