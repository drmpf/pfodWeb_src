// pfodWeb NOTE: per-board override — this is a Waveshare ESP32-S3
// Touch AMOLED board. Removed from the chip-level default chipGpios
// map: QSPI display (9-14,21), touch/RTC/IMU I2C (47,48, shared).
// (GPIO32-37, the internal PSRAM/Flash SPI, would already be
// excluded chip-wide, but this board's own file declares
// SS/MOSI/MISO/SCK there directly, so they're trusted/kept per
// this project's audit policy.) Full copy of
// variants/esp32/esp32s3/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard BOOT button
// (Waveshare wiki waveshare.com/wiki/ESP32-S3-Touch-AMOLED-2.41: BOOT
// button used to enter download mode, GPIO0 listed as "BOOT0" in the
// interfaces/pinout table; same pattern confirmed for sibling boards
// waveshare_esp32_s3_touch_amoled_143/18/206). No onboard LED
// (single-color or NeoPixel) is documented for this board - not tagged.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
