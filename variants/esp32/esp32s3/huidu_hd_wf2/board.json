        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "17": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "18": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "40": {
      "capabilities": [
        "digital_output",
        "pwm_output",
        "led_high"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
