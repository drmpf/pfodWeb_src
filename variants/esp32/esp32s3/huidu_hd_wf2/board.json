// pfodWeb NOTE: excludes GPIO2-13/21/33-39/41/42 - dedicated onboard
// HUB75 X1/X2 matrix panel data+select lines and BM8563 RTC I2C bus
// (see vendor pins_arduino.h). BUTTON_TEST(17)/LED_RUN(40)/PCB1/PCB2
// open pads(45/46) are kept - genuine button/LED/spare pads.
// pfodWeb NOTE: GPIO17 tagged "button" - confirmed vendor source comment
// "Test key button on PCB, 1=normal, 0=pressed" (WF2_BUTTON_TEST) and
// firmware button.setPressedState(LOW) in mrcodetastic/HD-WF1-WF2-LED-
// MatrixPanel-DMA confirming a real active-low onboard PCB test button.
// pfodWeb NOTE: GPIO40 tagged "led_high" - confirmed vendor source
// comment "Status LED on PCB" (WF2_LED_RUN_PIN) and firmware
// led_pwm_handler.h ledFadeTask() breathing effect using non-inverted
// LEDC PWM duty (0=off, max=brightest) confirming active-high polarity;
// pwm_output retained since GPIO40 already had pwm_output capability.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "1": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "14": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "15": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "16": {
