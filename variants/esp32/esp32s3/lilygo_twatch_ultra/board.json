// pfodWeb NOTE: per-board override — this is the LILYGO T-Watch-Ultra,
// a fully-integrated smartwatch. Removed from the chip-level default
// chipGpios map: the internal I2C bus (2,3) shared by 4 built-in
// chips; the shared SPI bus (21,33,34,35) for LoRa/SD; the QSPI
// display (6,37,38,39,40,41,42,45); touch/PMU/NFC/sensor interrupt
// lines and NFC CS (1,4,5,7,8,12); the PDM mic and MAX98357A amp
// (9,10,11,17,18); GPS PPS (13); and LoRa control (36,47,48,14). Kept:
// TX/RX (43,44) and GPIO0/15/16 (not referenced anywhere in this
// board's pins_arduino.h). Full copy of
// variants/esp32/esp32s3/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed vendor doc (Xinyuan-LilyGO/LilyGoLib
// docs/hardware/lilygo-t-watch-ultra.md: GPIO0 labeled "Custom Button or Enter download Mode"
// in the hardware pinout diagram).
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "15": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "16": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "44": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "46": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    }
  }
}
