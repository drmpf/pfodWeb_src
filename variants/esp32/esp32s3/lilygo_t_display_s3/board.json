// pfodWeb NOTE: per-board override — this is the LILYGO T-Display-S3.
// Removed from the chip-level default chipGpios map: the onboard
// touch controller's reset/init lines (16,21) and the ST7789 8-bit
// parallel TFT's data/control lines (5,6,7,8,9,38,39,40,41,42,45,46,
// 47,48). Kept: SS/MOSI/MISO/SCK (10,11,12,13, a genuine free SPI
// header — does not overlap the TFT/touch pins), general I2C (17,
// 18), buttons (0,14), battery monitor (4), and TX/RX (43,44).
// Full copy of variants/esp32/esp32s3/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed vendor docs (LilyGO
// T-Display-S3 BOOT button, also usable as general user input;
// deepwiki.com/Xinyuan-LilyGO/T-Display-S3 pin mapping + ESPHome device
// page, active-low).
// pfodWeb NOTE: GPIO14 tagged "button" - confirmed vendor docs (LilyGO
// T-Display-S3 dedicated "Key" user button; deepwiki.com pin mapping +
// ESPHome device page, active-low).
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "2": {
