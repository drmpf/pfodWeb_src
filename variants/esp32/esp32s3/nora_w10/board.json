// pfodWeb NOTE: GPIO46/0/47/48 tagged "button" - confirmed onboard user
// buttons SW1/SW2/SW3/SW4 (u-blox EVK-NORA-W10 User guide, UBX-22002764-R03,
// section 3.4 "Buttons" and Table 1 "User button components": "the
// evaluation board also supports four user buttons that are active-low
// and connect to ground when pressed... Button 1 SW1 GPIO46... Button 2
// SW2 GPIO0 (BOOTn, multifunctional - usable for other user functions in
// software after power-up)... Button 3 SW3 GPIO47... Button 4 SW4
// GPIO48"). The separate RESET button (SW5) drives the module RESETn pin
// directly, not a GPIO, and is therefore not taggable.
// pfodWeb NOTE: GPIO5/2/8 tagged "led_r_low"/"led_g_low"/"led_b_low" -
// confirmed onboard discrete RGB LED (RGB1), active-low (u-blox
// EVK-NORA-W10 User guide, UBX-22002764-R03, section 3.5 "LEDs": "System
// status (RGB1): Powered by +3V3 and turned on by pulling the associated
// GPIO low"; Table 2 "RGB LED associated signals": Red=GPIO5, Green=GPIO2,
// Blue=GPIO8, matching this board's pins_arduino.h LED_RED/LED_GREEN/
// LED_BLUE). pwm_output kept on these three pins because they already
// carry it in the chip-level default. Full copy of
// variants/esp32/esp32s3/board.json otherwise - no other pin exclusions
// needed for this board (TX=43/RX=44 do not conflict with any tagged pin).
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
