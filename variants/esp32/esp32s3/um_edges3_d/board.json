// pfodWeb NOTE: board-level override of the esp32s3 chip default, kept
// so this variant is self-contained. No chipGpios entries were changed
// versus the chip default (GPIO34-37 were already absent, matching the
// chip-wide octal flash/PSRAM exclusion) — this file exists because the
// vendor pins_arduino.h declared SS/MOSI/MISO/SDO/SDI/SCK aliases on
// those same excluded GPIOs, which would otherwise leak them back in
// as user-selectable pins via the alias-driven inclusion in
// build_boards.js. Those alias declarations were deleted from this
// board's pins_arduino.h; this board.json documents that the omission
// of 34-37 from chipGpios is intentional for this variant too. No
// button, standalone LED, NeoPixel, or dedicated battery-sense GPIO is
// declared in the vendor header for this board (EdgeS3[D] has no RGB
// LED and reads battery state via an I2C fuel gauge, not a GPIO), so
// no opportunistic capability tagging applies here.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH for normal boot",
    "3":  "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
