// pfodWeb NOTE: GPIO48 tagged "led_neopixel" - this board's own
// pins_arduino.h declares `#define PIN_RGB_LED 48` and wires
// LED_BUILTIN/RGB_BUILTIN/RGB_BRIGHTNESS to GPIO48 (the modern
// Arduino-ESP32 core's rgbLedWrite() addressable-LED API, i.e. a WS2812
// NeoPixel, not a plain on/off LED). This is the identical macro pattern
// already confirmed and tagged the same way on the chip-level generic
// "esp32s3" (ESP32-S3-DevKitC-1) board in this repo
// (variants/esp32/esp32s3/esp32s3/board.json) and on other ESP32-S3
// boards using GPIO48 for an onboard NeoPixel (e.g. waveshare_esp32_s3_zero
// on GPIO21, same PIN_RGB_LED/RGB_BUILTIN idiom). Third-party board
// database espboards.dev/esp32/wifiduino32s3/ independently lists an
// onboard "RGB LED" for this exact board and its pin mapping table shows
// GPIO48 as LED_BUILTIN, corroborating the vendor source file.
//
// GPIO0: checked for a BOOT/user button alias (this board's sibling,
// classic-ESP32 "wifiduino32", declares a vendor `KEY_BUILTIN = 0` alias
// confirming its button). This S3 variant's pins_arduino.h has NO such
// alias (no KEY_BUILTIN/BOOT/RESET declaration of any kind - verified
// against the upstream espressif/arduino-esp32 vendor source file, which
// matches this repo's copy exactly). espboards.dev's page for this board
// also does not mention a BOOT or RESET button anywhere. Per audit policy,
// tagging a button requires an explicit vendor alias or explicit vendor
// documentation, not just the generic fact that GPIO0 is an ESP32-S3
// strapping pin - so GPIO0 is left untagged (NO CHANGE) rather than
// guessed.
//
// Alias-collision check (build_boards.js auto-appends spi_ss/spi_mosi/
// spi_miso/spi_sck/i2c_sda/i2c_scl caps for any GPIO matching this board's
// SS/MOSI/MISO/SCK/SDA/SCL/TX/RX aliases, regardless of chipGpios):
// SDA=4, SCL=5, SS=10, MOSI=11, MISO=13, SCK=12, TX=43, RX=44 - none of
// these equal 48, so no collision for the retagged NeoPixel pin. (D5=48
// is a plain "D"-header alias, not one of the bus-alias names the parser
// auto-appends capabilities for, so it is not a collision source.)
//
// No dedicated-hardware pin exclusions found: all header pins (A0-A5,
// D0-D13) map to GPIOs already within the chip-level default's included
// set (0-18, 21, 38-48); none fall in the excluded flash/PSRAM (26-37)
// or USB (19-20) ranges, so no EXCLUDE changes or pins_arduino.h alias
// deletions were needed.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH for normal boot",
    "3":  "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
