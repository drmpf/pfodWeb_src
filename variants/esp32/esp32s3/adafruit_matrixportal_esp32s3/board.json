// pfodWeb NOTE: GPIO4 tagged "led_neopixel" - confirmed onboard status
// NeoPixel (PIN_NEOPIXEL/NEOPIXEL_PIN; Adafruit's own MatrixPortal S3
// "Pinouts" guide: "The RGB status NeoPixel labeled 'NeoPixel'... is
// connected to board.NEOPIXEL or Arduino 4"). GPIO6/GPIO7 tagged
// "button" - confirmed onboard UP/DOWN tactile buttons
// (PIN_BUTTON_UP/PIN_BUTTON_DOWN; same guide: "UP button: Connected to
// board.BUTTON_UP and Arduino pin 6", "DOWN button: Connected to
// board.BUTTON_DOWN and Arduino pin 7"; note: "The up and down buttons
// do not have any pull-up resistors connected to them and pressing
// either of them pulls the input low.").
//
// GPIO5 (A5 / PIN_LIGHTSENSOR in this board's pins_arduino.h, commented
// "// Light") is deliberately NOT tagged as a sensor and NOT restricted:
// Adafruit's own MatrixPortal S3 "Downloads" page states "the ALS-PT19
// light sense phototransistor is NOT part of the final design for this
// board, even though it appears on the schematic." pins_arduino.h is
// shared boilerplate from a sibling Adafruit ESP32-S3 board template
// that does populate this sensor; on the MatrixPortal S3 it is
// unpopulated. Left as a plain general-purpose analog-capable GPIO
// (chip default unchanged) with a pinNotes entry documenting this so a
// user doesn't expect real light readings from it.
//
// Alias-collision check (build_boards.js unconditionally appends
// i2c_sda/i2c_scl/spi_ss/spi_mosi/spi_miso/spi_sck/serial_tx/serial_rx
// capabilities to any GPIO matching those aliases, regardless of
// chipGpios content): this board's pins_arduino.h has SDA=16, SCL=17,
// SS=MOSI=MISO=SCK=-1 (unused/not wired), TX=18, RX=8. None of these
// equal GPIO4, GPIO5, GPIO6, or GPIO7 - no collision found, no alias
// lines needed deletion.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH for normal boot",
    "3":  "Must be LOW or floating on reboot",
    "5":  "PIN_LIGHTSENSOR/A5 in vendor pins_arduino.h, but Adafruit's own docs confirm the ALS-PT19 light sensor shown on the schematic is not populated on this board - general-purpose analog pin only, no real light sensor attached",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["digital_output", "pwm_output", "led_neopixel"] },
    "5":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "6":  { "capabilities": ["digital_input", "button"] },
    "7":  { "capabilities": ["digital_input", "button"] },
    "8":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "9":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "10": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "16": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "17": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "38": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "39": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "40": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "41": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "42": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "43": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "44": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "45": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "46": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "47": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "48": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
}
