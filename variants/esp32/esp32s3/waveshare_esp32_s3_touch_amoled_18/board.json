// pfodWeb NOTE: per-board override — this is the Waveshare ESP32-S3
// Touch AMOLED 1.8 board. Removed from the chip-level default
// chipGpios map: the onboard SH8601 display's QSPI bus (4,5,6,7,11,
// 12) and IMU I2C (14,15), plus the FT3168 touch controller's
// interrupt (21). Full copy of variants/esp32/esp32s3/board.json
// otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard BOOT button
// (active-low) per waveshare.com/wiki/ESP32-S3-Touch-AMOLED-1.8. The
// board's other physical button, PWR, is read via EXIO4 on the
// onboard TCA9554 I2C IO expander, not a direct ESP32-S3 GPIO, so it
// is not represented in chipGpios and was left untagged. No onboard
// LED was confirmed for this board - see notes.txt for details.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
