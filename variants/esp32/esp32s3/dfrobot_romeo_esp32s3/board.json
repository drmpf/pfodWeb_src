// pfodWeb NOTE: per-board override — this is the DFRobot Romeo
// ESP32-S3, combining an onboard motor driver, camera (DVP), and
// display FPC connector (GDI). Removed from the chip-level default
// chipGpios map:
//  15,16,17,18  the GDI display's SPI bus (SCLK/MOSI/MISO/CS)
//  21,3,38,0,7,12,13,14  GDI backlight/DC/reset/SD-CS/flash-CS/touch-
//               CS/interrupt/busy lines
//  4,5,6,7,8,46,48,45,39,40,41,42  the onboard DVP camera's data/
//               clock/sync lines
//  9,10,47,11   the 4 onboard motor drivers' EN/PH lines
// Kept: SDA/SCL (1,2, shared general-purpose I2C also used by the
// camera's SCCB interface) and TX/RX (43,44). Full copy of
// variants/esp32/esp32s3/board.json otherwise.
// Independently re-verified 2026-07-14 against the official DFRobot wiki
// (https://wiki.dfrobot.com/SKU_DFR0994_Romeo_ESP32_S3_Development_Board),
// which publishes the exact GPIO allocation table for this board: GDI SPI
// clock/MOSI/MISO on 17/15/16, GDI CS 18, DC 3, reset 38, SD-select 0,
// font-library-select 7, touch-select 12, interrupt 13, tearproof/busy 14,
// backlight 21; DVP camera D2-D4 on 39-41, D5-D7 on 4-8, D8-D9 on 46-48,
// VSYNC 6, HREF 42, PCLK 5, XCLK 45; motor 1 EN/PH 12/13, motor 2 EN/PH
// 14/21, motor 3 EN/PH 9/10, motor 4 EN/PH 47/11; I2C SDA/SCL 1/2. Every
// pin in the wiki's table matches this board.json's exclusions/kept-pins
// exactly - no corrections needed.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "1": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "2": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "44": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    }
  }
}
