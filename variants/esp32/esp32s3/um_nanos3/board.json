// pfodWeb NOTE: excludes GPIO42 - onboard NeoPixel power-gate
// (RGB_PWR, see vendor pins_arduino.h). GPIO41 tagged "led_neopixel" -
// confirmed onboard NeoPixel data pin (RGB_DATA=41 in pins_arduino.h,
// matching the upstream espressif/arduino-esp32 um_nanos3 variant
// byte-for-byte; corroborated by the Unexpected Maker/esp32s3.com
// NanoS3 product pages describing a low-power RGB LED powered via an
// IO pin that must be set HIGH before use, i.e. the separate RGB_PWR
// gate on GPIO42), matching the um_tinys3/um_tinyc6/um_omgs3
// precedent. No confirmable onboard user button found - WebSearch of
// the NanoS3 product page explicitly states the board ships without a
// BOOT or RESET button populated ("... other than a USB connector and
// buttons for IO0 and RESET ... need to be provided by you"), so no
// button capability is tagged. See boardsDetails notes.txt for full
// sourcing and the separate SS/MOSI/MISO/SCK GPIO34-37 alias-leak fix
// applied in this board's pins_arduino.h (same bug class as
// um_edges3_d).
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH for normal boot",
