// pfodWeb NOTE: per-board override — this is the Adafruit Qualia
// ESP32-S3 RGB666, a fixed RGB parallel TFT + capacitive touch board.
// Removed from the chip-level default chipGpios map: GPIO0-4/7 (TFT
// SCK/CS/RESET/touch IRQ/backlight/MOSI) and GPIO9-14/21/38-42/45-48
// (the full RGB666 R/G/B/PCLK/DE/HSYNC/VSYNC data bus). Kept:
// GPIO5/6 (SCK/MISO — general-purpose SPI lines, not part of the
// dedicated TFT bus above), GPIO15 (SS/CS), SDA/SCL (8,18), and TX/RX
// (16,17). Full copy of variants/esp32/esp32s3/board.json otherwise.
//
// pfodWeb NOTE (correction, 2026-07-14): this board's 3 physical
// buttons (Reset, UP, DN) are NOT wired to any ESP32-S3 GPIO directly —
// confirmed via learn.adafruit.com/adafruit-qualia-esp32-s3-for-rgb666-displays/pinouts:
// UP and DN are both "connected to the IO expander" (a PCA9554A on the
// shared I2C/STEMMA bus, GPIO8/18 above), and Reset is a hardware
// EN/RST line, not a GPIO. An earlier version of this comment wrongly
// described GPIO5/6 as "onboard up/down buttons" — that was a
// copy-paste error (GPIO5/6 are genuinely just SCK/MISO, confirmed by
// the same source: "SCK...Arduino 5", "MISO...Arduino 6"). No chipGpios
// data changed — GPIO5/6 were already correctly left untagged as plain
// SPI pins, not buttons; this note only corrects the misleading prose.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "5": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "6": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "8": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "15": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "16": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "17": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "18": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "44": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    }
  }
}
