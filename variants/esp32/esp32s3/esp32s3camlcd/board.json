// pfodWeb NOTE: per-board override — this is a fixed camera+parallel-
// TFT board. Removed from the chip-level default chipGpios map:
//  10,11,12,13,3,14,47,21,38,39,40,41,42  onboard DVP camera data/
//               clock/sync lines (also the SS/MOSI/MISO/SCK bus above)
//  2,4,5,6,7,8,10,15,16,45  onboard 8-bit parallel TFT data/control
//  9,19,20      onboard SDMMC microSD card
//  0,1          onboard microphone clock/data
// Kept: SDA/SCL (17,18, shared general I2C also used by the camera's
// SCCB interface) and TX/RX (43,44). Full copy of
// variants/esp32/esp32s3/board.json otherwise.
// Independently re-verified 2026-07-14 against the official Espressif
// arduino-esp32 upstream pins_arduino.h
// (https://github.com/espressif/arduino-esp32/blob/master/variants/esp32s3camlcd/pins_arduino.h,
// boards.txt display name "ESP32S3 CAM LCD", added in the bulk ESP32-S3
// support PR https://github.com/espressif/arduino-esp32/pull/6341,
// March 2022) - every excluded pin here matches that file's own #define
// roles exactly: camera Y2-Y9/VSYNC/HREF/PCLK/XCLK (13,47,14,3,12,42,41,
// 39,21,38,11,40), shared camera/TFT SPI-style bus (10,11,12,13), 8-bit
// parallel TFT WR/DC/D0-D7 (4,2,45,16,15,10,8,7,6,5), SDMMC CMD/CLK/DATA
// (20,9,19 - 19/20 already excluded chip-wide as native USB pins), and
// microphone clock/data (0,1). No separate third-party commercial vendor
// product page, schematic, or datasheet could be found for this specific
// board - it appears to be Espressif's own generic internal reference
// variant for camera+parallel-TFT+SD+mic hardware (bulk-added alongside
// dozens of other ESP32-S3 variants, no distinct vendor branding in
// boards.txt or the arduino-esp32 repo), so the official arduino-esp32
// pins_arduino.h itself is treated as the authoritative source here. No
// button/LED capability tags apply - none of these pins are buttons or
// LEDs.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "17": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "18": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "44": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "46": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "48": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    }
  }
}
