// pfodWeb NOTE: excludes GPIO3-9/11/13/15 (keyboard matrix), GPIO12/14/
// 39/40 (microSD SPI bus), GPIO33-38 (LCD, doc-sourced), GPIO43/46 (mic,
// doc-sourced) - confirmed via M5Unified library source + official
// M5Stack docs.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed physical G0 button via
// docs.m5stack.com/en/arduino/m5cardputer/button (only G0 supports the
// button API) plus M5Unified library source src/M5Unified.cpp (pinMode
// GPIO_NUM_0 input for board_M5Cardputer; btn_rawstate_bits reads
// !gpio_in(GPIO_NUM_0)) - not a keyboard matrix key.
// pfodWeb NOTE: GPIO21 tagged "led_neopixel" - confirmed via official
// M5Unified library source src/M5Unified.cpp, _pin_table_other0
// "//RGBLED" table entry { board_M5Cardputer, GPIO_NUM_21 }, wired
// through LedBus_RMT/LED_Strip_Class (RMT-driven addressable WS2812
// RGB LED, single data pin).
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
