// pfodWeb NOTE: excludes GPIO5/6/7 (dedicated onboard MAX98357A I2S
// amplifier bus) and GPIO10/11/12/13 (dedicated onboard microSD SPI bus).
// SPI2 (GPIO38/39/40/41, "for public usage" per vendor comment) stays
// available.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard "GPIO0 Button"
// (shorts GPIO0 to GND via switch BOOT_S1) per vendor schematic
// github.com/yellobyte/YB-ESP32-S3-AMP doc/retired_board_versions_V2_&_V3/
// YB-ESP32-S3-AMP_Rev2_schematic_1-2.jpg (title block confirms "REV: 2.1",
// matching this v2 variant). GPIO47 tagged "led_high" - confirmed onboard
// "Status LED (GPIO47)" (GPIO47 -> LED -> R7 1k5 -> GND, anode toward
// GPIO47 = active-high) per same schematic. Note GPIO47 is also the
// PIN_DAC_MUTE solder-bridge pin (see pins_arduino.h) - vendor README
// confirms this is the same physical LED pin doing double duty (mute
// forces GPIO47 HIGH), not a separate function; led_high tag stands.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH for normal boot",
    "3":  "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
