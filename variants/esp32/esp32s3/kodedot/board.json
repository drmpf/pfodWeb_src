// pfodWeb NOTE: per-board override — this is the KodeDot ESP32-S3R8.
// Removed from the chip-level default chipGpios map:
//  5,6,7      the onboard microSD card's SDMMC bus (CMD/CLK/D0)
//  47,48      the internal sensor I2C bus ("not on header" per
//             vendor comment, unlike the external I2C at 36/37)
//  8,9,10,15,16,17  the onboard QSPI LCD's bus (CS/RST/IO3/IO1/IO2/
//             SCK) — confirmed NOT present in the vendor's own 2x10
//             header pinout table, unlike GPIO14 (also an LCD line,
//             LCD_IO1, but IS listed there as header PIN10 — kept)
// Full copy of variants/esp32/esp32s3/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed https://docs.kode.diy/en/kode-dot/buttons.md (Up/top button wired directly to ESP32-S3 GPIO0, active LOW, controls BOOT state).
// pfodWeb NOTE: GPIO4 tagged "led_neopixel" - confirmed https://docs.kode.diy/en/kode-dot/addresable-led.md (WS2812B addressable RGB LED on GPIO4, single-wire protocol).
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
