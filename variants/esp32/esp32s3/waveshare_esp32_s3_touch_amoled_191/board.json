// pfodWeb NOTE: per-board override — this is a Waveshare ESP32-S3
// Touch AMOLED board. Removed from the chip-level default chipGpios
// map: QSPI display (5,6,7,18,17,48), touch I2C (39,40, shared), onboard SD card (8,9,42,47).
// (GPIO32-37, the internal PSRAM/Flash SPI, would already be
// excluded chip-wide, but this board's own file declares
// SS/MOSI/MISO/SCK there directly, so they're trusted/kept per
// this project's audit policy.) Full copy of
// variants/esp32/esp32s3/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard BOOT button
// via vendor pinout diagram (docs.waveshare.com/ESP32-S3-AMOLED-1.91,
// image labels GP0 pin 4 as "Boot" / physical button labeled "Boot button").
// No onboard user-controllable LED found; the board's only LED is a
// hardware-driven battery charge indicator (not GPIO-connected), so no
// LED tag was applied - see boardsDetails notes.txt for details.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
