// pfodWeb NOTE: GPIO0 tagged "button" - confirmed via Waveshare's own
// ESP32-S3-Touch-LCD-4 schematic (files.waveshare.com/wiki/
// ESP32-S3-Touch-LCD-4/ESP32-S3-Touch-LCD-4_V3.0.pdf): pushbutton "KEY1"
// wired to net IO0/GPIO0 (standard BOOT/download pushbutton circuit,
// active low). Corroborated by the vendor wiki FAQ (waveshare.com/wiki/
// ESP32-S3-Touch-LCD-4), which instructs users to "press and hold BOOT
// and then power on to enter the strong download mode". No other
// onboard user button was found. The board's other button, "BAT_PWR"
// (also called PWR button in the wiki), is wired into the SW6106
// battery power-management IC's SYS_EN control line, not to any ESP32
// GPIO, so it cannot be tagged. A red 0602 SMD LED was found on the
// schematic (net between GND and 3V3 via resistor R58, 10K) - this is
// a hardwired power-indicator LED with no GPIO connection at all (not
// a TX/RX conflict - simply not wired to any GPIO), so it is left
// untagged; see boardsDetails notes.txt for full detail.
// Full copy of variants/esp32/esp32s3/board.json otherwise, with no
// pin-exclusions (this board's pins_arduino.h documents no dedicated
// display/touch GPIOs with sufficient confidence - see its own
// pfodWeb NOTE comments).
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH for normal boot",
    "3":  "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
