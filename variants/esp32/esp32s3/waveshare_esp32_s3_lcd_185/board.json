// pfodWeb NOTE: GPIO0 tagged "button" - confirmed via Waveshare's own
// ESP32-S3-LCD-1.85 schematic (files.waveshare.com/wiki/ESP32-S3-LCD-1.85/
// ESP32-S3-LCD-1.85.pdf): chip pinout block shows net "IO0" wired to
// U5 (ESP32-S3-R8) pin marked "GPIO0", and a separate button component
// (schematic ref "Key2") sits on that same "IO0" net with a 10K pull-up
// resistor (R28) and debounce capacitor (C28) to 3V3/GND - the standard
// BOOT/download pushbutton circuit (active low). This matches the wiki's
// component list ("23. BOOT button") and its usage instructions ("press
// and hold the boot button, then connect to the computer"). The
// wiki also documents the vendor demo firmware calling
// `pinMode(BOOT_KEY_PIN, INPUT)` and polling it as a regular button in
// software (TouchTask()), confirming it is usable as a normal digital
// input post-boot, not merely a strapping pin. The adjacent physical
// "RESET button" (schematic ref "Key3") is wired to net "RESET", which
// the same chip pinout block ties to the ESP32-S3's CHIP_PU/EN pin (not
// a GPIO) - left untagged, see boardsDetails notes.txt.
// No onboard user-controllable LED/NeoPixel found: the wiki lists only
// "17. Power indicator" and "20. Charge indicator" LEDs; the charge
// indicator is wired to the battery-charger IC's STAT pin (schematic
// ref "LED1"/U9 pin "STAT") and the power indicator ("LED2") could not
// be traced to any GPIO net in the schematic - both read as standard
// hardwired power/charge status LEDs, not GPIO-driven. See boardsDetails
// notes.txt for full detail.
// Full copy of variants/esp32/esp32s3/board.json otherwise (no
// pin-exclusions added/removed - out of scope for this task).
{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP32S3" -> designer/boards/ESP32S3/ESP32S3.json -> const ESP32S3Data = {...}
  "boardName": "ESP32S3",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "ESP32-S3 Dev Module",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // Supported values: "avr", "esp32".
  "family": "esp32",

  // Default PWM output range for analogWrite() (LEDC, 8-bit default).
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // DAC output: ESP32-S3 has no hardware DAC.
  "dac": {},

  // ADC: ESP32-S3 has a 12-bit ADC (0–4095) via analogRead().  Default reference
  // is the internal 3.3 V supply.  Attenuation settable via analogSetAttenuation()
  // for 0–3.3 V range; without attenuation input range is ~0–1.1 V.
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },

  // GPIO numbers that are input-only (no internal pull-up driver, no
  // output driver).  Used by the ESP32 parser to drop digital_output and
  // pwm_output capabilities from those pins.  Leave [] on boards where
  // every pin is bidirectional (e.g. all AVR variants).
  // ESP32S3: every exposed GPIO is bidirectional — no input-only pins.
  "inputOnlyGpios": [],

  // Transports this board can talk pfod over.  Values are the lowercase
  // machine identifiers from pfodCommon.html's protocol radios.  ESP32
  // family supports Serial via UART, BLE via Bluetooth LE, TCP via the
  // WiFi stack, and HTTP via the WiFi stack + a small server library.
  "connections": ["serial", "ble", "tcp", "http"],

  // Boot-time / power-up warnings for specific GPIO numbers.
  // Reference: ESP32-S3 Technical Reference Manual — Strapping Pins.
  "pinNotes": {
    "0":  "Must be HIGH for normal boot",
    "3":  "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },

  // User-accessible GPIO numbers on the ESP32-S3 chip.  GPIOs 26-32 (flash),
  // 33-37 (octal flash/PSRAM), and 19-20 (USB) are excluded.  GPIOs 22-25
  // do not exist in this chip's silicon.  No DAC on this chip.
  // Source: Espressif ESP-IDF documentation (docs.espressif.com).
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "6":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "7":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "8":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "9":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "10": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "16": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "17": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "38": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "39": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "40": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "41": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "42": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "43": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "44": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "45": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "46": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "47": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "48": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
}
