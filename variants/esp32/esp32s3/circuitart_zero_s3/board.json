// pfodWeb NOTE: per-board override — this is the CircuitART Zero-S3,
// combining an onboard TFT+microSD (shared SPI bus) and camera.
// Removed from the chip-level default chipGpios map:
//  5,39,40   TFT DC/CS/RST
//  35,36,37,42  shared TFT+SD SPI bus (MOSI/SCK/MISO/SD_CS)
//  41        second UART (RX2)
//  6,7,8,9,10,11,13,14,15,16,21,38,48  onboard DVP camera data/clock/
//            sync lines and power line
// Kept: GPIO0 (KEY_BUILTIN), SDA/SCL (33,34, shared general I2C also
// used by the camera's SCCB interface), DAC1/DAC2 (17,18), and TX/RX
// (43,44). Full copy of variants/esp32/esp32s3/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard DFU/BOOT
// pushbutton (separate from RST button on CHIP_EN) per official vendor
// schematic github.com/CircuitART/ESP32S3zero HRW/Schematic_ESP2S3-ZERO.pdf,
// "BTN" block (R22 10k pull-up to GPIO0, DFU switch to GND).
// pfodWeb NOTE: GPIO47 tagged "led_neopixel" - confirmed onboard
// addressable RGB LED (PIN_RGB_LED/RGB_BUILTIN, driven via rgbLedWrite())
// per same schematic's "NeoPixel" block (4x SK6805-EC15, WS2812-compatible,
// chained). GPIO46 "User LED" (LED2, 0402) existence also confirmed in the
// schematic but its active-high/low polarity could not be reliably read
// from the schematic text, so it was left untagged.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "2": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "3": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "4": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "12": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "17": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "18": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "44": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "45": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "46": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "47": {
      "capabilities": [
        "digital_output",
        "pwm_output",
        "led_neopixel"
      ]
    }
  }
}
