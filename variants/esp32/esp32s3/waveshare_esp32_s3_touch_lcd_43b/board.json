// pfodWeb NOTE: per-board override — this is a Waveshare ESP32-S3
// Touch LCD board (ST7262 RGB parallel display). Removed from the
// chip-level default chipGpios map:
//  0,1,2,3,5,7,10,14,17,18,21,38,39,40,41,42,45,46,47,48  the onboard
//                 ST7262 LCD's RGB/VSYNC/HSYNC/PCLK/DE data lines
//  4,8,9          the onboard GT911 touch controller (+ CH422G I2C
//                 expander sharing 8/9)
//  11,10          the SDA/SCL I2C bus, shared with the onboard IMU
//                 (10 doubles as LCD B7 above)
//  15,16          RS485 or CAN transceiver, depending on model
// Kept: GPIO6/12/13 (not referenced anywhere in this board's
// pins_arduino.h) and GPIO33-37 (this board's own file declares
// these as SS/MOSI/MISO/SCK — genuinely free despite the chip's
// usual flash/PSRAM range) and TX/RX (43,44).
// Full copy of variants/esp32/esp32s3/board.json otherwise.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "6": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "12": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "13": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "44": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    }
  }
}
