// pfodWeb NOTE: per-board override — this is the Deneyap Kart 1A v2,
// combining an onboard camera and microSD card. Removed from the
// chip-level default chipGpios map:
//  1,2,4,5,6,7,15,16,17,38,39,40,41,42  onboard camera data/clock/
//               sync lines (also the SS/MOSI/MISO/SCK bus above)
//  11,12,13,14  onboard microSD card's SPI bus
// Kept: GPIO0 (GPKEY button), GPIO3/8/9/10/18 (not otherwise
// dedicated), SDA/SCL (47,21), and TX/RX (43,44). Full copy of
// variants/esp32/esp32s3/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard "General
// Purpose Button (Pin: D15)" per deneyapkart.org/en/docs/deneyap-kart-1a-v2.
// GPIO48 tagged "led_neopixel" - confirmed onboard "Addressable RGB LED
// (Pin: D9)" (single data-pin WS2812-style), same source.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "3": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "8": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "9": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "10": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "18": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "21": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "44": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "45": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "46": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "47": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "48": {
      "capabilities": [
        "digital_output",
        "led_neopixel",
        "pwm_output"
      ]
    }
  }
}
