// pfodWeb NOTE: per-board override — this is the Waveshare ESP32-S3
// Touch AMOLED 2.06 board. Removed from the chip-level default
// chipGpios map:
//  1,2,3,17       onboard SDMMC microSD card (CLK/CMD/D0/CS)
//  4,5,6,7,8,11,12,13,21  onboard AMOLED display (QSPI D0-D3/SCK/CS/
//                 RESET/TE) and its power-enable line
//  9,14,15,38,39  onboard touch controller + PCF85063 RTC + QMI8658
//                 IMU, all sharing the same I2C bus (SDA/SCL 15/14)
// (GPIO32-37, the internal PSRAM/Flash SPI, are already excluded
// chip-wide, so BAT_ADC=33/SS=32/etc never leak.)
// Kept: GPIO0/10/16/18/40-48 (not referenced anywhere else in this
// board's pins_arduino.h) and TX/RX (43,44). Full copy of
// variants/esp32/esp32s3/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard BOOT button
// (Waveshare wiki waveshare.com/wiki/ESP32-S3-Touch-AMOLED-2.06: "GPIO0
// can detect the high and low level of the button ... low level is
// pressed, which can recognize click, double-click, multi-click, and
// long-press actions" during normal operation, not just flashing mode).
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "10": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "16": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "18": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "40": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "41": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "42": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "44": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "45": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "46": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "47": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "48": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    }
  }
}
