// pfodWeb NOTE: per-board override — this is the WT32-SC01 PLUS
// (PANLEE SC01PLUS), a fixed touchscreen+speaker+SD board. Removed
// from the chip-level default chipGpios map:
//  4,45,47,48,9,46,3,8,18,17,16,15  parallel LCD RESET/BL/RS(WR)/TE/
//               DB0-7 (RS also multiplexed with touch RESET)
//  35,36,37     onboard I2S speaker (LRCK/BCLK/DOUT)
//  7,6,5        touch digitizer INT/SDA/SCL
//  41,40,38,39  onboard microSD card SPI bus
// Kept: GPIO0 (BOOT_0, explicitly labeled "GENERAL I/O" by the
// vendor, despite doubling as LCD_RS), IO1-6 (10,11,12,13,14,21,
// also explicitly "GENERAL I/O"), and TX/RX/RTS (42,1,2, the
// board's primary RS485 interface). Full copy of
// variants/esp32/esp32s3/board.json otherwise.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "1": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "2": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "10": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "11": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "12": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "13": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "14": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "21": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "42": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "44": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    }
  }
}
