// pfodWeb NOTE: per-board override — this is the LILYGO T-LoRa-Pager,
// a fully-integrated LoRa messenger device. Removed from the chip-
// level default chipGpios map: the internal I2C bus (2,3) shared by 5
// built-in chips; the shared SPI bus (21,33,34,35) for LoRa/SD/NFC;
// the keyboard interrupt/backlight (6,46); rotary encoder (7,40,41);
// RTC/NFC/sensor interrupt lines and NFC CS (1,5,8,39); the ES8311
// audio codec (10,11,17,18); GPS (4,12,13); LoRa control (36,47,48,14
// — note 14/36 not previously chip-level anyway); and the display
// control lines (37,38,42). Kept: TX/RX (43,44) and GPIO0/9/15/16
// (not referenced anywhere in this board's pins_arduino.h). Full copy
// of variants/esp32/esp32s3/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed via LilyGoLib
// docs/hardware/lilygo-t-lora-pager.md and wiki.lilygo.cc T-Lora Pager
// page: GPIO0 is the BOOT button, documented as usable as a custom
// button (or to enter download mode). No onboard single-color/RGB/
// NeoPixel LED is documented for this board; GPIO42 is the display
// backlight (already excluded above), not a general-purpose LED.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {},
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "3": "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "9": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "15": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "16": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "43": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "44": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    }
  }
}
