// pfodWeb NOTE (correction, 2026-07-14): a previous audit pass excluded
// GPIO2/3/4/5/8/9/10/11/12/13/14 here, treating GPIO4/5 as fully dedicated
// onboard IMU/touch-interrupt pins. Independent research against
// Waveshare's own wiki (waveshare.com/wiki/ESP32-S3-Touch-LCD-1.28, "Pin
// connection" table + "LCD interface" section text) found GPIO4 and GPIO5
// are actually SHARED, not exclusively dedicated: the wiki's own pin table
// lists GPIO4 as "INT1 / MOSFET1_CS" and GPIO5 as "TP_INT / MOSFET2_CS",
// and the page explicitly states "two MOS tube control switch contacts are
// also drawn out around the battery holder, which are connected to GPIO4
// and GPIO5 respectively, and can be used to solder small current devices
// such as vibration motors" - i.e. Waveshare itself documents these as
// user-drivable outputs broken out on the SH1.0 header, not read-only
// internal-only interrupt lines. Corrected: GPIO4/GPIO5 restored to plain
// chip-level default capabilities (matches the established "shared, not
// dedicated" precedent used elsewhere in this repo, e.g.
// ws_esp32_s3_matrix's GPIO11/12 shared-I2C case).
// Confirmed unchanged: GPIO2 (LCD_BL backlight - dedicated, no header
// breakout mentioned), GPIO3 (IMU INT2 only - dedicated, no header
// breakout mentioned), GPIO8/9/10/11/12/13/14 (LCD_DC/CS/CLK/MOSI/MISO,
// TP_RST, LCD_RST - all dedicated LCD/touch SPI bus, per the same wiki pin
// table) remain excluded - this board is a self-contained round touch LCD
// module whose GPIO budget is otherwise consumed by the onboard LCD
// (backlight/DC/RST), touch controller (INT/RST), and IMU (INT2), plus the
// SPI bus driving the LCD/touch. GPIO1 (A0, battery divider - wiki confirms
// a real 200K/100K onboard divider), GPIO6/7 (general I2C, wiki-confirmed
// shared with onboard IMU/touch, not exclusive), GPIO43/44 (UART) stay
// available.
{
  "boardName": "ESP32S3",
  "displayName": "ESP32-S3 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH for normal boot",
    "3":  "Must be LOW or floating on reboot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"], "note": "IMU_INT1 internally, also broken out on the SH1.0 external header as MOSFET1_CS for driving a small external load (e.g. vibration motor) - shared, not exclusively dedicated onboard hardware (per Waveshare's own wiki)." },
    "5":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"], "note": "TP_INT internally, also broken out on the SH1.0 external header as MOSFET2_CS for driving a small external load (e.g. vibration motor) - shared, not exclusively dedicated onboard hardware (per Waveshare's own wiki)." },
    "6":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "7":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "16": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "17": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "38": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "39": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "40": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "41": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "42": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "43": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "44": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "45": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "46": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "47": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "48": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
