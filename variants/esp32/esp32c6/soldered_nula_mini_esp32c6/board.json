// pfodWeb NOTE: dedicated-hardware pin-exclusion audit, 2026-07-12.
// Board: Soldered Electronics "NULA Mini ESP32-C6" (soldered.com), an
// ultra-compact WiFi6/BLE5.3/Thread/Zigbee breakout. This variant's own
// pins_arduino.h declares `static const uint8_t USER_BTN = 9;`, and the
// upstream espressif/arduino-esp32 PR that added this exact board
// definition (merged into the official repo, authored with direct
// participation from a Soldered Electronics representative on the PR
// thread) confirms GPIO9 as the board's onboard user button and matches
// every other pin value in this file (LED_BUILTIN=23, TX=16, RX=17,
// SDA=6, SCL=7, SS=2, MOSI=3, MISO=4, SCK=5) exactly. No onboard
// NeoPixel/RGB LED is documented anywhere for this board - only the
// plain LED_BUILTIN on GPIO23 - so no section 7a NeoPixel action applies.
//
// Sources consulted (see
// boardsDetails/esp32/esp32c6/soldered_nula_mini_esp32c6/notes.txt for
// the full research trail):
//  - https://github.com/espressif/arduino-esp32/pull/11852 (merged PR
//    adding the Soldered NULA Mini ESP32C6 board definition, with a
//    Soldered Electronics representative confirming "our board" in the
//    thread)
//  - https://soldered.com/products/nula-mini-esp32-c6 (product page)
//  - https://docs.soldered.com/nula-mini-esp32-c6/hardware/ (hardware
//    details page)
//  - https://docs.soldered.com/nula-mini-esp32-c6/arduino/ (Arduino
//    getting-started page)
//
// Per-pin decision:
//
// GPIO9 (USER_BTN): KEPT, tagged button. Confirmed onboard user button
// per the upstream vendor-authored board definition. Tagged with the
// restricted set ["digital_input","button"] only - not the chip-level
// default full capability set.
//
// Alias-collision check (explicitly performed per this session's
// checklist item): grepped every static-const declaration in this
// board's pins_arduino.h for the primary-UART/bus names build_boards.js
// unconditionally consumes (consts.TX/RX/SDA/SCL/SS/MOSI/MISO/SCK,
// matched by exact identifier name only - see build_boards.js
// parseEsp32Consts/buildEsp32Board ~L541-548). Their values in this file
// are TX=16, RX=17, SDA=6, SCL=7, SS=2, MOSI=3, MISO=4, SCK=5 - NONE of
// these coincide with GPIO9. No contaminating alias found; no deletions
// required.
{
  "boardName": "ESP32C6",
  "displayName": "ESP32-C6 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "8":  "Must be HIGH or floating on reboot",
    "9":  "Must be HIGH for normal boot",
    "15": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "6":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "7":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "8":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "9":  { "capabilities": ["digital_input", "button"] },
    "10": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "16": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "17": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "19": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "20": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "22": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "23": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
}
