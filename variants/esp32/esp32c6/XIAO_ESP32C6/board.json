// pfodWeb NOTE: excludes GPIO3/14 - dedicated onboard WiFi antenna
// switch control lines (WIFI_ENABLE/WIFI_ANT_CONFIG, see vendor
// pins_arduino.h).
// pfodWeb NOTE: button/LED tagging pass, 2026-07-12. GPIO15
// (LED_BUILTIN) tagged "led_low" - confirmed active-low onboard
// yellow/orange user LED per Seeed's own wiki getting-started guide
// (wiki.seeedstudio.com/xiao_esp32c6_getting_started/) and the
// independent detailed teardown at sigmdel.ca/michel/ha/xiao/
// xiao_esp32c6_intro_en.html, which quotes: "the yellow LED will be
// turned on when I/O pin 15 is brought low because of the way the LED
// is connected" and uses `ledOn = LOW;` in its example code.
// digital_input dropped from GPIO15's capabilities to match the
// XIAO_ESP32C5/XIAO_ESP32S3 sibling boards' established led_low
// precedent for their own LED_BUILTIN pins.
// No SDA/SCL/SS/MOSI/MISO/SCK/TX/RX alias in this variant's
// pins_arduino.h collides with GPIO15 (SDA=22, SCL=23, SS=21, MOSI=18,
// MISO=20, SCK=19, TX=16, RX=17) - checked, no alias line needed
// deletion.
// No onboard battery-voltage-sense pin exists in this variant's own
// pins_arduino.h (no BAT_VOLT_PIN/BAT_VOLT_PIN_EN declared, unlike the
// XIAO_ESP32C5/XIAO_ESP32S3 siblings) - confirmed by Seeed's own
// getting-started guide, which instructs users to manually solder a
// 200K divider onto A0 (GPIO0) to read battery voltage rather than
// documenting a stock onboard divider circuit - not tagged.
// No onboard general-purpose user button exists on this board either -
// GPIO9 is the Boot button only (strapping pin, "Must be HIGH for
// normal boot" per existing pinNotes below), matching the same
// Boot-only/no-general-button conclusion reached for the XIAO_ESP32C5
// sibling - not tagged.
{
  "boardName": "ESP32C6",
  "displayName": "ESP32-C6 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": {},
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "8":  "Must be HIGH or floating on reboot",
    "9":  "Must be HIGH for normal boot",
    "15": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "6":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "7":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "8":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "9":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "10": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["digital_output", "pwm_output", "led_low"] },
    "16": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "17": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "19": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "20": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "22": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "23": { "capabilities": ["digital_input", "digital_output", "pwm_output"] }
  }
}
