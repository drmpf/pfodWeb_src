{
  // pfodWeb NOTE: dedicated-hardware pin-exclusion audit, 2026-07-12.
  // Board: Olimex ESP32-S2-DevKit-Lipo (ESP32-S2 module, WS2812 "RGB user
  // LED", onboard USER button, LiPo charger, optional solder-jumper-gated
  // battery/power sense). No board.json override existed before this audit
  // (used the chip-level esp32s2/board.json default). Flagged by the
  // discovery sweep for declaring PIN_RGB_LED=18/RGB_BUILTIN=18 and
  // BUT_BUILTIN=0 — the same pattern already vendor-confirmed on the
  // sibling "esp32s2-devkit-lipo-usb" variant in this same directory
  // (identical pins_arduino.h content: PIN_RGB_LED=18, BUT_BUILTIN=0,
  // TX=43, RX=44, SDA=8, SCL=9, SS=34, MOSI=35, MISO=37, SCK=36, plus the
  // same commented-out PWR_SENSE=7 / BAT_SENSE=8 placeholders). This board
  // is the same physical Olimex family without the USB-C variant's extra
  // hardware, so the same evidence applies directly.
  //
  // Sources consulted:
  //  - https://github.com/OLIMEX/ESP32-S2-DevKit-LiPo (official Olimex
  //    hardware/software repo). Repo description: "ESP32-S2 IoT
  //    developement board with WiFi, USB programmer, RGB LED, LiPo
  //    charger, GPIOs".
  //  - https://raw.githubusercontent.com/OLIMEX/ESP32-S2-DevKit-LiPo/master/SOFTWARE/ARDUINO/ESP32-S2-DevKit-RGB-LED-button-serial/ESP32-S2-DevKit-RGB-LED-button-serial.ino
  //    Official Olimex example sketch, fetched directly (ground-truth
  //    vendor firmware, not a rendering). Contains:
  //      #define LED_PIN 18      // driven via RMT/WS2812 bit timing (ws2812_init/ws2812_write)
  //      #define BUTTON_PIN 0    // pinMode(BUTTON_PIN, INPUT_PULLUP)
  //    Sketch header comment: "Serial/button/RGB LED demo for Olimex
  //    ESP32-S2-DevKit-Lipo ... press button to change mode"; runtime
  //    message: "Press USER button to change LED mode". This directly
  //    confirms GPIO18 = onboard WS2812 RGB LED and GPIO0 = onboard USER
  //    button, from vendor firmware written specifically for this board.
  //  - https://www.olimex.com/Products/IoT/ESP32-S2/ESP32-S2-DevKit-Lipo/open-source-hardware
  //    Official product page. Lists "Reset button", "User button", and
  //    "RGB LED" among the board's features, plus "Optional battery
  //    monitoring and external power sense" (solder-jumper gated,
  //    consistent with the commented-out PWR_SENSE/BAT_SENSE placeholders
  //    in this board's pins_arduino.h).
  //  - https://www.olimex.com/forum/index.php?topic=8224.0 (Olimex forum,
  //    "ESP32S2 devkit lipo battery voltage measurement"). Confirms GPIO8
  //    is the BAT_SENS pin (matches this file's commented-out
  //    "BAT_SENSE = 8" placeholder exactly), gated behind two PTH solder
  //    jumpers that are open/unconnected by default — left EXCLUDED
  //    (commented out, inactive) per the playbook's guidance for
  //    inactive sense pins; no chipGpios change needed since the pin
  //    isn't active in this file and GPIO8 otherwise remains the normal
  //    generic I2C SDA pin. PWR_SENS was independently corroborated
  //    (search results) as GPIO7 for the S2 board family, matching this
  //    file's commented-out "PWR_SENSE = 7" placeholder as well.
  //
  // GPIO0 (BUT_BUILTIN): CONFIRMED onboard physical USER button — vendor
  // example sketch wires BUTTON_PIN=0 with INPUT_PULLUP and prints "Press
  // USER button to change LED mode". Also the ESP32-S2's standard
  // boot-strapping pin (chip-level pinNotes entry "Must be HIGH for
  // normal boot" retained unchanged — expected for this pin, not removed).
  // Tagged capabilities ["digital_input","button"] only, matching the
  // sibling esp32s2-devkit-lipo-usb board and the general playbook
  // exclusion rule for button pins (no analog/output/pwm mixed in).
  //
  // GPIO18 (PIN_RGB_LED/RGB_BUILTIN): CONFIRMED onboard WS2812 "NeoPixel"
  // RGB LED — vendor example sketch drives LED_PIN=18 via the RMT
  // peripheral with WS2812 bit timing (ws2812_init/ws2812_write), and the
  // product page lists "RGB LED" as a board feature. Tagged
  // ["digital_output","pwm_output","led_neopixel"], matching the sibling
  // esp32s2-devkit-lipo-usb board's GPIO18 entry exactly (both boards
  // share this same physical LED). Chip-level default's
  // "analog_input_serial" and "dac_output" capabilities dropped for this
  // pin since it's soldered to a dedicated NeoPixel data line, not
  // available as ADC/DAC on this board (GPIO18 doubles as DAC2 in the
  // chip's generic pins_arduino.h template, but that's chip-silicon
  // boilerplate, not a real usable function once the pin is committed to
  // the onboard LED).
  //
  // Alias-conflict check (per this session's new playbook step): checked
  // this board's own pins_arduino.h for any SDA/SCL/SS/MOSI/MISO/SCK/TX/RX
  // alias landing on GPIO0 or GPIO18 — TX=43, RX=44, SDA=8, SCL=9, SS=34,
  // MOSI=35, MISO=37, SCK=36 — none is 0 or 18, so build_boards.js's
  // unconditional i2c/spi/serial alias-capability appends cannot
  // contaminate either pin's capability list. No pins_arduino.h edit was
  // needed (clean result, unlike the sibling esp32c3-devkit-lipo board
  // found earlier this session, which did have a real SCL=9 collision).
  // GPIO18 does collide with the pins_arduino.h DAC2=18 alias, but that's
  // not one of the unconditionally-appended aliases in build_boards.js
  // (dac_output is only added via the else-branch used when no chipGpios
  // entry exists for the pin) — since this board.json sets an explicit
  // chipGpios entry for GPIO18, dac_output is fully under this file's
  // control and was deliberately left out (see above).
  //
  // See boardsDetails/esp32/esp32s2/esp32s2-devkit-lipo/notes.txt for the
  // full research trail.

  "boardName": "ESP32S2",
  "displayName": "ESP32-S2 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [46],
  "connections": ["serial", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH for normal boot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"] },
    "1":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "6":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "7":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "8":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "9":  { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "10": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "11": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "16": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "17": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "18": { "capabilities": ["digital_output", "pwm_output", "led_neopixel"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "35": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "36": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "37": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "38": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "39": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "40": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "41": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "42": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "43": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "44": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "45": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "46": { "capabilities": ["digital_input"] }
  }
}
