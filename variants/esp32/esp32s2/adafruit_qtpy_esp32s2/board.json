// pfodWeb NOTE: excludes GPIO38 - onboard NeoPixel power-gate
// (NEOPIXEL_POWER, see vendor pins_arduino.h). GPIO39 (NeoPixel data)
// stays available, matching the um_tinys3/um_tinyc6 precedent.
// pfodWeb NOTE (button/LED tagging pass): GPIO39 tagged "led_neopixel" -
// confirmed onboard single NeoPixel (WS2812-style) data pin, per
// learn.adafruit.com/adafruit-qt-py-esp32-s2/pinouts and pins_arduino.h's
// PIN_NEOPIXEL=39/LED_BUILTIN/RGB_BUILTIN sentinel mechanism. GPIO0 tagged
// "button" - confirmed onboard BOOT/user button, readable as GPIO0
// (input-with-pullup) per the same Adafruit Learn guide, matching this
// repo's established BOOT-button precedent (adafruit_qtpy_esp32,
// sensebox_mcu_esp32s2, micro_s2, etc.). See notes.txt for full research.
{
  "boardName": "ESP32S2",
  "displayName": "ESP32-S2 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [46],
  "connections": ["serial", "tcp", "http"],
