// pfodWeb NOTE: per-board override — this is the senseBox MCU-S2.
// Removed from the chip-level default chipGpios map:
//  9-13  built-in onboard microSD card slot (VSPI/SD_ENABLE)
//  17,18 XBee Bee-socket UART, also this chip's only 2 DAC pins
//        (Bee link takes priority per senseBox docs)
//  21    PD_ENABLE, the built-in photodiode sensor's enable line
//  33,34,35,36,37,38,41  the two XBEE1/XBEE2 "Bee" module sockets
//        (shared SPI bus + control lines) — optional plug-in radio
//        modules (LoRa-Bee/GSM-Bee/SD-Bee), confirmed via senseBox docs
//  42,45,46  the built-in MPU6050/ICM-20948 IMU's dedicated I2C bus
// Kept: GPIO14 (PD_SENSE, the same photodiode's reading — a sensor
// value, matching this project's thermistor/battery-monitor keep
// policy). Full copy of variants/esp32/esp32s2/board.json otherwise.
// pfodWeb NOTE: GPIO1 tagged "led_neopixel" - confirmed onboard WS2812/NeoPixel
// RGB LED (PIN_RGB_LED/RGBLED_PIN=1, RGBLED_NUM=1 in this board's pins_arduino.h;
// senseBox docs docs.sensebox.de RGB-LED page and GitHub README both confirm a
// built-in WS2812 LED using the Adafruit_NeoPixel library, "you don't have to
// connect anything else").
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard physical "Boot-Switch"
// pushbutton (senseBox-MCU-S2-ESP32S2 GitHub README, Reset/Boot-Switch section);
// GPIO0 is the ESP32-S2's fixed silicon boot-mode-select strapping pin (matches
// this board.json's own pinNotes "Must be HIGH for normal boot"), so any physical
// boot button on an ESP32-S2 board is wired to GPIO0 - same pattern as
// esp32/espea32/board.json's confirmed FLASH-button GPIO0 tagging.
{
  "boardName": "ESP32S2",
  "displayName": "ESP32-S2 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    46
  ],
  "connections": [
    "serial",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
      "capabilities": [
        "digital_output",
        "led_neopixel",
        "pwm_output"
      ]
    },
