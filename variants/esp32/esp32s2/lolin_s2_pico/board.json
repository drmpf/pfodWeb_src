// pfodWeb NOTE: excludes GPIO18 - dedicated onboard OLED reset pin.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard BOOT pushbutton
// (SW2 in wemos/docs S2 Pico schematic sch_s2_pico_v1.0.0.pdf: SW2 pulls
// GPIO0 to GND when pressed, standard ESP32 BOOT-button wiring; distinct
// from SW1/EN which is the reset button). GPIO10 tagged "led_low" -
// confirmed onboard LED1 (schematic: +3V3 -> R6 2k -> LED1 BLUE -> GPIO10,
// i.e. GPIO10 sinks current through the LED to light it, so LED is on when
// GPIO10 is driven LOW; also matches LED_BUILTIN=10 in pins_arduino.h and
// circuitpython.org/adafruit CircuitPython board defs "GPIO10 LED (blue
// status LED)").
{
  "boardName": "ESP32S2",
  "displayName": "ESP32-S2 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    46
  ],
  "connections": [
    "serial",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH for normal boot",
    "45": "Must be LOW or floating on reboot",
    "46": "Must be LOW or floating on reboot"
  },
