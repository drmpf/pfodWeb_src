// pfodWeb NOTE: excludes GPIO5-9 (dedicated onboard E-ink display:
// EPD_BUSY=5,EPD_RESET=6,EPD_DC=7,EPD_CS=8 + accelerometer IRQ=9),
// GPIO19/20 (native USB D-/D+), GPIO21 (NeoPixel power gate - internal
// only), GPIO35-37 (E-ink SPI bus: MOSI=35,SCK=36,MISO=37). Buttons,
// light sensor, battery monitor, speaker shutdown, and general I2C are
// kept. Confirmed via vendor pins_arduino.h:
// https://github.com/espressif/arduino-esp32/blob/master/variants/adafruit_magtag29_esp32s2/pins_arduino.h
// pfodWeb NOTE: GPIO11/12/14/15 tagged "button" - confirmed
// PIN_BUTTON4/BUTTON_D=11, PIN_BUTTON3/BUTTON_C=12, PIN_BUTTON2/
// BUTTON_B=14, PIN_BUTTON1/BUTTON_A=15 (Adafruit's own MagTag product
// naming, same names used in CircuitPython/Arduino guides; see
// https://learn.adafruit.com/adafruit-magtag/pinouts ). GPIO1 tagged
// "led_neopixel" - confirmed onboard NeoPixel strip (PIN_NEOPIXEL=1).
// NOTE: GPIO0 (PIN_BUTTON5/BOOT0 in pins_arduino.h) is deliberately NOT
// tagged "button" - checked and rejected. Adafruit's own pinouts page
// explicitly documents this as bootloader-entry only ("can be used to
// put the board into ROM bootloader mode"), unlike BUTTON_A-D which are
// explicitly documented as usable in application code.
// pfodWeb NOTE: GPIO13 tagged "led_high" - CORRECTED. Previously left as
// plain GPIO, but vendor pins_arduino.h defines LED_BUILTIN=13, and
// https://learn.adafruit.com/adafruit-magtag/pinouts confirms "a red LED
// labeled D13. It is user-controllable for blinky needs" - a genuine
// onboard status LED separate from the 4-pixel NeoPixel strip.
// Active-high confirmed via
// https://learn.adafruit.com/adafruit-magtag/arduino-basics
// (digitalWrite(LED_BUILTIN, HIGH) turns it on).
{
  "boardName": "ESP32S2",
  "displayName": "ESP32-S2 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
