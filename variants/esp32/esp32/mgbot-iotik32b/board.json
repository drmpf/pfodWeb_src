// pfodWeb NOTE: excludes GPIO27 - dedicated onboard IR receiver, not
// general-purpose.
// pfodWeb NOTE: GPIO0 tagged "button" - official vendor page
// books.mgbot.ru/books/baza.html lists "Кнопка входа в режим
// программирования" (programming-mode entry button) as a standard
// component shared by both ЙоТик 32А/32В controllers; on ESP32 this
// function is definitionally implemented via a GPIO0 pulldown
// (strapping pin), matching the confirmed GPIO0="button" tagging
// already applied to sibling board mgbot-iotik32a (official 32А
// datasheet: "Кнопка Р2").
// pfodWeb NOTE: GPIO18 tagged "led_high" - official vendor page
// books.mgbot.ru/books/baza.html: "Встроенный светодиод, подключенный
// к пину №18" for the ЙоТик 32В variant specifically (matches this
// board's LED_BUILTIN=18 in pins_arduino.h); independently confirmed
// by third-party review kotyara12.ru/iot/iotic32b-review/ ("pink LED
// LED3 connected to GPIO18") and by vendor's own official example repo
// github.com/MAKblC/IoTik32 (GyverPortal/LED.ino: "#define LedBord 4
// // 18, если ЙоТик 32В" then
// "digitalWrite(LedBord, (valBtn || valSwitch || valCheck));" - HIGH
// turns LED on, confirming active-high polarity carries over from the
// GPIO4 LED on sibling board mgbot-iotik32a).
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
