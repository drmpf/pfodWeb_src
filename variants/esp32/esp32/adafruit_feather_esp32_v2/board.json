// pfodWeb NOTE: excludes GPIO2 - internal power-gate for the onboard
// NeoPixel + I2C connector, not general-purpose. Independently verified
// (2026-07-14) against Adafruit's own official Learn guide:
// https://learn.adafruit.com/adafruit-esp32-feather-v2/pinouts - GPIO2
// (NEOPIXEL_I2C_POWER) "must be pulled high" to enable both the onboard
// NeoPixel and the STEMMA QT I2C connector's separate 3.3V regulator;
// pulling it LOW disables that regulator for low-power operation.
// pfodWeb NOTE: GPIO13 tagged "led_high" - confirmed active-high user
// LED, per the same Adafruit Learn pinouts page ("set high to turn on",
// labelled "#13" on the silk). GPIO38 tagged "button" - confirmed
// onboard user button, per the same page: "a user readable button
// switch to use as an input, labeled SW38 on the silk... an input-only
// pin... with a pull-up on board."
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
