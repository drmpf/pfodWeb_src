// pfodWeb NOTE: Olimex ESP32-EVB. Excludes GPIO0 (Ethernet clock input,
// "clock supplied by CR1" per vendor comment), GPIO2/14/15 (dedicated
// onboard microSD SDMMC 1-bit bus - D0/CMD/CLK, see BOARD_HAS_1BIT_SDMMC
// below; GPIO17/SS was also part of this block but is already excluded
// from the ESP32-classic chip default and had no other alias), GPIO18/23
// (ETH_PHY_MDIO/MDC), GPIO19/21/22/25/26/27 (standard ESP32 EMAC RMII
// data pins for the onboard LAN8720 PHY). ETH_PHY_POWER is -1 (always
// on, no GPIO consumed).
//
// pfodWeb NOTE (button/LED tagging pass): GPIO34 (KEY_BUILTIN) confirmed
// as this board's onboard user button ("BUT1") by RIOT-OS's board.h for
// esp32-olimex-evb (BTN0_PIN = GPIO34, external pull-up, GPIO_IN,
// falling-edge interrupt), corroborated by multiple independent sources
// describing GPIO32/GPIO33 as this board's two relay outputs (Relay1/
// Relay2), not GPIO34. Tagged ["digital_input", "button"] below; GPIO34
// is input-only on classic ESP32 (see inputOnlyGpios) so no
// digital_output/pwm_output was added, and analog_input was dropped in
// favour of the plain button tag (same policy as sibling esp32-gateway).
// No collision: GPIO34 is not aliased as SDA/SCL/SS/MOSI/MISO/SCK
// anywhere in this board's pins_arduino.h.
// LED: no onboard status LED GPIO exists on plain ESP32-EVB. RIOT-OS's
// board.h only defines LED0_PIN (GPIO33) when MODULE_OLIMEX_ESP32_GATEWAY
// is set - on ESP32-EVB, GPIO33 is Relay2 instead, and this board's own
// pins_arduino.h declares no LED_BUILTIN. Left untagged/unchanged - see
// boardsDetails notes.txt for full source list.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "5":  "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot"
  },
  "chipGpios": {
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["digital_input", "button"] },
    "35": { "capabilities": ["analog_input", "digital_input"] },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
    "39": { "capabilities": ["analog_input", "digital_input"] }
  }
}
