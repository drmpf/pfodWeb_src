// pfodWeb NOTE: excludes GPIO2/5/12/14/18/19/21-23/25-27/32-36/39 -
// dedicated onboard camera and microSD card pins (see vendor
// pins_arduino.h CAMSD/CAMSC/CAMD2-9/CAMPC/CAMXC/CAMH/CAMV,
// SDMI/SDMO/SDCS/SDCK).
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard "General Purpose
// Button" on D8 (deneyapkart.org/en/docs/deneyap-kart-1a).
// pfodWeb NOTE: GPIO13 tagged "led_neopixel" - confirmed onboard
// "addressable RGB LED (Pin: D12)" (deneyapkart.org/en/docs/deneyap-kart-1a),
// matches vendor pins_arduino.h LED_BUILTIN/RGB_BUILTIN alias.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
    36,
    37,
    38,
    39
  ],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH or floating on reboot",
    "2": "Must be LOW or floating at boot",
    "5": "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "3": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "4": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "13": {
      "capabilities": [
        "digital_output",
        "pwm_output",
        "led_neopixel"
      ]
    },
    "15": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "37": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "38": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    }
  }
}
