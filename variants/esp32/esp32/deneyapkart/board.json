// pfodWeb NOTE: excludes GPIO4/5/15/18/19/21-23/25/26/32-36/39 -
// dedicated onboard camera, IMU I2C, and mic pins (see vendor
// pins_arduino.h CAMSD/CAMSC/CAMD2-9/CAMPC/CAMXC/CAMH/CAMV, IMUSD/IMUSC,
// MICD/MICC).
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard GPKEY button
// (docs.deneyapkart.org Pin Tanimlamalari DYDK: 10K pull-up to 3.3V,
// pressed pulls LOW, also used for manual boot mode entry).
// pfodWeb NOTE: GPIO1/GPIO3 (LEDG/LEDR, confirmed active-low per
// mekinfo.net Deneyap Kart setup guide) are NOT tagged led_g_low/
// led_r_low - they're also this board's primary serial TX/RX pins,
// which build_boards.js hard-reserves for serial duty (pfodWeb's serial
// connection needs them), so any chipGpios tag on them is silently
// discarded in the generated output. GPIO4 (LEDB, active-low too) is
// already excluded above as a dedicated IMU I2C SDA pin.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
    36,
    37,
    38,
    39
  ],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH or floating on reboot",
    "2": "Must be LOW or floating at boot",
    "5": "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "2": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "3": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "14": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "27": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "37": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "38": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    }
  }
}
