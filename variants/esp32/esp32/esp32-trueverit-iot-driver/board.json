// pfodWeb NOTE: excludes GPIO14 (ETH_PHY_MDIO) and GPIO19/21/22/25/26/27
// (standard ESP32 EMAC RMII data pins, fixed silicon pins for the
// onboard LAN8720 Ethernet PHY - none aliased anywhere in this board's
// own pins_arduino.h). ETH_PHY_POWER is -1 (always on, no GPIO consumed)
// so GPIO2 stays available (still aliased as T2 in this variant, unlike
// -mkii which uses GPIO2 for ETH_PHY_POWER). GPIO16/17 (MDC / clock out)
// are already absent from the ESP32-classic chip default.
//
// pfodWeb NOTE (button/LED capability audit): GPIO18 (LED_BUILTIN) is a
// board-specific declaration (not boilerplate - the generic esp32/esp32
// chip-level pins_arduino.h has no LED_BUILTIN at all), so a real onboard
// LED is plausible, but no independent vendor documentation (schematic,
// datasheet, product page) could be found to confirm polarity - every
// third-party pinout page found is itself just auto-generated from this
// same pins_arduino.h, not independent evidence. Per policy, polarity is
// never guessed, so GPIO18's capabilities are left unchanged (no led_high/
// led_low tag applied). Separately, this board's own pins_arduino.h
// aliased GPIO18 a second time as the SPI SCK pin, duplicating the
// generic ESP32 dev-module default verbatim - that alias has been removed
// from pins_arduino.h since build_boards.js appends the SPI-clock
// capability to any GPIO matching that alias unconditionally, which would
// have contaminated this pin's capability list regardless of whether an
// LED tag is ever added later. No onboard button or relay outputs found
// in any source consulted. See boardsDetails/esp32/esp32/
// esp32-trueverit-iot-driver/notes.txt for full research trail.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH or floating on reboot",
    "2":  "Must be LOW or floating at boot",
    "5":  "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "23": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["analog_input", "digital_input"] },
    "35": { "capabilities": ["analog_input", "digital_input"] },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
