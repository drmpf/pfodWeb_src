// pfodWeb NOTE (dedicated-hardware pin audit - see
// boardsDetails/esp32/esp32/odroid_esp32/notes.txt for full sourcing,
// confirmed against Hardkernel's own open-source ODROID-GO firmware
// headers and the official ODROID wiki):
// - Excludes GPIO5, GPIO14, GPIO18, GPIO19, GPIO21, GPIO22, GPIO23 - the
//   onboard TFT display's SPI bus and chip-select/data-command/backlight
//   control lines, shared with the onboard microSD card's own
//   chip-select line on the same physical SPI bus. Fixed onboard
//   peripherals, not general-purpose.
// - Excludes GPIO25 and GPIO26 - drive the onboard speaker amplifier
//   (enable line) and its audio waveform output. GPIO25 is not actually
//   a DAC output despite this file's original alias naming it as one -
//   confirmed via vendor firmware source it is a plain digital enable
//   line for the amplifier chip. Both are dedicated to the fixed onboard
//   speaker.
// - GPIO0, GPIO13, GPIO27, GPIO32, GPIO33, GPIO39 tagged "button" -
//   confirmed via Hardkernel's own firmware headers as the physical
//   Volume, Menu, Select, A, B and Start buttons respectively.
// - GPIO2 tagged "led_high" (plus pwm_output) - confirmed via the
//   official ODROID wiki as the onboard blue status LED, turned on with
//   a HIGH output and demonstrated there under PWM dimming.
// - GPIO35 and GPIO36 (the two analog pins that triggered this audit)
//   are genuine, useful analog sensor readings and were left available:
//   GPIO35 is the joystick's Y-axis and GPIO36 is the battery voltage
//   sense line (through an onboard divider) - both confirmed via
//   Hardkernel's firmware headers / the official ODROID wiki. GPIO34
//   (already present via the chip-level default) is the joystick's
//   X-axis, on the same basis. Documented via pinNotes below rather than
//   any capability change, since analog_input was already correct.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
    36,
    37,
    38,
    39
  ],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH or floating on reboot",
    "2": "Must be LOW or floating at boot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot",
    "34": "Joystick X-axis (analog)",
    "35": "Joystick Y-axis (analog)",
    "36": "Battery voltage sense (analog, onboard divider)"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "2": {
      "capabilities": [
        "digital_output",
        "led_high",
        "pwm_output"
      ]
    },
    "3": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "4": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "12": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "13": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "15": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "27": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "32": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "33": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "34": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "35": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "36": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "37": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "38": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "39": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    }
  }
}
