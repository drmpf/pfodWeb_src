// pfodWeb NOTE: GPIO2 tagged "led_low" - confirmed onboard LED (silkscreen
// LED3, driven from 3.3V through 330R resistor R10 to GPIO2, active-low)
// per the official Node32s (Ayarafun/lamloei) vendor schematic
// (lamloei/node32s-book, ch01/node32s-schematic.pdf), which independently
// corroborates this board's own pins_arduino.h LED_BUILTIN = GPIO2.
// GPIO0 (KEY_BUILTIN in pins_arduino.h) is left untagged: the same
// schematic shows it is only the standard BOOT/flash strapping button
// (switch K2, pulled up by R9 10K) paired with the EN/reset button
// (switch K1 on CHIP_PU/R6) - not a distinct onboard user button. See
// boardsDetails/esp32/esp32/node32s/notes.txt for details.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH or floating on reboot",
    "2":  "Must be LOW or floating at boot",
