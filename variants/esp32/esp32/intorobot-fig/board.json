// pfodWeb NOTE: two kinds of changes from the chip-level esp32/esp32 default.
// (1) GPIO0 (KEY_BUILTIN) tagged "button". pins_arduino.h declares this pin
// as the board's built-in key alias, the same KEY_BUILTIN=0 naming pattern
// already confirmed as a real onboard user button on the sibling widora-air
// board this session (see variants/esp32/esp32/widora-air/board.json) - the
// standard ESP32 GPIO0/BOOT strapping pin doubling as a physical user
// button. espboards.dev's third-party pinout page for this exact board
// (espboards.dev/esp32/intorobot-fig/) independently lists "KEY_BUILTIN" at
// GPIO0, consistent with pins_arduino.h. Decision: KEEP GPIO0, tag
// ["digital_input", "button"] exactly (dropped analog_input_serial/
// digital_output/pwm_output from the chip-level default, matching the
// button-tag exclusion convention used throughout this codebase).
// (2) GPIO21/22/27 (RGB_G_BUILTIN/RGB_B_BUILTIN/RGB_R_BUILTIN) - confirmed
// as a real discrete 3-GPIO RGB LED (three separate constants driving three
// separate GPIOs, not a single WS2812/NeoPixel data pin), corroborated by
// espboards.dev's independent pinout table for this board. HOWEVER, despite
// extensive research (espboards.dev; the esp32.net/images/IntoRobot/Fig/
// auto-generated pinout-diagram mirror, which only re-renders pins_arduino.h
// pin names and carries no schematic/polarity data; IntoRobot's own GitHub
// org github.com/IntoRobot, which publishes hardware_atom/hardware_fox/
// hardware_ant schematic repos for other IntoRobot boards but has NO
// dedicated hardware repo for "Fig"; docs.intorobot.com, unreachable -
// connection refused/self-signed cert; the original Indiegogo campaign page
// for the IntoRobot IoT dev kit; and Chinese-language searches for vendor
// manuals/schematics), no vendor schematic or documentation stating
// active-high vs active-low polarity for the RGB LED was found anywhere.
// Per audit policy ("don't guess if polarity evidence is weak"), NO
// led_r_high/led_r_low (or _g_/_b_) capability tag is applied to any of the
// three channels - guessing polarity would risk driving the LED backwards
// (inverted brightness / stuck-on) in the Designer UI. GPIO21/22/27
// capabilities are left UNCHANGED from the chip-level default; a pinNotes
// entry is added to each documenting the confirmed RGB-channel role and the
// unconfirmed polarity, matching the precedent set by the d1_mini32 board's
// GPIO35/_VBAT pinNotes treatment (confirmed role, unconfirmed circuit
// detail -> document via pinNotes, do not guess a capability tag).
// pfodWeb NOTE: alias-collision check performed per audit playbook - this
// board's bus aliases are SDA=23, SCL=19, SS=5, MOSI=16, MISO=17, SCK=18,
// TX=1, RX=3. None of these equal 0, 21, 22, or 27, so build_boards.js's
// unconditional SDA/SCL/SS/MOSI/MISO/SCK/TX/RX capability appends do not
// contaminate the button or RGB-channel pins here. No pins_arduino.h edit
// was needed for this board.
{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP32" -> designer/boards/ESP32/ESP32.json -> const ESP32Data = {...}
  "boardName": "ESP32",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "ESP32 Dev Module",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // Supported values: "avr", "esp32".
  "family": "esp32",

  // Default PWM output range for analogWrite() (LEDC, 8-bit default).
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // DAC output: ESP32 has two 8-bit DAC channels on GPIO 25 and GPIO 26.
  // dacWrite(pin, value): value 0–255 maps to 0.0–3.3 V output.
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },

  // ADC: ESP32 has a 12-bit ADC (0–4095) via analogRead().  Default reference
  // is the internal 3.3 V supply.  Attenuation can be set via analogSetAttenuation()
  // for full 0–3.3 V range; without attenuation input range is ~0–1.1 V.
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },

  // GPIO numbers that are input-only (no internal pull-up driver, no
  // output driver).  Used by the ESP32 parser to drop digital_output and
  // pwm_output capabilities from those pins.  Leave [] on boards where
  // every pin is bidirectional (e.g. all AVR variants).
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],

  // Transports this board can talk pfod over.  Values are the lowercase
  // machine identifiers from pfodCommon.html's protocol radios.  ESP32
  // family supports Serial via UART, BLE via Bluetooth LE, TCP via the
  // WiFi stack, and HTTP via the WiFi stack + a small server library.
  "connections": ["serial", "ble", "tcp", "http"],

  // Boot-time / power-up warnings for specific GPIO numbers.
  // Keys are GPIO numbers as strings; values are plain text shown
  // under the pin label in the pin picker (use \n for line breaks).
  // Reference: ESP32 Technical Reference Manual — Strapping Pins section.
  "pinNotes": {
    "0":  "Must be HIGH or floating on reboot",
    "2":  "Must be LOW or floating at boot",
    "5":  "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot",
    "21": "RGB_G_BUILTIN - onboard discrete RGB LED green channel; no vendor schematic confirming active-high/active-low polarity was found, so no led_g_high/led_g_low capability is applied - this is a plain GPIO",
    "22": "RGB_B_BUILTIN - onboard discrete RGB LED blue channel; no vendor schematic confirming active-high/active-low polarity was found, so no led_b_high/led_b_low capability is applied - this is a plain GPIO",
    "27": "RGB_R_BUILTIN - onboard discrete RGB LED red channel; no vendor schematic confirming active-high/active-low polarity was found, so no led_r_high/led_r_low capability is applied - this is a plain GPIO"
  },

  // User-accessible GPIO numbers on the ESP32 chip.  GPIOs 6-11 (flash)
  // and 16-17 (PSRAM) are excluded — not user-accessible on modules with
  // integrated flash/PSRAM.  GPIOs 34-39 are input-only (no output driver).
  // GPIOs 20, 24, 28-31 do not exist in this chip's silicon.
  // Source: Espressif ESP-IDF documentation (docs.espressif.com).
  //
  // GPIO0 is tagged "button" instead of the generic analog/digital set
  // because it is the board's real onboard user button (KEY_BUILTIN) — see
  // the pfodWeb NOTE at the top of this file. GPIO21/22/27 keep the generic
  // chip-level default set — see the pfodWeb NOTE above for why no led_*
  // polarity tag is applied despite the confirmed RGB LED role.
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"] },
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "19": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "22": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "23": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "25": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "26": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "27": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["analog_input", "digital_input"] },
    "35": { "capabilities": ["analog_input", "digital_input"] },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
    "39": { "capabilities": ["analog_input", "digital_input"] }
  }
}
