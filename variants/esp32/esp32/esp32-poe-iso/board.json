// pfodWeb NOTE: Olimex ESP32-PoE-ISO. Excludes GPIO0 (Ethernet clock
// out, PSRAM build variant), GPIO2/5/14/15 (dedicated onboard microSD
// SDMMC 1-bit bus + CS), GPIO18/23 (ETH_PHY_MDIO/MDC), GPIO12 (ETH_PHY_
// POWER), GPIO19/21/22/25/26/27 (standard ESP32 EMAC RMII data pins for
// the onboard LAN8720 PHY) - none of these are aliased anywhere in this
// board's own pins_arduino.h. GPIO16/17 already absent from the
// ESP32-classic chip default (PSRAM-reserved range).
// GPIO34 (KEY_BUILTIN) confirmed via the vendor's own schematic netlist
// (github.com/OLIMEX/ESP32-POE-ISO, HARDWARE/ESP32-PoE-ISO-Rev.B/
// ESP32-PoE-ISO_Rev_B.net) as net "/GPI34/BUT1", tying BUT1 (push
// button) plus pull-up resistors R48/R49 to the ESP32 module pin for
// GPIO34 - tagged "button" below. GPIO34 is input-only on classic ESP32
// (see inputOnlyGpios), so no digital_output/pwm_output capability is
// added. The board's 4 status LEDs (PWR1/CHRG1/LNK1/ACT1) are confirmed
// by the same netlist to be wired only to the +5V rail and to the
// LAN8710A Ethernet PHY (U4) - none are connected to any ESP32 GPIO, so
// no LED capability is added anywhere on this board.
// Alias-collision check (per audit step 4): this board's own
// pins_arduino.h does not declare SS/MOSI/MISO/SCK at all (deliberately
// omitted per its own comment - MOSI/MISO/SCK match the fixed onboard
// microSD SDMMC pins), and SDA=13/SCL=33-or-16 do not touch GPIO34, so
// there is no bus-alias contamination risk for the "button" tag here.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {},
  "chipGpios": {
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["digital_input", "button"] },
    "35": { "capabilities": ["analog_input", "digital_input"] },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
    "39": { "capabilities": ["analog_input", "digital_input"] }
  }
}
