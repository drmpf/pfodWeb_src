        "digital_output",
        "pwm_output"
      ]
    },
    "35": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "36": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "37": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    }
  }
}
