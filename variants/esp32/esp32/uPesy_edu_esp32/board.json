// pfodWeb NOTE: dedicated-hardware pin-exclusion audit, 2026-07-12.
// Board: uPesy EDU ESP32 (Arduino-UNO-form-factor ESP32 devkit, marketed for
// classroom/educational use, shield-compatible). No board.json override
// existed before this audit (used the chip-level esp32/esp32/board.json
// default). Flagged by the discovery sweep for declaring
// "#define PIN_A0 A0  // backward compatibility" - investigated and
// confirmed to be a harmless alias-of-an-alias (A0 is already a
// static const uint8_t = 33 declared earlier in the same file; PIN_A0 is
// just a legacy macro name pointing at it, same value, no new pin, no
// collision with any bus alias). No action taken on PIN_A0/A0.
//
// Opportunistic button/LED/sensor review (this board was never individually
// reviewed before): confirmed via vendor documentation that GPIO2
// (LED_BUILTIN) is a real onboard orange LED, active-high. GPIO0 (BOOT) is
// documented by the vendor as the boot-mode-entry pin only, explicitly
// advising against general use - not a user-purpose button, so left
// untagged. No other onboard sensors, battery-monitor circuitry, or
// dedicated peripherals are documented for this board.
//
// Sources consulted:
//  - https://www.upesy.com/blogs/tutorials/upesy-edu-esp32-board-documentation-version-latest
//    Official uPesy documentation for this exact board. States (French):
//    "Une LED orange est reliee a la broche physique IO2 de l'ESP32"
//    (an orange LED is connected to physical pin IO2), referenced via
//    LED_BUILTIN, lights up when the pin outputs high (3.3V) and is off at
//    low (0V) - i.e. active-high. Also documents a green power-indicator
//    LED (not GPIO-driven, no tag needed) and confirms the BOOT button is
//    wired to IO0, describing it as a button that "should not be used"
//    except when troubleshooting firmware uploads - i.e. a bootloader-entry
//    pin, not a general-purpose user button. No onboard sensors or battery
//    monitoring circuitry are mentioned anywhere in this page.
//  - https://www.upesy.com/blogs/tutorials/upesy-edu-esp32-board-quick-start
//    Official uPesy quick-start guide for this board. Confirms the board is
//    "au format UNO" (Arduino UNO form factor / shield-compatible) and
//    documents the Arduino-UNO-style D0-D13 pin correspondence, but adds no
//    further onboard-component detail beyond the documentation page above.
//  - This board's own pins_arduino.h was read in full (see comment above
//    chipGpios below) - only the standard TX/RX/SDA/SCL/SPI/analog/D0-D13/
//    LED_BUILTIN boilerplate is declared; no board-specific sensor, battery,
//    or actuator pin exists in the file itself.
//  - Compared against the sibling board uPesy_esp32_wroom_devkit (already
//    reviewed this same session; boardsDetails/esp32/esp32/
//    uPesy_esp32_wroom_devkit/notes.txt), which uses the identical GPIO2
//    orange/blue LED_BUILTIN pattern per uPesy's own documentation for that
//    board, confirming this is a consistent, deliberate uPesy product-line
//    design (not a one-off finding needing extra scrutiny).
//
// Alias-collision check (critical step per this session's task): GPIO2 (the
// only GPIO being retagged) was checked against every bus alias in this
// board's pins_arduino.h - SDA=21, SCL=22, SS=5, MOSI=23, MISO=19, SCK=18,
// TX=1, RX=3. GPIO2 matches none of them, so tagging it "led_high" cannot
// collide with build_boards.js's unconditional bus-alias capability
// appends. No alias deletions were needed for this board.
//
// GPIO2 (LED_BUILTIN): CONFIRMED onboard orange LED, active-high - see
// sources above. Tagged ["digital_output","led_high","pwm_output"],
// matching the sibling uPesy_esp32_wroom_devkit's led_high precedent.
//
// GPIO0 (BOOT): considered but NOT tagged as a button - vendor documentation
// explicitly frames it as a boot-mode-entry pin to avoid using in normal
// operation, not a general-purpose user button. Matches this repo's
// no-guess policy: EN/BOOT-style pins are not tagged "button" without
// vendor language calling them a user-facing button.
//
// See boardsDetails/esp32/esp32/uPesy_edu_esp32/notes.txt for the full
// research trail.

{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP32" -> designer/boards/ESP32/ESP32.json -> const ESP32Data = {...}
  "boardName": "ESP32",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "ESP32 Dev Module",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // Supported values: "avr", "esp32".
  "family": "esp32",

  // Default PWM output range for analogWrite() (LEDC, 8-bit default).
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // DAC output: ESP32 has two 8-bit DAC channels on GPIO 25 and GPIO 26.
  // dacWrite(pin, value): value 0–255 maps to 0.0–3.3 V output.
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },

  // ADC: ESP32 has a 12-bit ADC (0–4095) via analogRead().  Default reference
  // is the internal 3.3 V supply.  Attenuation can be set via analogSetAttenuation()
  // for full 0–3.3 V range; without attenuation input range is ~0–1.1 V.
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },

  // GPIO numbers that are input-only (no internal pull-up driver, no
  // output driver).  Used by the ESP32 parser to drop digital_output and
  // pwm_output capabilities from those pins.  Leave [] on boards where
  // every pin is bidirectional (e.g. all AVR variants).
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],

  // Transports this board can talk pfod over.  Values are the lowercase
  // machine identifiers from pfodCommon.html's protocol radios.  ESP32
  // family supports Serial via UART, BLE via Bluetooth LE, TCP via the
  // WiFi stack, and HTTP via the WiFi stack + a small server library.
  "connections": ["serial", "ble", "tcp", "http"],

  // Boot-time / power-up warnings for specific GPIO numbers.
  // Keys are GPIO numbers as strings; values are plain text shown
  // under the pin label in the pin picker (use \n for line breaks).
  // Reference: ESP32 Technical Reference Manual — Strapping Pins section.
  "pinNotes": {
    "0":  "Must be HIGH or floating on reboot",
    "2":  "Must be LOW or floating at boot",
    "5":  "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },

  // User-accessible GPIO numbers on the ESP32 chip.  GPIOs 6-11 (flash)
  // and 16-17 (PSRAM) are excluded — not user-accessible on modules with
  // integrated flash/PSRAM.  GPIOs 34-39 are input-only (no output driver).
  // GPIOs 20, 24, 28-31 do not exist in this chip's silicon.
  // Source: Espressif ESP-IDF documentation (docs.espressif.com).
  //
  // Board-specific: GPIO2 (LED_BUILTIN) retagged with a confirmed onboard
  // orange LED capability - see the pfodWeb NOTE above. All other GPIOs
  // unchanged from the chip-level default.
  "chipGpios": {
    "0":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["digital_output", "led_high", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "19": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "22": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "23": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "25": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "26": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "27": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["analog_input", "digital_input"] },
    "35": { "capabilities": ["analog_input", "digital_input"] },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
    "39": { "capabilities": ["analog_input", "digital_input"] }
  }
}
