// pfodWeb NOTE: excludes GPIO5/15/18/19/21-23/25-27/32/34-36/39 -
// dedicated onboard OV2640 camera pins, GPIO33 - dedicated battery-hold
// pin, GPIO12/14 - dedicated BM8563 RTC I2C (not exposed in this boards
// own pins_arduino.h) - confirmed via M5Stack TimerCam docs.
// pfodWeb NOTE: GPIO2 tagged "led_high" - confirmed onboard blue status
// LED (POWER_LED_PIN), active-high PWM via LEDC channel, per M5Stack
// TimerCam-arduino library source (src/utility/Power_Class.h/.cpp).
// pfodWeb NOTE: GPIO37 (PWR/wake button, schematic-confirmed) left
// UNTAGGED - see boardsDetails notes.txt for human review; the pin
// lacks an external pull-up (ESP32 GPIO34-39 have none internally) so
// digitalRead is unreliable/floating on stock hardware per M5Stack
// community hardware investigation.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
    36,
    37,
    38,
    39
  ],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH or floating on reboot",
    "2": "Must be LOW or floating at boot",
    "5": "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "1": {
