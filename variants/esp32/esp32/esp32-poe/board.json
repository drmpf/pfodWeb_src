// pfodWeb NOTE: Olimex ESP32-PoE. Excludes GPIO0 (Ethernet clock out,
// PSRAM build variant), GPIO2/5/14/15 (dedicated onboard microSD SDMMC
// 1-bit bus + CS), GPIO18/23 (ETH_PHY_MDIO/MDC), GPIO12 (ETH_PHY_POWER),
// GPIO19/21/22/25/26/27 (standard ESP32 EMAC RMII data pins for the
// onboard LAN8720 PHY) - none of these are aliased anywhere in this
// board's own pins_arduino.h. GPIO16/17 already absent from the
// ESP32-classic chip default (PSRAM-reserved range).
//
// pfodWeb NOTE (button/LED tagging pass): GPIO34 (KEY_BUILTIN) confirmed
// as the onboard user button (schematic ref "BUT1", net label
// "GPI34\BUT1", pull-up resistor R48) via the official Olimex
// OLIMEX/ESP32-POE GitHub repo KiCad schematic (Rev.M1) - see
// boardsDetails/esp32/esp32/esp32-poe/notes.txt for full source list.
// Tagged ["digital_input","button"] below. This board's onboard LEDs
// (PWR1/CHRG1/ACT1/LNK1) are power/charge/Ethernet-link status
// indicators only, not wired to any ESP32 GPIO (confirmed by the same
// schematic and corroborated by third-party sources) - no LED_BUILTIN
// exists in this board's pins_arduino.h, so no LED tag was added. No
// SS/MOSI/MISO/SCK aliases are declared in this board's pins_arduino.h
// (see existing note below), and this board's SDA=13/SCL=33-or-16 do
// not collide with GPIO34, so no alias-collision cleanup was needed for
// this pass.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {},
  "chipGpios": {
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["digital_input", "button"] },
    "35": { "capabilities": ["analog_input", "digital_input"] },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
    "39": { "capabilities": ["analog_input", "digital_input"] }
  }
}
