// pfodWeb NOTE: excludes GPIO4/13 (W5500 Ethernet CS/MOSI), GPIO5/15/
// 18/19/21-23/26/27/32/34-36/39 (OV2640 camera), GPIO12/14 (camera
// SIOC/SIOD) - confirmed via M5Stack PoECam docs.
// pfodWeb NOTE: GPIO0 tagged "led_high" - confirmed official m5stack/M5PoECAM
// Arduino library (M5PoECAM.h M5_POE_CAM_LED_PIN=0; M5PoECAM.cpp setLed()
// calls digitalWrite(pin, status) directly, i.e. active-high) and
// docs.m5stack.com/en/unit/poe_cam pinmap (Blue LED = G0).
// pfodWeb NOTE: GPIO37 tagged "button" - confirmed official m5stack/M5PoECAM
// Arduino library (M5PoECAM.h M5_POE_CAM_BTN_A_PIN=37, BtnA) and
// docs.m5stack.com/en/unit/poe_cam pinmap (Side Button = G37).
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
    36,
    37,
    38,
    39
  ],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH or floating on reboot",
    "2": "Must be LOW or floating at boot",
    "5": "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_output",
        "pwm_output",
        "led_high"
      ]
    },
    "1": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "2": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "3": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "25": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output",
        "dac_output"
      ]
    },
    "33": {
      "capabilities": [
        "analog_input",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "37": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "38": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    }
  }
}
