// pfodWeb NOTE: excludes GPIO32/33/35 - dedicated onboard Ethernet PHY
// (KSZ8081) MDC/MDIO/interrupt lines, not general-purpose. Independently
// verified (2026-07-14) against the official arduino-esp32 upstream
// source (espressif/arduino-esp32, variants/connaxio_espoir/
// pins_arduino.h, added in PR #6822 "Add support for Connaxio's Espoir"
// by ma-lalonde): `#define ETH_PHY_MDC 32`, `#define ETH_PHY_MDIO 33`,
// and `#define ETH_INT 35` (this repo's local copy has the ETH_INT
// declaration replaced with an explanatory comment, per this repo's
// convention of documenting removed aliases rather than silently
// dropping them). The mikroBUS UART/I2C/SPI socket pins stay kept -
// optional/user-populated click-board slot, not fixed onboard hardware.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
    36,
    37,
    38,
    39
  ],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH or floating on reboot",
    "2": "Must be LOW or floating at boot",
    "5": "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
