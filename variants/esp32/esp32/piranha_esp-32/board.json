// pfodWeb NOTE: GPIO0 tagged "button" - this variant is iarduino.ru's
// "Piranha ESP-32" controller (added to arduino-esp32 by PR #3542, "Added
// Piranha ESP-32 and Metro ESP-32 boards", drondistortion, Jan 2020).
// iarduino's own wiki page for this exact product line, "Piranha Set
// ESP32" (wiki.iarduino.ru/page/piranha-set-esp32/), documents an onboard
// BOOT pushbutton and its manual flashing procedure ("Кнопка BOOT служит
// для ручного перевода модуля в режим прошивки" - the BOOT button is used
// to manually put the module into programming mode: hold BOOT, press and
// release RESET, then release BOOT - the classic GPIO0-held-low-during-
// reset strapping sequence). Notably, that page's pinout table lists the
// board's general-purpose GPIOs (13,15-19,21,22,25,26,32,33,34,36) and
// deliberately omits GPIO0 - consistent with GPIO0 being committed to the
// onboard BOOT button rather than exposed as free I/O. The sibling
// "Piranha ESP32 v2" wiki page (wiki.iarduino.ru/page/piranha-es32-wiki/)
// confirms the same BOOT button behavior on the follow-on revision, and
// lists its stated v1->v2 changes (parallel ADC+WiFi, sturdier USB port,
// external antenna connector) with no mention of remapping the BOOT
// button pin. GPIO0 is also the universal boot-mode strapping pin wired
// to a physical BOOT pushbutton on essentially every ESP32 dev board.
// Treated as a confirmed onboard user/boot button; capabilities
// restricted to digital_input+button only.
//
// Alias-collision check (this session's critical-check policy): this
// file's pins_arduino.h also aliases GPIO0 as A11 and T1 (touch1). Neither
// collides with the SDA/SCL/SS/MOSI/MISO/SCK/TX/RX identifiers that
// build_boards.js unconditionally appends bus capabilities for (SDA=21,
// SCL=22, SS=5, MOSI=23, MISO=19, SCK=18, TX=1, RX=3 in this file) - none
// of them equal GPIO0, so no i2c/spi/uart capability leaks onto this pin.
// The A11 alias has no equivalent capability-injection path in
// build_boards.js (that only happens for the bus/uart identifiers above);
// it only affects the pre-override display label, which is replaced by
// "GPIO0 (Button)" anyway once the button tag is present. No pins_arduino.h
// edit was needed for this board.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH or floating on reboot",
    "2":  "Must be LOW or floating at boot",
    "5":  "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"] },
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "19": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "22": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "23": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "25": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "26": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "27": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["analog_input", "digital_input"] },
    "35": { "capabilities": ["analog_input", "digital_input"] },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
    "39": { "capabilities": ["analog_input", "digital_input"] }
  }
}
