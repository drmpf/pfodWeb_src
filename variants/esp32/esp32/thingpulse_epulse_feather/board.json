{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP32" -> designer/boards/ESP32/ESP32.json -> const ESP32Data = {...}
  "boardName": "ESP32",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "ThingPulse ePulse Feather",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // Supported values: "avr", "esp32".
  "family": "esp32",

  // Default PWM output range for analogWrite() (LEDC, 8-bit default).
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // DAC output: ESP32 has two 8-bit DAC channels on GPIO 25 and GPIO 26.
  // dacWrite(pin, value): value 0–255 maps to 0.0–3.3 V output.
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },

  // pfodWeb NOTE: adc.defaultRefVolts corrected from the ESP32 chip-level
  // default of "3.3" to "4.84" for this board only. This board's own
  // pins_arduino.h carries the vendor's inline comment on the battery
  // monitor pin stating an onboard resistor-divider ratio ahead of the
  // ADC input, and this was independently verified against the vendor's
  // own published schematic (sheet 2/2, battery-monitor block), which
  // shows the divider wired directly and permanently from the battery
  // input rail to ground with no jumper, switch, or other component
  // that could disconnect it, tapped at the ADC pin in between.
  // Sources:
  //   https://thingpulse.com/wp-content/uploads/2023/01/ePulseFeather_Schematic_20221230.pdf
  //     (ThingPulse "ePulse Feather" schematic, rev 1.0, dated 2022-12-30,
  //     sheet 2/2, "BATTERY MONITOR VBAT" block) — confirms two resistors
  //     in series from the battery rail to ground, with the ADC pin
  //     tapped at their junction, matching the resistor values named in
  //     this board's pins_arduino.h comment.
  //   https://github.com/espressif/arduino-esp32/pull/9256/files
  //     (upstream Arduino-ESP32 core PR that added this exact board
  //     variant, contributed by a ThingPulse-affiliated author) — carries
  //     the same divider comment verbatim, corroborating it is a vendor
  //     fact and not a one-off typo.
  //   https://github.com/matthias-bs/BresserWeatherSensorTTN/issues/55
  //     — independently confirms this board's battery-monitor divider
  //     ratio differs from the 1:1 divider used on the Adafruit HUZZAH32
  //     ESP32 Feather, i.e. it is a deliberate board-specific design
  //     choice, not an oversight.
  // Math: the two resistors form a divider from the battery rail down to
  // the ADC pin, with the smaller resistor on the battery side and the
  // larger resistor from the ADC node to ground. Using the values from
  // the pins_arduino.h comment (battery-side 2.2 megaohm, ground-side
  // 4.7 megaohm): the ADC pin sees battery-voltage * 4.7/(2.2+4.7) =
  // battery-voltage * 0.6812. Inverting that, the ESP32's native 3.3 V
  // full-scale ADC range corresponds to an external (battery-side)
  // full-scale of 3.3 / 0.6812 = 4.84 V. Applied board-wide because the
  // divider is permanently wired (no jumper/switch found in the
  // schematic), so it is the correct interpretation for analogRead() on
  // this pin, and no other analog pin on this board carries a divider
  // that would need a different scale.
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "4.84" },

  // GPIO numbers that are input-only (no internal pull-up driver, no
  // output driver).  Used by the ESP32 parser to drop digital_output and
  // pwm_output capabilities from those pins.  Leave [] on boards where
  // every pin is bidirectional (e.g. all AVR variants).
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],

  // Transports this board can talk pfod over.  Values are the lowercase
  // machine identifiers from pfodCommon.html's protocol radios.  ESP32
  // family supports Serial via UART, BLE via Bluetooth LE, TCP via the
  // WiFi stack, and HTTP via the WiFi stack + a small server library.
  "connections": ["serial", "ble", "tcp", "http"],

  // Boot-time / power-up warnings for specific GPIO numbers.
  // Keys are GPIO numbers as strings; values are plain text shown
  // under the pin label in the pin picker (use \n for line breaks).
  // Reference: ESP32 Technical Reference Manual — Strapping Pins section.
  "pinNotes": {
    "0":  "Must be HIGH or floating on reboot",
    "2":  "Must be LOW or floating at boot",
    "5":  "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },

  // User-accessible GPIO numbers on the ESP32 chip.  GPIOs 6-11 (flash)
  // and 16-17 (PSRAM) are excluded — not user-accessible on modules with
  // integrated flash/PSRAM.  GPIOs 34-39 are input-only (no output driver).
  // GPIOs 20, 24, 28-31 do not exist in this chip's silicon.
  // Source: Espressif ESP-IDF documentation (docs.espressif.com).
  //
  // pfodWeb NOTE: GPIO0 tagged "button" (digital_output/pwm_output
  // dropped) - confirmed via the same official ThingPulse schematic cited
  // above (sheet 1/2, "Programming Circuit" block): a physical momentary
  // pushbutton (part SKRKAEE020) is wired directly across the GPIO0-to-
  // ground net, in parallel with the auto-program transistor that the
  // onboard CH9102F USB-serial chip drives from its RTS line. This is the
  // board's only physical pushbutton (the reset side of that same circuit
  // is transistor-driven only, no separate reset button); GPIO0 is not
  // broken out to either of the board's pin headers, so it is only usable
  // as this dedicated boot/flash-mode button, not as a general-purpose
  // pin. No addressable RGB LED, single-color status LED, or other
  // onboard indicator component appears anywhere in either schematic
  // sheet, and this board's own pins_arduino.h sets LED_BUILTIN to -1
  // (none), matching that finding.
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"] },
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "19": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "22": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "23": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "25": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "26": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "27": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["analog_input", "digital_input"] },
    "35": { "capabilities": ["analog_input", "digital_input"], "note": "Onboard battery-voltage-sense pin (BATT_MONITOR / A13) — permanently wired through a fixed resistor divider from the battery rail, schematic-confirmed (see pfodWeb NOTE above adc block). Kept as a normal analog input; the board-wide adc.defaultRefVolts above already accounts for the divider scaling." },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
    "39": { "capabilities": ["analog_input", "digital_input"] }
  }
}
