// pfodWeb NOTE: excludes GPIO5/15/18/19/21-23/25-27/32/34-36/39 -
// dedicated onboard OV2640 camera pins - confirmed via M5Stack UnitCam
// docs.
// pfodWeb NOTE: GPIO4 tagged "led_low" - confirmed via M5Stack UnitCam
// docs.m5stack.com pinmap (LED D1 -> Unit Cam G4) and official schematic
// (unit_cam_sch_01.webp): D1 blue LED anode tied to +3V, cathode through
// R7 1K ohm to GPIO4 - GPIO4 LOW sinks current and turns LED on
// (active-low). No physical button found on this board - P1/P2 are
// solder-pad programming headers only, not user buttons.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
