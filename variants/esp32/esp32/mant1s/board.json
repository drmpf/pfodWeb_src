// pfodWeb NOTE: excludes GPIO0 - dedicated onboard LAN867X Ethernet PHY
// clock input (ETH_CLK_MODE=ETH_CLOCK_GPIO0_IN). GPIO7/8 (MDIO/MDC) are
// already absent from the ESP32-classic chip default (flash-reserved
// range), so no extra exclusion needed for those.
// 2026-07-14 CONFIRMED via independent research: merged arduino-esp32
// core PR #11848 (by the board's own designer) plus ESPHome's own
// Ethernet component docs (https://esphome.io/components/ethernet/)
// independently describe the same GPIO0 clock/GPIO7 MDIO/GPIO8 MDC
// config for this exact board. No public schematic exists yet
// (crowdfunded board). See notes.txt for full source list.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "2":  "Must be LOW or floating at boot",
    "5":  "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "14": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "19": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "22": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "23": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "25": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "26": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "27": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["analog_input", "digital_input"] },
    "35": { "capabilities": ["analog_input", "digital_input"] },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
    "39": { "capabilities": ["analog_input", "digital_input"] }
  }
}
