// pfodWeb NOTE: per-board override — this is the RoboHeart Hercules
// motor-driver robotics board. Removed from the chip-level default
// chipGpios map:
//  25,26,27,32,33,4  the 3 motor driver IN1/IN2 outputs
//  2                 the motors' shared nSLEEP enable line
//  12,14,15          the optional GSM Vela connector's control
//                    lines (PWRKEY/RTS/CTS)
//  16,17             the GSM connector's dedicated UART
// Kept: GPIO13 (LED_ROBOHEART, also GSM_DTR — still a simple LED).
// Full copy of variants/esp32/esp32/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard "BOOT" pushbutton
// visible on vendor pinout diagram (Augmented-Robotics/roboheart-arduino-library
// images/RoboHeart_Top_Pinout.jpg), matching BUTTON_ROBOHEART define.
// pfodWeb NOTE: GPIO13 tagged "led_high" - confirmed onboard "BLINK" LED (D4)
// visible on same vendor pinout diagram; RoboHeartLED.ino example sketch shows
// digitalWrite(LED_ROBOHEART, HIGH) turns it on (active-high). Note this pin
// is shared with GSM_DTR for the optional GSM Vela connector (see NOTE above).
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
    36,
    37,
    38,
    39
  ],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH or floating on reboot",
    "2": "Must be LOW or floating at boot",
    "5": "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "3": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "5": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "13": {
      "capabilities": [
        "digital_output",
        "led_high",
        "pwm_output"
      ]
    },
    "18": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "19": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "21": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "22": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "23": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "34": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "35": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "36": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "37": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "38": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "39": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    }
  }
}
