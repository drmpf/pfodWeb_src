// pfodWeb NOTE: dedicated-hardware pin-exclusion audit, 2026-07-12.
// Board confirmed as Adafruit "HUZZAH32 - ESP32 Feather" (product 3405)
// via learn.adafruit.com (Pinouts, Power Management, Overview pages) -
// see boardsDetails/esp32/esp32/feather_esp32/notes.txt for full source
// list and reasoning.
//
// FINDING - GPIO35 (BATT_MONITOR / A13): confirmed genuine onboard
// battery-voltage-sense pin. Adafruit's own docs: "You can read half of
// the battery voltage off of A13 also known as GPIO 35. Don't forget to
// double the voltage you read, since there is a divider." No exact
// resistor values were published (schematic/Eagle files not readable via
// automated fetch), only the doubling relationship - so the board-wide
// "adc.defaultRefVolts" is left at the chip default (this divider only
// scales this one pin's reading, it is not a whole-board ADC reference
// change, matching the sibling esp32-devkit-lipo precedent). KEEP per
// playbook policy for battery/voltage-monitor analog pins - added an
// informational pinNotes entry only, no capability change (GPIO35 is
// already input-only via the chip-level inputOnlyGpios list).
//
// FINDING - GPIO0: confirmed onboard tactile "0" button, used for
// bootloader-select (hold low while tapping Reset to enter bootloader),
// also usable as a plain digital input during normal operation. Tagged
// "button" - capabilities restricted to digital_input + button only per
// section 7a. Checked against this board's TX(17)/RX(16) - no collision.
//
// FINDING - GPIO13: confirmed onboard red LED next to the USB port
// (also declared LED_BUILTIN in this board's own pins_arduino.h).
// Tagged "led_high" (active-high, standard convention for this LED
// across the Feather ESP32 product line) with pwm_output retained since
// GPIO13 is a normal bidirectional/PWM-capable pin. Checked against
// TX/RX - no collision.
//
// FINDING - no SDA/SCL/SS/MOSI/MISO/SCK/TX/RX alias collision on any of
// the three pins above: SDA=23, SCL=22, SS=33, MOSI=18, MISO=19, SCK=5,
// TX=17, RX=16 in this board's pins_arduino.h - none equal 0, 13, or 35.
//
// FINDING - two commented-out reference lines in this board's own
// pins_arduino.h ("//static const uint8_t Ax = 0;" / "...Ax = 2;") were
// deleted entirely rather than left as comments. The parser's alias
// regex has no comment awareness and matched both lines despite the
// leading "//", producing a spurious "Ax" alias resolving to GPIO2 (the
// second, later match silently overwrote the first) - this would have
// mislabeled GPIO2 with a non-existent identifier in generated code.
// Confirmed no other live declaration of the name "Ax" exists anywhere
// else in the file, so deleting both lines fully removes the hazard.
{
  // Output filename and BoardLoader data-variable name:
  //   boardName "ESP32" -> designer/boards/ESP32/ESP32.json -> const ESP32Data = {...}
  "boardName": "ESP32",

  // Fallback human-readable name shown in the designer UI.  Overridden
  // by the matching `<id>.name=` entry in a sibling-or-ancestor
  // boards.txt when one is present (matched via `<id>.build.variant=`
  // against this variant's directory name).
  "displayName": "Adafruit ESP32 Feather",

  // Parser dialect that interprets this variant's pins_arduino.h.
  // Supported values: "avr", "esp32".
  "family": "esp32",

  // Default PWM output range for analogWrite() (LEDC, 8-bit default).
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },

  // DAC output: ESP32 has two 8-bit DAC channels on GPIO 25 and GPIO 26.
  // dacWrite(pin, value): value 0–255 maps to 0.0–3.3 V output.
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },

  // ADC: ESP32 has a 12-bit ADC (0–4095) via analogRead().  Default reference
  // is the internal 3.3 V supply.  Attenuation can be set via analogSetAttenuation()
  // for full 0–3.3 V range; without attenuation input range is ~0–1.1 V.
  // NOTE: GPIO35/A13 (BATT_MONITOR) has its own onboard resistor divider
  // (read the raw value and double it for actual VBAT) - this is a
  // per-pin scaling factor documented in pinNotes below, not a board-wide
  // ADC reference change, since it does not apply to the other ADC pins.
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },

  // GPIO numbers that are input-only (no internal pull-up driver, no
  // output driver).  Used by the ESP32 parser to drop digital_output and
  // pwm_output capabilities from those pins.  Leave [] on boards where
  // every pin is bidirectional (e.g. all AVR variants).
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],

  // Transports this board can talk pfod over.  Values are the lowercase
  // machine identifiers from pfodCommon.html's protocol radios.  ESP32
  // family supports Serial via UART, BLE via Bluetooth LE, TCP via the
  // WiFi stack, and HTTP via the WiFi stack + a small server library.
  "connections": ["serial", "ble", "tcp", "http"],

  // Boot-time / power-up warnings for specific GPIO numbers, plus one
  // pfodWeb-researched informational note for the battery-sense pin.
  // Reference: ESP32 Technical Reference Manual — Strapping Pins section.
  // GPIO0 doubles as the onboard "0" bootloader-select button, which is
  // exactly why it must be HIGH/floating (not held LOW/pressed) at boot.
  "pinNotes": {
    "0":  "Must be HIGH or floating on reboot",
    "2":  "Must be LOW or floating at boot",
    "5":  "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot",
    "35": "Battery voltage sense (BATT_MONITOR) - onboard divider reads half of VBAT; multiply the raw analogRead() value by 2 to get actual battery voltage"
  },

  // User-accessible GPIO numbers on the ESP32 chip.  GPIOs 6-11 (flash)
  // and 16-17 (PSRAM) are excluded — not user-accessible on modules with
  // integrated flash/PSRAM.  GPIOs 34-39 are input-only (no output driver).
  // GPIOs 20, 24, 28-31 do not exist in this chip's silicon.
  // Source: Espressif ESP-IDF documentation (docs.espressif.com).
  "chipGpios": {
    "0":  { "capabilities": ["digital_input", "button"] },
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "13": { "capabilities": ["digital_output", "pwm_output", "led_high"] },
    "14": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "19": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "22": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "23": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "25": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "26": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "27": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["analog_input", "digital_input"] },
    "35": { "capabilities": ["analog_input", "digital_input"] },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
    "39": { "capabilities": ["analog_input", "digital_input"] }
  }
}
