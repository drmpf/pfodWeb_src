// pfodWeb NOTE: excludes GPIO2/4/14 - dedicated onboard LoRa radio
// control lines (LORA_SS/RST/DIO0, also duplicated as A4/A3/A0 in the
// vendor's own file - both removed together). The general SPI bus
// (SS=5/MOSI=23/MISO=19/SCK=18) stays available - LoRa shares it via its
// own separate LORA_SS chip-select, not a fully separate bus.
//
// pfodWeb NOTE (button/LED capability audit, 2026-07-12): the vendor's
// own header also assigns the LED_BUILTIN alias to this same radio
// interrupt pin. The vendor's official GitHub sample sketches for this
// exact LoRa board (both the transmitter and the receiver examples) wire
// that pin solely to the radio's interrupt line, with no LED-driving
// code anywhere in either sketch, and no vendor pinout page or schematic
// could be retrieved (repeated fetch failures) to confirm an independent
// onboard LED safely coexists on the same pin. A separate BharatPi test
// sketch shared across other BharatPi boards (not LoRa-specific) does
// blink an LED on the equivalent pin number, but that other board has no
// radio module, so it does not resolve the conflict here. Left
// untagged/excluded rather than guessing polarity or presence - see
// boardsDetails notes.txt for the full source list and reasoning. No
// separate onboard user button was found either; the only boot-button
// reference found anywhere is the standard ESP32 flash/boot button on
// GPIO0, already covered by this file's existing GPIO0 alias.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH or floating on reboot",
    "5":  "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
