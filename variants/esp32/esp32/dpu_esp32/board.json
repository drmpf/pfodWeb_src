// pfodWeb NOTE: excludes GPIO12-15/18/19/21/23/27/32 - dedicated onboard
// touch panel + TFT display shared SPI bus, GPIO22/23 - microSD card
// (see vendor pins_arduino.h).
// 2026-07-14 CONFIRMED via independent research: TAMCTec's own official
// hardware doc page (https://dpu-esp32.readthedocs.io/en/latest/hardware.html)
// lists the identical GPIO assignments pin-for-pin (TFT MOSI=13/MISO=12/
// SCLK=14/CS=15/DC=27/RST=32/BL=18; touch TP_RST=21/TP_INT=19; SD_CS=23/
// SD_CD=22). See notes.txt for full source list.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
