// pfodWeb NOTE: dedicated-hardware pin-exclusion audit for BharatPi-Node-Wifi.
// Sources: bharatpi.net product page (bharatpi.net/product/bharat-pi-node-wifi/,
// via WebSearch snippet since direct fetch of bharatpi.net was blocked/refused
// in this environment) - ESP32-WROOM 4MB + WiFi/BT + microSD slot, no onboard
// GSM/LoRa/GPS radio (those are separate BharatPi products: BharatPi-A7672S-4G,
// BharatPi-LoRa). Official Bharat-Pi GitHub org (github.com/Bharat-Pi/iot-projects,
// MIT-licensed vendor sample code, fetched via raw.githubusercontent.com):
//  - Bharat_Pi_Node_WiFi_LED_Splash/Bharat_Pi_Node_WiFi_LED_Splash.ino and
//    BharatPi_Blink_LED_Test/BharatPi_Blink_LED_Test.ino both drive GPIO2/12/13
//    individually via plain pinMode(OUTPUT) + digitalWrite(HIGH)="on"/LOW="off"
//    - confirms three separate simple GPIO-driven LEDs (matching the
//    SAFFRON_LED=12/WHITE_LED=2/GREEN_LED=13 tricolor naming - Indian flag
//    colours - not one packaged RGB emitter), active-high polarity.
//    GPIO2/12/13 tagged "led_high" accordingly (pwm_output kept since it was
//    already present on these GPIOs in the chip-level default).
//  - Bharat_Pi_SD_Card_Test_Program/Bharat_Pi_SD_Card_Test_Program.ino confirms
//    the microSD card uses the standard SPI bus (SS/MOSI/MISO/SCK = GPIO5/23/
//    19/18, matching this board's own pins_arduino.h) via plain SD.begin() -
//    no reference to GPIO16/17 anywhere in vendor code or docs.
//  - TX2/RX2 (GPIO17/16) are the classic ESP32's default hardware UART2 pins,
//    broken out to the header as this board's secondary serial port. No vendor
//    source (product page, pinout page, GitHub sample code) ties them to any
//    onboard peripheral - this "Node WiFi" SKU has no GSM/LoRa/GPS module to
//    wire a second UART to. Left as normal available GPIOs (no exclusion) -
//    they remain in chipGpios unchanged from the chip-level default.
//  - bharatpi.net's own pinout pages (bharat-pi-node-wi-fi-board-pinout/ and
//    the edgehax.com PDF mirror) returned HTTP 403/ECONNREFUSED to direct
//    fetch in this environment; relied on WebSearch snippets plus the
//    higher-confidence vendor GitHub sample code above instead.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": { "min": 0, "max": 255, "method": "analogWrite" },
  "dac": { "min": 0, "max": 255, "minVolts": "0.0", "maxVolts": "3.3", "method": "dacWrite" },
  "adc": { "bits": 12, "max": 4095, "defaultRefVolts": "3.3" },
  "inputOnlyGpios": [34, 35, 36, 37, 38, 39],
  "connections": ["serial", "ble", "tcp", "http"],
  "pinNotes": {
    "0":  "Must be HIGH or floating on reboot",
    "2":  "Must be LOW or floating at boot",
    "5":  "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "1":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "2":  { "capabilities": ["digital_output", "led_high", "pwm_output"] },
    "3":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "4":  { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "5":  { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "12": { "capabilities": ["digital_output", "led_high", "pwm_output"] },
    "13": { "capabilities": ["digital_output", "led_high", "pwm_output"] },
    "14": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "15": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "18": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "19": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "21": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "22": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "23": { "capabilities": ["digital_input", "digital_output", "pwm_output"] },
    "25": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "26": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output", "dac_output"] },
    "27": { "capabilities": ["analog_input_serial", "digital_input", "digital_output", "pwm_output"] },
    "32": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "33": { "capabilities": ["analog_input", "digital_input", "digital_output", "pwm_output"] },
    "34": { "capabilities": ["analog_input", "digital_input"] },
    "35": { "capabilities": ["analog_input", "digital_input"] },
    "36": { "capabilities": ["analog_input", "digital_input"] },
    "37": { "capabilities": ["analog_input", "digital_input"] },
    "38": { "capabilities": ["analog_input", "digital_input"] },
    "39": { "capabilities": ["analog_input", "digital_input"] }
  }
}
