      ]
    },
    "22": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "23": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "25": {
      "capabilities": [
        "digital_output",
        "led_high",
        "pwm_output"
      ]
    },
    "32": {
