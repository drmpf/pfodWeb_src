// pfodWeb NOTE: excludes GPIO4/15/16 (OLED I2C+reset), GPIO5/18/19/27
// (LoRa SPI bus), GPIO14/26/34/35 (LoRa RST/DIO0-2), GPIO21 (Vext
// power-gate) - see vendor pins_arduino.h.
// pfodWeb NOTE: GPIO25 tagged "led_high" - confirmed onboard single-color
// LED, active-high, via HelTecAutomation/Heltec_ESP32 official factory-test
// firmware (examples/Factory_Test/Wireless_Stick_FactoryTest/
// Wireless_Stick_FactoryTest.ino, tag 1.0.9) which calls
// digitalWrite(25,HIGH) to turn the LED on, and Heltec community forum
// (community.heltec.cn/t/wireless-stick-gpio25/4886) confirming an onboard
// LED at GPIO25. Matches LED_BUILTIN/LED/DAC1/A18 aliases in vendor
// pins_arduino.h.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard PRG button via
// the same official factory-test firmware, which attaches a FALLING-edge
// interrupt on GPIO0 (attachInterrupt(0,interrupt_GPIO0,FALLING)),
// consistent with a normally-high button pulled to GND on press. Matches
// KEY_BUILTIN alias in vendor pins_arduino.h.
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
    36,
    37,
    38,
    39
  ],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH or floating on reboot",
    "2": "Must be LOW or floating at boot",
    "5": "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "2": {
