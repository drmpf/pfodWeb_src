// pfodWeb NOTE: excludes GPIO4/15/16 (OLED display) and GPIO21 (Vext
// power-gate) - see vendor pins_arduino.h.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard PRG button
// (Heltec community forum "WiFi Kit 32 PRG Button 0"; espboards.dev
// pinout table shows GPIO0 as KEY_BUILTIN; pulled up, press = LOW).
// GPIO25 tagged "led_high" - confirmed onboard LED, active-high
// (Heltec official pinout diagram/schematic and espboards.dev pinout
// table show GPIO25 as LED_BUILTIN; example sketches use
// digitalWrite(25, HIGH) to turn it on).
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
    36,
    37,
    38,
    39
  ],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH or floating on reboot",
    "2": "Must be LOW or floating at boot",
    "5": "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
