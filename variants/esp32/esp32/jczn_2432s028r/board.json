// pfodWeb NOTE: per-board override — this is the JCZN 2432S028R
// ("Cheap Yellow Display"). Removed from the chip-level default
// chipGpios map:
//  5,18,19,23   the onboard microSD card's SPI bus (same as
//               SS/SCK/MISO/MOSI above — CYD_SD_*)
//  25,32,33,36  the onboard XPT2046 resistive touch controller's
//               SPI bus (CYD_TP_CLK/MOSI/CS/IRQ)
//  2,12,13,14,15  the onboard ILI9341/ST7789 TFT's SPI bus + DC
//               (CYD_TFT_DC/MISO/MOSI/SCK/CS)
// Kept: RGB LED (4,16,17), audio out (26), user button (0), and the
// LDR light sensor (34, also A6) — matches sensor/LED/button policy.
// Full copy of variants/esp32/esp32/board.json otherwise.
// pfodWeb NOTE: GPIO0 tagged "button" - confirmed onboard BOOT button
// (CYD_USER_BUTTON in this board's own pins_arduino.h; independently
// confirmed by mischianti.org "ESP32-2432S028" pinout page, which lists
// "BOOT (GPIO 0)" under "User buttons", and randomnerdtutorials.com CYD
// pinout page: "It has the BOOT button which is internally connected to
// GPIO 0"). Not TX/RX (TX=1, RX=3).
// pfodWeb NOTE: GPIO4 tagged "led_r_low" - confirmed onboard discrete RGB
// LED red channel (CYD_LED_RED in this board's own pins_arduino.h, with
// CYD_LED_RED_ON() -> digitalWrite(CYD_LED_RED, 0), i.e. active-low;
// independently confirmed by mischianti.org "RGB LED (GPIO 4/16/17,
// active-LOW)" and randomnerdtutorials.com CYD pinout page). The green
// (GPIO16) and blue (GPIO17) channels are NOT tagged: both fall in this
// chip's default PSRAM-reserved exclusion range and have no chipGpios
// entry in the chip-level default board.json, so per task policy they
// are left untagged rather than re-added (same situation documented in
// variants/esp32/esp32/alksesp32/board.json for its GPIO16 blue channel).
{
  "boardName": "ESP32",
  "displayName": "ESP32 Dev Module",
  "family": "esp32",
  "pwm": {
    "min": 0,
    "max": 255,
    "method": "analogWrite"
  },
  "dac": {
    "min": 0,
    "max": 255,
    "minVolts": "0.0",
    "maxVolts": "3.3",
    "method": "dacWrite"
  },
  "adc": {
    "bits": 12,
    "max": 4095,
    "defaultRefVolts": "3.3"
  },
  "inputOnlyGpios": [
    34,
    35,
    36,
    37,
    38,
    39
  ],
  "connections": [
    "serial",
    "ble",
    "tcp",
    "http"
  ],
  "pinNotes": {
    "0": "Must be HIGH or floating on reboot",
    "2": "Must be LOW or floating at boot",
    "5": "Must be HIGH or floating on reboot",
    "12": "Must be LOW or floating on reboot",
    "15": "Must be HIGH or floating on reboot"
  },
  "chipGpios": {
    "0": {
      "capabilities": [
        "digital_input",
        "button"
      ]
    },
    "1": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "3": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "4": {
      "capabilities": [
        "digital_output",
        "led_r_low",
        "pwm_output"
      ]
    },
    "21": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "22": {
      "capabilities": [
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "26": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output",
        "dac_output"
      ]
    },
    "27": {
      "capabilities": [
        "analog_input_serial",
        "digital_input",
        "digital_output",
        "pwm_output"
      ]
    },
    "34": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "35": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "37": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    },
    "38": {
      "capabilities": [
        "analog_input",
        "digital_input"
      ]
    }
  }
}
